---
/**
 * Home, in the site map's order: Hero, What can we help you with?, Nine
 * businesses, Latest from CBZ, Branches & ATMs. Laid out after the Optibiz
 * reference in CBZ colours: a navy top that fades to white, phone mockups
 * with a floating badge, a row of dark cards, an about split with the
 * big-number strip, and image cards for the businesses.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import BranchFinder from '../components/BranchFinder.astro';
import Icon from '../components/Icon.astro';
import { OpenAccountMenu } from '../islands/OpenAccountMenu';
import { OPEN_ACCOUNT_ITEMS } from '../data/nav';
import { AWARDS, CONTACT, GROUP } from '../data/facts';
import { CLUSTERS, VALUE_PROPOSITION } from '../data/group';
import type { IconName } from '../components/icons';

const clusterIcon: Record<string, IconName> = { banking: 'bank', investments: 'chart', insurance: 'shield', 'agro-business': 'leaf' };
const clusters = CLUSTERS.filter((c) => c.isOperating);

const bestBank = AWARDS[0];
const stats = [
  { value: GROUP.founded, label: 'Founded in Harare, serving Zimbabwe since' },
  { value: GROUP.listing, label: GROUP.listingLine },
  { value: 'Ten', label: 'Operating companies in the Group' },
  { value: 'Four', label: 'Clusters: banking, investments, insurance, agro' },
];
---

<BaseLayout
  title={GROUP.name}
  description="CBZ Holdings: banking, insurance, investments and agribusiness in one place. Open an account, apply for a loan, get a quote or start investing."
>
  <!-- 1. Hero: navy top fading to white -->
  <section class="top on-dark" aria-labelledby="hero-heading">
    <div class="container hero">
      <div class="hero__copy">
        <p class="eyebrow">Welcome to CBZ Holdings</p>
        <h1 id="hero-heading" class="hero__title display">Bank, insure, invest and grow, in one place</h1>
        <p class="hero__lede">Nine businesses, one group. Open an account, get a quote or start investing today.</p>
        <div class="hero__actions">
          <OpenAccountMenu client:idle items={OPEN_ACCOUNT_ITEMS} />
          <a href={CONTACT.whatsapp.chatHref} class="round" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp (opens in a new tab)">
            <Icon name="whatsapp" size={22} />
          </a>
          <a href="/contact" class="btn btn--secondary btn--lg">Talk to us</a>
        </div>
        <div class="hero__proof">
          <div class="proof">
            <span class="proof__big">{bestBank.years.length}×</span>
            <span class="proof__text">
              <span class="proof__title">{bestBank.title}</span>
              <span class="proof__line">{bestBank.awarder}, {bestBank.years.join(', ')}</span>
            </span>
          </div>
          <div class="proof">
            <span class="proof__logos">
              {clusters.map((c) => (
                <span class="proof__dot"><Icon name={clusterIcon[c.id]} size={14} /></span>
              ))}
            </span>
            <span class="proof__text">
              <span class="proof__title">Four clusters</span>
              <a href="#help" class="proof__line proof__link">See what we can help with</a>
            </span>
          </div>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="tick">
          <span class="tick__icon"><Icon name="check" size={14} /></span>
          <span>Listed on the Zimbabwe Stock Exchange</span>
        </div>
        <div class="phones">
          <div class="phone phone--back">
            <div class="phone__screen phone__screen--alt">
              <span class="screen__pill">ZikiCash</span>
              <span class="screen__bars"><i></i><i></i><i></i></span>
            </div>
          </div>
          <div class="phone phone--front">
            <div class="phone__screen">
              <span class="screen__brand"><Logo brand="cbz-touch" on="light" height={26} decorative clearSpace={false} /></span>
              <span class="screen__card">
                <span class="screen__card-title">Zero-rated mobile banking</span>
                <span class="screen__card-line">No data charges on local networks</span>
              </span>
              <ul class="screen__list">
                <li>Send money</li>
                <li>Pay bills</li>
                <li>School fees</li>
                <li>Card controls</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="badge">
          <span class="badge__big">Since {GROUP.founded}</span>
          <span class="badge__line">Partners for success</span>
        </div>
      </div>
    </div>

    <!-- 2. What can we help you with? -->
    <div class="container help" id="help">
      <h2 class="sr-only">What can we help you with?</h2>
      <a href="/login#apps" class="help__photo">
        <img
          src="/images/accounts/individual-600.webp"
          srcset="/images/accounts/individual-600.webp 600w, /images/accounts/individual.webp 1000w"
          sizes="(min-width: 900px) 400px, 100vw"
          alt=""
          width={800}
          height={600}
          loading="lazy"
          decoding="async"
        />
        <span class="help__photo-body">
          <span class="help__photo-title">Bank from your phone</span>
          <span class="help__photo-line">CBZ Touch, ZikiCash and internet banking <Icon name="arrowRight" size={16} /></span>
        </span>
      </a>
      <ul role="list" class="help__cards">
        {
          clusters.map((c) => (
            <li>
              <a href={c.route} class="dark-card">
                <span class="dark-card__icon"><Icon name={clusterIcon[c.id]} size={22} /></span>
                <span class="dark-card__title">{c.taskLabel}</span>
                <span class="dark-card__line">{c.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Nine businesses: about split, number strip, business cards -->
  <Section id="businesses" heading="Nine businesses" hideHeading>
    <div class="about">
      <div class="about__media">
        <img src="/images/cbzpicture1.webp" alt="CBZ Holdings head office in Harare" width={960} height={720} loading="lazy" decoding="async" />
        <div class="about__row">
          <span class="about__icon"><Icon name="globe" size={22} /></span>
          <div>
            <h3 class="about__h3">{VALUE_PROPOSITION[1].title}</h3>
            <p class="small muted">{VALUE_PROPOSITION[1].body}</p>
          </div>
        </div>
      </div>
      <div class="about__copy">
        <p class="eyebrow eyebrow--light">About CBZ Holdings</p>
        <h2 class="about__title">One group behind every stage of life and business</h2>
        <div class="about__row">
          <span class="about__icon"><Icon name="bank" size={22} /></span>
          <div>
            <h3 class="about__h3">{VALUE_PROPOSITION[0].title}</h3>
            <p class="small muted">{VALUE_PROPOSITION[0].body}</p>
          </div>
        </div>
        <a href="/the-group" class="about__banner on-dark">
          <span class="about__banner-icon"><Icon name="check" size={14} /></span>
          <span class="about__banner-text">{VALUE_PROPOSITION[2].body}</span>
          <span class="btn btn--primary">The Group</span>
        </a>
      </div>
    </div>

    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dd class="stat__value">{s.value}</dd>
            <dt class="stat__label">{s.label}</dt>
          </div>
        ))
      }
    </dl>

  </Section>

  <!-- 4. Branches and ATMs -->
  <Section id="branches" heading="Branches and ATMs" lede="Search the map, or open it in your own maps app for directions.">
    <BranchFinder id="home-branches" />
  </Section>
</BaseLayout>

<style>
  /* ---------- Top: navy fading to white ---------- */
  .top {
    position: relative;
    color: var(--white);
    background: linear-gradient(to bottom, var(--blue-900) 0%, var(--blue-900) 58%, var(--blue) 78%, var(--white) 100%);
    padding-bottom: var(--s-8);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--s-4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--r-pill);
    font-size: var(--t-xs);
    color: var(--white);
    width: fit-content;
  }
  .eyebrow--light {
    color: var(--red-700);
    border-color: var(--red-50);
    background: var(--red-50);
    font-weight: 700;
  }
  .hero {
    display: grid;
    gap: var(--s-10, 40px);
    padding-block: var(--s-12) var(--s-12);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
      padding-block: var(--s-16) var(--s-16);
      gap: var(--s-12);
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--s-5, 20px);
    justify-items: start;
  }
  .hero__title {
    color: var(--white);
    max-width: 14ch;
  }
  .hero__lede {
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--t-lg);
    max-width: 34rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue-900);
    transition: transform var(--dur) var(--ease);
  }
  .round:hover {
    transform: scale(1.05);
    color: var(--blue-900);
  }
  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-top: var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    width: 100%;
  }
  .proof {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .proof__big {
    font-size: var(--t-2xl);
    font-weight: 700;
    color: var(--white);
    line-height: 1;
  }
  .proof__text {
    display: grid;
    gap: 2px;
  }
  .proof__title {
    font-weight: 700;
    color: var(--white);
    font-size: var(--t-sm);
  }
  .proof__line {
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.72);
  }
  .proof__link {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .proof__logos {
    display: flex;
  }
  .proof__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    border: 2px solid var(--blue-900);
    margin-left: -8px;
  }
  .proof__dot:first-child {
    margin-left: 0;
  }

  /* Phones */
  .hero__visual {
    position: relative;
    min-height: 420px;
    display: none;
  }
  @media (min-width: 640px) {
    .hero__visual {
      display: block;
    }
  }
  .tick {
    position: absolute;
    top: 6%;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.85);
    max-width: 180px;
  }
  .tick__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    flex-shrink: 0;
  }
  .phones {
    position: absolute;
    inset: 0;
  }
  .phone {
    position: absolute;
    width: 220px;
    height: 440px;
    border-radius: 36px;
    background: #0b1220;
    border: 6px solid #1a2436;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.6);
    padding: 14px;
  }
  .phone--front {
    right: 14%;
    top: 0;
    transform: rotate(8deg);
    z-index: 2;
  }
  .phone--back {
    right: 36%;
    top: 12%;
    transform: rotate(-10deg) scale(0.92);
    opacity: 0.9;
  }
  .phone__screen {
    height: 100%;
    border-radius: 24px;
    background: var(--white);
    padding: var(--s-4);
    display: grid;
    gap: var(--s-3);
    align-content: start;
    color: var(--ink);
  }
  .phone__screen--alt {
    background: var(--blue-50);
    align-content: center;
    justify-items: center;
    gap: var(--s-6);
  }
  .screen__pill {
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-pill);
    background: var(--white);
    color: var(--blue);
    font-weight: 700;
    font-size: var(--t-sm);
  }
  .screen__bars {
    display: flex;
    gap: 6px;
    align-items: flex-end;
    height: 60px;
  }
  .screen__bars i {
    width: 14px;
    border-radius: 4px 4px 0 0;
    background: var(--blue-100);
  }
  .screen__bars i:nth-child(1) {
    height: 40%;
  }
  .screen__bars i:nth-child(2) {
    height: 70%;
    background: var(--blue);
  }
  .screen__bars i:nth-child(3) {
    height: 100%;
  }
  .screen__brand {
    display: block;
  }
  .screen__card {
    display: grid;
    gap: 2px;
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--blue);
    color: var(--white);
  }
  .screen__card-title {
    font-weight: 700;
    font-size: var(--t-sm);
  }
  .screen__card-line {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
  }
  .screen__list {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }
  .screen__list li {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-sm);
    background: var(--surface);
    font-size: 12px;
    font-weight: 700;
    color: var(--blue);
  }
  .badge {
    position: absolute;
    right: 0;
    bottom: -4%;
    display: grid;
    gap: 2px;
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-md);
    background: var(--red-700);
    color: var(--white);
    box-shadow: var(--shadow-float);
    z-index: 3;
  }
  .badge__big {
    font-size: var(--t-xl);
    font-weight: 700;
    line-height: 1;
  }
  .badge__line {
    font-size: var(--t-xs);
    color: var(--white);
  }

  /* Help row: photo card + dark cards */
  .help {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .help {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
  .help__photo {
    position: relative;
    display: block;
    min-height: 240px;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    box-shadow: var(--shadow-float);
  }
  .help__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .help__photo-body {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6);
    background: linear-gradient(to top, rgba(0, 23, 54, 0.95), rgba(0, 23, 54, 0));
  }
  .help__photo-title {
    font-weight: 700;
    font-size: var(--t-lg);
  }
  .help__photo-line {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--t-sm);
    color: rgba(255, 255, 255, 0.85);
  }
  .help__cards {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: var(--blue-900);
    box-shadow: var(--shadow-float);
  }
  @media (min-width: 640px) {
    .help__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .help__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: var(--s-6);
    }
  }
  .dark-card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    padding: var(--s-5, 20px);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--white);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .dark-card:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
  }
  .dark-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }
  .dark-card__title {
    font-weight: 700;
    font-size: var(--t-lg);
  }
  .dark-card__line {
    font-size: var(--t-sm);
    color: rgba(255, 255, 255, 0.75);
  }

  /* About split */
  .about {
    display: grid;
    gap: var(--s-8);
    padding-top: var(--s-8);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-12);
      align-items: start;
    }
  }
  .about__media {
    display: grid;
    gap: var(--s-6);
  }
  .about__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .about__copy {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .about__title {
    font-size: var(--t-2xl);
    max-width: 18ch;
  }
  .about__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: start;
  }
  .about__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--red-50);
    color: var(--red);
  }
  .about__h3 {
    font-size: var(--t-md);
    margin-bottom: var(--s-1);
  }
  .about__banner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5, 20px);
    border-radius: var(--r-pill);
    background: var(--blue-900);
    color: var(--white);
    text-decoration: none;
  }
  .about__banner:hover {
    color: var(--white);
  }
  .about__banner-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--red);
  }
  .about__banner-text {
    font-size: var(--t-sm);
  }
  @media (max-width: 639px) {
    .about__banner {
      grid-template-columns: auto 1fr;
      border-radius: var(--r-lg);
    }
    .about__banner .btn {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* Number strip */
  .stats {
    margin: var(--s-12) 0;
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: grid;
    gap: var(--s-2);
    position: relative;
    padding-top: var(--s-4);
  }
  .stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 3px;
    background: var(--red);
  }
  .stat__value {
    margin: 0;
    font-size: var(--t-3xl);
    font-weight: 700;
    color: var(--blue);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    font-size: var(--t-sm);
    color: var(--grey);
    max-width: 24ch;
  }

  /* Business cards */
  .biz-head {
    display: grid;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  @media (min-width: 900px) {
    .biz-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }
  .biz-head .eyebrow--light {
    margin-bottom: var(--s-4);
  }
  .biz-title {
    font-size: var(--t-2xl);
    max-width: 22ch;
  }
  .biz-head__aside {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .biz {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .biz {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .biz {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .biz-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--white);
    background: var(--blue-900);
  }
  .biz-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .biz-card:hover .biz-card__img {
    transform: scale(1.04);
  }
  .biz-card__panel {
    position: absolute;
    left: var(--s-4);
    right: var(--s-4);
    bottom: var(--s-4);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: rgba(0, 23, 54, 0.9);
