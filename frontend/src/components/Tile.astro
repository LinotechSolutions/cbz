---
/**
 * A navigation tile: one radius, one border, a whisper of shadow on hover.
 * The whole tile is the link. `size="lead"` makes a tile the largest.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { isExternal } from '../data/links';

interface Props {
  title: string;
  line?: string;
  href: string;
  icon?: IconName;
  size?: 'default' | 'lead' | 'small';
  track?: string;
  trackProps?: Record<string, string | number | boolean>;
  class?: string;
}
const { title, line, href, icon, size = 'default', track, trackProps, class: className = '' } = Astro.props;
const external = isExternal(href);
---

<a
  href={href}
  class:list={['tile', 'card-base', `tile--${size}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-track={track}
  data-track-props={trackProps ? JSON.stringify(trackProps) : undefined}
>
  <slot name="media" />
  <span class="tile__body">
    {
      icon && (
        <span class="tile__icon">
          <Icon name={icon} size={size === 'lead' ? 30 : 24} />
        </span>
      )
    }
    <span class="tile__title">
      {title}
      {external && <span class="sr-only">(opens in a new tab)</span>}
    </span>
    {line && <span class="tile__line">{line}</span>}
    <slot />
  </span>
  <span class="go tile__go">
    {external ? 'Visit' : 'Explore'} <Icon name={external ? 'external' : 'arrowRight'} size={16} />
  </span>
</a>

<style>
  /* Red outline icon, navy title, grey line, red Explore at the foot */
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6);
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition: all var(--dur) var(--ease);
  }
  .tile:hover {
    color: var(--ink);
    border-color: var(--blue-100);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  .tile--lead {
    padding: var(--s-8);
  }
  .tile--small {
    padding: var(--s-5) var(--s-6);
  }
  .tile__body {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    flex: 1;
  }
  .tile__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--r-md);
    background: var(--red-50);
    color: var(--red);
    margin-bottom: var(--s-2);
    transition: transform var(--dur) var(--ease);
  }
  .tile:hover .tile__icon {
    transform: scale(1.05);
  }
  .tile--lead .tile__icon {
    width: 60px;
    height: 60px;
  }
  .tile__title {
    font-weight: 700;
    font-size: var(--t-md);
    color: var(--blue-900);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .tile--lead .tile__title {
    font-size: var(--t-xl);
  }
  .tile__line {
    color: var(--neutral-600);
    font-size: var(--t-sm);
    line-height: 1.55;
    max-width: 36ch;
  }
  .tile__go {
    margin-top: auto;
    padding-top: var(--s-3);
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--red);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    transition: gap var(--dur) var(--ease);
  }
  .tile:hover .tile__go {
    gap: var(--s-3);
    color: var(--red-hover);
  }
</style>
