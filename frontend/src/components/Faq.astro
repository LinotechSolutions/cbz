---
/**
 * Frequently asked questions: an accordion with a plus that turns into a
 * minus, then a "still unanswered?" card with a photograph and a button to
 * the unit's call-back form. Native details/summary, so it works without
 * JavaScript and with the keyboard.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  faqs: { question: string; answer: string }[];
  /** Where the contact button goes, usually the call-back form. */
  contactHref: string;
  contactLabel?: string;
  /** The name of the team that answers, e.g. "CBZ Bank". */
  team: string;
  image?: { src: string; alt: string };
  id: string;
}
const {
  faqs,
  contactHref,
  contactLabel = 'Contact us',
  team,
  image = { src: '/images/cbz-banking-branch.webp', alt: '' },
  id,
} = Astro.props;
---

<div class="faq">
  <div class="faq__list">
    {
      faqs.map((f, i) => (
        <details class="faq__item" name={`faq-${id}`}>
          <summary class="faq__q" id={`${id}-q${i}`}>
            <span>{f.question}</span>
            <span class="faq__plus" aria-hidden="true">
              <Icon name="plus" size={18} />
            </span>
          </summary>
          <div class="faq__a">
            <p>{f.answer}</p>
          </div>
        </details>
      ))
    }
  </div>

  <div class="faq__more card-base">
    <div class="faq__more-copy">
      <p class="faq__more-title">Are your questions still unanswered?</p>
      <p class="faq__more-line">Leave your number and what it is about, and {team} calls you back. Or reach us on the contact page.</p>
      <Button href={contactHref} variant="secondary" track="apply_click" trackProps={{ from: 'faq', unit: id }}>
        {contactLabel} <Icon name="phone" size={18} />
      </Button>
    </div>
    <img src={image.src} alt={image.alt} width={800} height={600} loading="lazy" decoding="async" class="faq__more-img" />
  </div>
</div>

<style>
  .faq {
    display: grid;
    gap: var(--s-10, 40px);
  }
  .faq__list {
    max-width: 56rem;
    width: 100%;
    margin-inline: auto;
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: var(--tap);
    padding: var(--s-5, 20px) var(--s-2);
    font-weight: 700;
    font-size: var(--t-md);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    color: var(--blue);
  }
  .faq__plus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue);
    flex-shrink: 0;
    transition:
      transform var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .faq__item[open] .faq__plus {
    transform: rotate(45deg);
    background: var(--red);
    color: var(--white);
  }
  .faq__a {
    padding: 0 var(--s-2) var(--s-6);
    color: var(--grey);
    max-width: var(--measure);
  }
  .faq__more {
    display: grid;
    overflow: hidden;
  }
  .faq__more-copy {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    align-content: center;
    padding: var(--s-8) var(--s-6);
  }
  .faq__more-title {
    font-size: var(--t-xl);
    font-weight: 700;
    color: var(--ink);
  }
  .faq__more-line {
    color: var(--grey);
    max-width: 44ch;
  }
  .faq__more-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 900px) {
    .faq__more {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .faq__more-copy {
      padding: var(--s-10, 40px) var(--s-8);
    }
    .faq__more-img {
      aspect-ratio: auto;
    }
  }
</style>
