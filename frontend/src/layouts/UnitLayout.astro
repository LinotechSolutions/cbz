---
/**
 * A business unit page, built from its site-map branch:
 *   hero → audience chips → one section per branch, in the map's order.
 * Each branch's children render by kind: forms and pages as link cards,
 * off-site links as cards hidden while their URL is null, app stores as
 * badges, product lists, calculators and listings inline, notes as dashed
 * cards. Nothing else is added to the page.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TaskCard from '../components/TaskCard.astro';
import Section from '../components/Section.astro';
import ProductGroup from '../components/ProductGroup.astro';
import Faq from '../components/Faq.astro';
import Listings from '../components/Listings.astro';
import StoreBadges from '../components/StoreBadges.astro';
import StickyCta from '../components/StickyCta.astro';
import Icon from '../components/Icon.astro';
import { Calculator } from '../islands/Calculator';
import { CALCULATORS } from '../data/calculators';
import { LINKS, isExternal } from '../data/links';
import { CONTACT } from '../data/facts';
import { visible } from '../lib/visible';
import type { DarkSafeLogoKey } from '../data/logos';
import { ICONS, type IconName } from '../components/icons';

interface Props {
  unit: CollectionEntry<'units'>['data'];
}
const { unit } = Astro.props;
type Item = (typeof unit.branches)[number]['items'][number];

const products = (await getCollection('products', (p) => p.data.unit === unit.slug))
  .map((p) => p.data)
  .sort((a, b) => a.order - b.order);

const clusterLabel: Record<string, { label: string; href: string }> = {
  banking: { label: 'Banking', href: '/clusters/banking' },
  investments: { label: 'Investments', href: '/clusters/investments' },
  insurance: { label: 'Insurance', href: '/clusters/insurance' },
  'agro-business': { label: 'Agro-Business', href: '/clusters/agro-business' },
  philanthropy: { label: 'The Group', href: '/the-group' },
};
const cluster = clusterLabel[unit.cluster];
const site = Astro.site ?? new URL('https://www.cbz.co.zw');

/** Products for one branch item, by category and/or product id. */
function productsFor(item: Item) {
  return products.filter((p) => {
    const byCat = item.categories ? item.categories.includes(p.category) : false;
    const byId = item.productIds ? item.productIds.includes(p.productId) : false;
    return byCat || byId;
  });
}
function categoriesFor(item: Item) {
  const present = new Set(productsFor(item).map((p) => p.category));
  return unit.categories.filter((c) => present.has(c.id));
}
const isCard = (i: Item) => ['form', 'page', 'external', 'note'].includes(i.kind);
const isShown = (i: Item) => (i.kind === 'external' || i.kind === 'form' || i.kind === 'page' ? visible(i.href) : true);

/** Group consecutive card items so they share a grid; content items stand alone. */
function runs(items: Item[]) {
  const out: { kind: 'cards' | 'content'; items: Item[] }[] = [];
  for (const it of items.filter(isShown)) {
    const last = out[out.length - 1];
    if (isCard(it)) {
      if (last && last.kind === 'cards') last.items.push(it);
      else out.push({ kind: 'cards', items: [it] });
    } else out.push({ kind: 'content', items: [it] });
  }
  return out;
}

const productItemCount = unit.branches.flatMap((b) => b.items).filter((i) => i.kind === 'products').length;
const branches = unit.branches.map((b) => ({ ...b, runs: runs(b.items) })).filter((b) => b.runs.length > 0);
const hiddenBranches = unit.branches.filter((b) => !branches.some((x) => x.id === b.id)).map((b) => b.title);

/** Red Sphere loan calculator: products with the rate and tenor the documentation states. */
const pct = (s: string | null | undefined) => {
  const m = s?.match(/(\d+(?:\.\d+)?)\s*%/);
  return m ? Number(m[1]) : null;
};
const months = (s: string | null | undefined) => {
  const m = s?.match(/(\d+)\s*months?/i);
  return m ? Number(m[1]) : null;
};
const loanProducts = products
  .filter((p) => p.category === 'salary' || p.category === 'business' || p.category === 'partners')
  .map((p) => ({ id: p.productId, label: p.name, ratePct: pct(p.details?.interestRate), maxMonths: months(p.details?.tenor) }));

/* The photograph on each unit's "still unanswered?" card. */
const FAQ_PHOTO: Record<string, { src: string; alt: string }> = {
  bank: { src: '/images/cbz-banking.webp', alt: '' },
  insurance: { src: '/images/insurance-health.webp', alt: '' },
  properties: { src: '/images/loan-home.webp', alt: '' },
  datvest: { src: '/images/cbz-wealth.webp', alt: '' },
  capital: { src: '/images/accounts/partnership.webp', alt: '' },
};

const appLinks = {
  'cbz-touch': { appStore: LINKS.touch.appStore, playStore: LINKS.touch.playStore },
  'red-sphere': { appStore: LINKS.redSphere.appStore, playStore: LINKS.redSphere.playStore },
  'ziki-cash': { appStore: LINKS.zikiCash.appStore, playStore: LINKS.zikiCash.playStore },
} as const;

/* Who we serve: an icon per audience, picked from the label, and a short title per unit. */
const segmentIcon = (label: string): IconName => {
  const l = label.toLowerCase();
  if (/diaspora/.test(l)) return 'globe';
  if (/individual|retail|personal|employee/.test(l)) return 'user';
  if (/farm|sector/.test(l)) return 'leaf';
  if (/pension|fund|institution/.test(l)) return 'chart';
  if (/compan|business|corporate|sme|school|church|organisation/.test(l)) return 'building';
  return 'user';
};
const SERVE_TITLE: Record<string, string> = {
  bank: 'Banking for everyone.',
  insurance: 'Cover for everyone.',
  'cbz-life': 'Protection for every family.',
  'risk-advisory': 'Advice for every business.',
  datvest: 'Investing for everyone.',
  capital: 'Capital for every business.',
  properties: 'Property for everyone.',
};
const segments = unit.segments.map((s) => ({ label: s.label, href: s.href, line: s.line ?? undefined, icon: segmentIcon(s.label) }));
const serveTitle = SERVE_TITLE[unit.slug] ?? `${unit.shortName} for everyone.`;

/* Link cards: a red icon picked from the label. */
const itemIcon = (label: string): IconName => {
  const l = label.toLowerCase();
  if (/agent|talk to|consultant|speak to|call me|call back/.test(l)) return 'headset';
  if (/cancel/.test(l)) return 'close';
  if (/status|check|verify|track/.test(l)) return 'check';
  if (/enquir|question|help|support/.test(l)) return 'info';
  if (/renew|date|season|calendar|schedule/.test(l)) return 'calendar';
  if (/motor|car|vehicle|personal lines/.test(l)) return 'car';
  if (/pay|premium|debit|fee|deposit|contribut/.test(l)) return 'wallet';
  if (/claim|cover|insur|protect|policy/.test(l)) return 'shield';
  if (/statement|report|fund|portfolio|invest|rate|return|valuation/.test(l)) return 'chart';
  if (/home|house|property|stand|viewing|mortgage|rent/.test(l)) return 'home';
  if (/farm|crop|contract|input|offtake|agro/.test(l)) return 'leaf';
  if (/app|touch|mobile|phone|ussd/.test(l)) return 'phoneMobile';
  if (/call|contact|speak|agent|branch/.test(l)) return 'phone';
  if (/mail|email|write/.test(l)) return 'mail';
  if (/account|open|sign up|register|onboard|kyc/.test(l)) return 'user';
  if (/loan|borrow|finance|facility|capital|funding|raise/.test(l)) return 'bank';
  if (/abroad|diaspora|foreign|international|export/.test(l)) return 'globe';
  return 'arrowRight';
};
/* A branch whose only content is one link becomes a tinted feature panel. */
type Branch = (typeof branches)[number];
function featureOf(b: Branch) {
  if (b.runs.length !== 1 || b.runs[0].kind !== 'cards' || b.runs[0].items.length !== 1) return null;
  const it = b.runs[0].items[0];
  if (it.kind === 'note' || !visible(it.href)) return null;
  const ext = it.kind === 'external' || isExternal(it.href!);
  return { label: it.label, href: it.href, ext, go: ext ? 'Visit' : 'Get started', icon: itemIcon(`${b.title} ${it.label}`) };
}
/* Feature panels alternate the photograph right, then left, down the page. */
const featureSide = new Map(branches.filter((b) => featureOf(b)).map((b, i) => [b.id, i % 2 === 0 ? 'right' : 'left'] as const));
const pointIcon = (name?: string): IconName => (name && name in ICONS ? (name as IconName) : 'check');

/* Product cards without a photograph show the unit's icon instead. */
const PRODUCT_ICON: Record<string, IconName> = {
  bank: 'wallet',
  'red-sphere': 'wallet',
  insurance: 'shield',
  'cbz-life': 'shield',
  'risk-advisory': 'shield',
  datvest: 'chart',
  capital: 'chart',
  properties: 'home',
  'agro-yield': 'leaf',
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FinancialService',
    name: unit.name,
    description: unit.seo.description,
    parentOrganization: { '@type': 'Organization', name: 'CBZ Holdings Limited' },
    url: new URL(`/${unit.slug}`, site).toString(),
    telephone: CONTACT.contactCentre.display,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
      { '@type': 'ListItem', position: 2, name: cluster.label, item: new URL(cluster.href, site).toString() },
      { '@type': 'ListItem', position: 3, name: unit.name },
    ],
  },
];
---

<BaseLayout
  title={unit.seo.title}
  description={unit.seo.description}
  jsonLd={jsonLd}
  unitLogo={unit.logo as DarkSafeLogoKey}
  preloadImage={unit.hero.image.src}
>
  <Hero
    variant="split"
    title={unit.hero.title}
    lede={unit.hero.lede}
    image={unit.hero.image}
    logo={unit.logo as DarkSafeLogoKey}
    eyebrow={unit.name}
    crumbs={[{ label: 'Home', href: '/' }, { label: cluster.label, href: cluster.href }, { label: unit.shortName }]}
    primary={{ ...unit.primaryCta, track: 'apply_click', trackProps: { unit: unit.slug, from: 'hero' } }}
    secondary={unit.secondaryCta ?? undefined}
    overlap={segments.length > 0}
  />

  {segments.length > 0 && <TaskCard heading="Who we serve" title={serveTitle} items={segments} />}

  <div class="branches" data-unit={unit.slug}>
    {
      branches.map((b) => {
        const feature = featureOf(b);
        const selfHeaded = feature !== null || b.items.every((i) => i.kind === 'faq' || i.kind === 'calculator');
        return (
        <Section id={b.id} heading={b.title} lede={b.line ?? undefined} hideHeading={selfHeaded} class="branch" data-branch={b.id}>
          <div class="branch__body">
            {feature && (
              <div class:list={['feature', `feature--${featureSide.get(b.id) ?? 'right'}`]}>
                <div class="feature__copy">
                  <p class="feature__title h-rule" aria-hidden="true">{b.title}</p>
                  {visible(b.line) && <p class="feature__lede">{b.line}</p>}
                  <a
                    href={feature.href!}
                    class="btn btn--primary feature__btn"
                    target={feature.ext ? '_blank' : undefined}
                    rel={feature.ext ? 'noopener noreferrer' : undefined}
                    data-track="apply_click"
                    data-track-props={JSON.stringify({ unit: unit.slug, branch: b.id, item: feature.label })}
                  >
                    {feature.go} <Icon name={feature.ext ? 'external' : 'arrowRight'} size={18} />
                    {feature.ext && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                  {b.points && b.points.length > 0 && (
                    <ul role="list" class="feature__points">
                      {b.points.map((pt) => (
                        <li class="feature__point">
                          <Icon name={pointIcon(pt.icon)} size={22} />
                          <span>{pt.label}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class="feature__media" aria-hidden="true">
                  <img src={(b.image ?? unit.hero.image).src} alt="" width={900} height={600} loading="lazy" decoding="async" />
                  <span class="feature__swoosh feature__swoosh--navy" />
                  <span class="feature__swoosh feature__swoosh--red" />
                  <span class="feature__disc">
                    <Icon name={feature.icon} size={34} />
                  </span>
                </div>
              </div>
            )}
            {!feature && b.runs.map((run, ri) =>
              run.kind === 'cards' ? (
                <ul role="list" class:list={['cards', run.items.length === 2 && 'cards--pair']} style={`--n:${Math.min(run.items.length, 3)}`}>
                  {run.items.map((it) => {
                    const photo = it.image && visible(it.image.src) ? it.image : null;
                    const media = photo && (
                      <span class="card-link__media" aria-hidden="true">
                        <img src={photo.src} alt="" width={600} height={600} loading="lazy" decoding="async" />
                        <span class="card-link__edge" />
                      </span>
                    );
                    if (it.kind === 'note') {
                      return (
                        <li class:list={['note', 'card-link', 'card-base', photo && 'card-link--photo']}>
                          {media}
                          {!photo && (
                            <span class="card-link__icon" aria-hidden="true">
                              <Icon name={itemIcon(it.label)} size={26} />
                            </span>
                          )}
                          <span class="card-link__text">
                            {photo && (
                              <span class="card-link__icon" aria-hidden="true">
                                <Icon name={itemIcon(it.label)} size={26} />
                              </span>
                            )}
                            <span class="card-link__label">{it.label}</span>
                            {visible(it.line) && <span class="card-link__line">{it.line}</span>}
                          </span>
                        </li>
                      );
                    }
                    const ext = it.kind === 'external' || isExternal(it.href!);
                    const go = ext ? 'Visit' : 'Get started';
                    return (
                      <li>
                        <a
                          href={it.href!}
                          class:list={['card-link', 'card-base', photo && 'card-link--photo']}
                          target={ext ? '_blank' : undefined}
                          rel={ext ? 'noopener noreferrer' : undefined}
                          data-track="apply_click"
                          data-track-props={JSON.stringify({ unit: unit.slug, branch: b.id, item: it.label })}
                        >
                          {media}
                          {!photo && (
                            <span class="card-link__icon" aria-hidden="true">
                              <Icon name={itemIcon(it.label)} size={26} />
                            </span>
                          )}
                          <span class="card-link__text">
                            {photo && (
                              <span class="card-link__icon" aria-hidden="true">
                                <Icon name={itemIcon(it.label)} size={26} />
                              </span>
                            )}
                            <span class="card-link__label">
                              {it.label}
                              {ext && <span class="sr-only"> (opens in a new tab)</span>}
                            </span>
                            {visible(it.line) && <span class="card-link__line">{it.line}</span>}
                            {photo ? (
                              <span class="btn btn--primary card-link__btn">
                                {go} <Icon name={ext ? 'external' : 'arrowRight'} size={18} />
                              </span>
                            ) : (
                              <span class="go card-link__go">
                                {go} <Icon name={ext ? 'external' : 'arrowRight'} size={16} />
                              </span>
                            )}
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                run.items.map((it, ii) => {
                  const key = `${b.id}-${ri}-${ii}`;
                  if (it.kind === 'products') {
                    const list = productsFor(it);
                    const cats = categoriesFor(it);
                    const showHead = b.items.filter((x) => x.kind === 'products').length > 1;
                    return (
                      <div class="content" id={`${b.id}-${it.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
                        {showHead && (
                          <div class="content__head">
                            <h3>{it.label}</h3>
                            {visible(it.line) && <p class="muted small">{it.line}</p>}
                          </div>
                        )}
                        <ProductGroup
                          unitSlug={unit.slug}
                          idPrefix={productItemCount > 1 ? `${unit.slug}-${b.id}-${ii}` : unit.slug}
                          categories={cats}
                          products={list}
                          primaryCta={unit.primaryCta}
                          note={unit.productsNote}
                          icon={PRODUCT_ICON[unit.slug] ?? 'wallet'}
                        />
                      </div>
                    );
                  }
                  if (it.kind === 'calculator' && it.calculator) {
                    return (
                      <div class="content" id={`calc-${key}`}>
                        <Calculator
                          client:visible
                          variant={it.calculator}
                          config={CALCULATORS[it.calculator]}
                          products={it.calculator === 'loan' ? loanProducts : undefined}
                        />
                      </div>
                    );
                  }
                  if (it.kind === 'listings') {
                    return (
                      <div class="content">
                        <Listings />
                      </div>
                    );
                  }
                  if (it.kind === 'faq' && it.faqs && it.faqs.length > 0) {
                    return (
                      <div class="content">
                        <Faq
                          id={unit.slug}
                          faqs={it.faqs}
                          contactHref={it.href ?? '/contact'}
                          contactLabel={it.label}
                          team={unit.name}
                          image={FAQ_PHOTO[unit.slug] ?? { src: '/images/cbz-banking-branch.webp', alt: '' }}
                        />
                      </div>
                    );
                  }
                  if (it.kind === 'app' && it.app) {
                    return (
                      <div class="content app">
                        <span class="app__label">{it.label}</span>
                        <StoreBadges app={it.app} appStore={appLinks[it.app].appStore} playStore={appLinks[it.app].playStore} />
                        {!visible(appLinks[it.app].appStore) && !visible(appLinks[it.app].playStore) && (
                          <p class="small muted">Store links coming soon.</p>
                        )}
                      </div>
                    );
                  }
                  return null;
                })
              ),
            )}
          </div>
        </Section>
        );
      })
    }
    {hiddenBranches.length > 0 && <span hidden data-branches-awaiting-link={hiddenBranches.join(', ')} />}
  </div>

  <StickyCta label={unit.primaryCta.label} href={unit.primaryCta.href} unit={unit.slug} />
</BaseLayout>

<style>
  .branch__body {
    display: grid;
    gap: var(--s-8);
  }
  .branch__cta {
    order: 99;
  }
  .content {
    display: grid;
    gap: var(--s-4);
  }
  .content__head {
    display: grid;
    gap: var(--s-1);
  }
  .cards {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
  /* Branch link card: a red icon in a pale red circle, navy title, grey line,
     red Get started. Icon on top; beside the text when two cards share a row. */
  .card-link {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    min-height: 150px;
    height: 100%;
    padding: var(--s-6);
    text-decoration: none;
    color: var(--ink);
  }
  .card-link:hover {
    color: var(--ink);
  }
  .card-link__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--red-50);
    color: var(--red);
    flex-shrink: 0;
  }
  .card-link__text {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-2);
    min-width: 0;
  }
  .card-link__text .card-link__icon {
    margin-bottom: var(--s-2);
  }
  /* A card with a photograph: the picture on the left behind a red curved
     edge, the icon chip, copy and a red button on the right. */
  .card-link--photo {
    padding: 0;
    overflow: hidden;
    gap: 0;
  }
  .card-link--photo .card-link__text {
    grid-template-rows: auto auto 1fr auto;
    padding: var(--s-6);
  }
  .card-link--photo .card-link__text .card-link__icon {
    width: 56px;
    height: 56px;
  }
  .card-link__media {
    position: relative;
    display: block;
    min-height: 180px;
    overflow: hidden;
  }
  .card-link__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A white ellipse with a red left edge, giving the photo a curved red separator */
  .card-link__edge {
    position: absolute;
    top: -25%;
    bottom: -25%;
    right: -70%;
    width: 110%;
    border-radius: 50%;
    background: var(--white);
    border-left: 10px solid var(--red);
  }
  .card-link__btn {
    justify-self: start;
    align-self: end;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }
  @media (min-width: 640px) {
    .card-link--photo {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: stretch;
    }
    .cards.cards--pair .card-link--photo {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: minmax(0, 1fr);
      align-items: stretch;
      align-content: stretch;
      gap: 0;
    }
    .cards.cards--pair .card-link--photo .card-link__icon {
      width: 56px;
      height: 56px;
    }
    .card-link--photo .card-link__media {
      min-height: 100%;
    }
    .card-link__edge {
      top: -20%;
      bottom: -20%;
      right: -60%;
      width: 90%;
    }
  }
  .card-link__label {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
    line-height: 1.25;
  }
  .card-link__line {
    font-size: var(--t-sm);
    color: var(--grey);
  }
  .card-link__go {
    align-self: end;
    margin-top: var(--s-3);
  }
  @media (min-width: 640px) {
    .cards--pair .card-link {
      grid-template-columns: auto 1fr;
      align-items: start;
      gap: var(--s-5, 20px);
    }
    .cards--pair .card-link__icon {
      width: 80px;
      height: 80px;
    }
  }

  /* Feature panel: one link in a rounded, image-led panel. Copy on one side,
     the photograph fading in from the other under red and navy curves, with
     a white disc carrying the icon. Consecutive panels swap sides. */
  .feature {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, var(--blue-50), var(--white) 70%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }
  .feature__copy {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    align-content: center;
    padding: var(--s-8) var(--s-6);
  }
  .feature__title {
    font-size: var(--t-2xl);
    font-weight: 700;
    color: var(--blue);
    line-height: 1.15;
  }
  .feature__lede {
    color: var(--grey);
    max-width: 40ch;
  }
  .feature__btn {
    gap: var(--s-2);
  }
  .feature__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) 0;
    margin-top: var(--s-2);
  }
  .feature__point {
    display: flex;
    align-items: center;
