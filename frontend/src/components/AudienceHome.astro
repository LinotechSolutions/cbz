---
/**
 * An audience home page (Personal, Corporate, Business, Diaspora), in the
 * design brief's layout: a split hero with the copy on white and the
 * photograph on a red panel; a floating "How can we help today?" finder
 * bar; a grey band with a large statement beside the latest notice;
 * "Solutions for every … need." cards with a red top bar in a row with round
 * red arrows; "We are here to help you grow faster." with a photograph over
 * a tinted square; the journey carousel; "Our promise to you." as a
 * check-circle list beside a photograph; a navy "Download the app" band; a
 * centred "Need a personalised solution?" call to action; and a grey strip
 * of the Group's businesses. The Diaspora home also carries the journey
 * carousel and the article rail; the other three do not. All copy and links come from
 * src/data/homes.ts; the markup and ids are the same on every audience so
 * the header strip and tests treat them alike.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRail from './ArticleRail.astro';
import { CORPORATE_INTENTS } from '../data/corporate';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import StoreBadges from './StoreBadges.astro';
import { OpenAccountMenu } from '../islands/OpenAccountMenu';
import { LINKS, isExternal } from '../data/links';
import { INTENTS } from '../data/nav';
import type { HomeConfig } from '../data/homes';
import type { DarkSafeLogoKey } from '../data/logos';

interface Props {
  home: HomeConfig;
}
const { home } = Astro.props;
const stores = {
  'cbz-touch': { appStore: LINKS.touch.appStore, playStore: LINKS.touch.playStore },
  'ziki-cash': { appStore: LINKS.zikiCash.appStore, playStore: LINKS.zikiCash.playStore },
} as const;
const secondaryExt = isExternal(home.hero.secondary.href);

const notices = (await getCollection('notices'))
  .filter((n) => n.data.category !== 'security')
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const articles = notices.map((n) => ({
  id: n.id,
  title: n.data.title,
  summary: n.data.summary,
  date: n.data.date,
  category: n.data.category,
  reference: n.data.reference,
  href: `/notices/${n.id}`,
}));

/* The Group's businesses, for the grey strip. */
const BUSINESSES: { key: DarkSafeLogoKey; href: string }[] = [
  { key: 'bank', href: '/bank' },
  { key: 'red-sphere', href: '/red-sphere' },
  { key: 'insurance', href: '/insurance' },
  { key: 'life', href: '/cbz-life' },
  { key: 'risk-advisory', href: '/risk-advisory' },
  { key: 'datvest', href: '/datvest' },
  { key: 'capital', href: '/capital' },
  { key: 'properties', href: '/properties' },
  { key: 'agro-yield', href: '/agro-yield' },
];
const activeIntents = home.id === 'corporate' ? CORPORATE_INTENTS : INTENTS;
const intents = activeIntents.map((i) => ({ verb: i.verb, objects: i.objects.map((o) => ({ label: o.label, href: o.href, external: Boolean(o.external) })) }));
---

<BaseLayout title={home.title} description={home.description} preloadImage={home.hero.image.src}>
  <!-- 1. Hero: the photographs full bleed behind a navy panel, white copy with a red bar, the slideshow controls, a curved white edge and the finder bar riding it -->
  <header class="hero on-dark" aria-labelledby="hero-heading" data-slides>
    <div class="hero__media" aria-roledescription="carousel" aria-label="Photographs">
      {
        home.hero.slides.map((s, i) => (
          <img
            src={s.src}
            alt={s.alt}
            width={1024}
            height={512}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
            class:list={['hero__slide', i === 0 && 'is-on']}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-slide
          />
        ))
      }
    </div>
    <span class="hero__panel" aria-hidden="true"></span>
    <span class="hero__ring" aria-hidden="true"></span>
    <div class="container hero__in">
      <div class="hero__copy">
        <h1 id="hero-heading" class="hero__title">
          {home.hero.title}<span class="hero__brand">{home.hero.brand}</span>
        </h1>
        <p class="hero__lede">{home.hero.lede}</p>
        <div class="hero__actions">
          <OpenAccountMenu client:idle items={home.hero.cta.items} label={home.hero.cta.label} />
          <a href={home.hero.secondary.href} class="hero__link" target={secondaryExt ? '_blank' : undefined} rel={secondaryExt ? 'noopener noreferrer' : undefined}>
            {home.hero.secondary.label}
            {secondaryExt && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </div>
      </div>
      {
        home.hero.slides.length > 1 && (
          <div class="hero__ctrl" role="group" aria-label="Photographs">
            <button type="button" class="hero__pause" aria-pressed="false" aria-label="Pause the photographs" data-pause>
              <svg class="hero__pause-ic" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><rect x="2" y="1" width="3.5" height="12" rx="1" fill="currentColor" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" fill="currentColor" /></svg>
              <svg class="hero__play-ic" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M3 1.5v11l9-5.5z" fill="currentColor" /></svg>
            </button>
            {home.hero.slides.map((_s, i) => (
              <button type="button" class:list={['hero__dot', i === 0 && 'is-on']} aria-label={`Photograph ${i + 1} of ${home.hero.slides.length}`} aria-pressed={i === 0 ? 'true' : 'false'} data-dot={i} />
            ))}
          </div>
        )
      }
    </div>
    <span class="hero__curve" aria-hidden="true"></span>

    <!-- The finder bar, riding the curved edge: "How can we help today?" [verb] [what] -> View our products -->
    <div class="container hero__finder">
      <form class="finder" data-finder data-intents={JSON.stringify(intents)} aria-label="Find a product">
        <span class="finder__label">
          <Icon name="search" size={20} />
          How can we help today?
        </span>
        <label class="sr-only" for="finder-verb">I want to</label>
        <select id="finder-verb" class="finder__select" data-verb>
          {intents.map((i) => <option value={i.verb}>{i.verb}</option>)}
        </select>
        <label class="sr-only" for="finder-object">What</label>
        <select id="finder-object" class="finder__select finder__select--wide" data-object>
          {intents[0]?.objects.map((o) => <option value={o.href}>{o.label}</option>)}
        </select>
        <button type="submit" class="finder__go">
          View our products <Icon name="arrowRight" size={18} />
        </button>
      </form>
    </div>
  </header>

  <!-- 2. Solutions for every … need. -->
  <section class="sol" id="help" aria-labelledby="help-heading" data-carousel>
    <div class="container">
      <h2 id="help-heading" class="sol__title">
        Solutions for every<br />{home.noun} need<span class="dot">.</span>
      </h2>
      <div class="sol__wrap">
        <button type="button" class="sol__arrow sol__arrow--prev" data-prev aria-label="Previous">
          <Icon name="chevronLeft" size={26} />
        </button>
        <ul role="list" class="sol__row" data-row>
          {
            home.help.map((c) => (
              <li class="solc">
                <span class="solc__icon" aria-hidden="true">
                  <span class="solc__halo" />
                  <Icon name={c.icon} size={32} />
                </span>
                <h3 class="solc__title">{c.title}</h3>
                <p class="solc__line">{c.line}</p>
                <a href={c.href} class="solc__go">
                  {c.go} <Icon name="arrowRight" size={20} />
                </a>
              </li>
            ))
          }
        </ul>
        <button type="button" class="sol__arrow sol__arrow--next" data-next aria-label="Next">
          <Icon name="chevronRight" size={26} />
        </button>
      </div>
      <a href="/journeys" class="go sol__all">View all solutions <Icon name="arrowRight" size={18} /></a>
    </div>
  </section>

  <!-- 3. Download the app -->
  <section class="digital on-dark" id="digital" aria-labelledby="digital-heading">
    <div class="container digital__inner">
      <div class="digital__head">
        <h2 id="digital-heading" class="digital__title">{home.digital.title}<strong>{home.digital.strong}</strong>. Available on the App Store and Google Play.</h2>
        <p class="digital__lede">{home.digital.lede}</p>
        <StoreBadges app="cbz-touch" appStore={stores['cbz-touch'].appStore} playStore={stores['cbz-touch'].playStore} tone="dark" />
      </div>
      <ul role="list" class="digital__cards">
        {
          home.digital.cards.map((c) => (
            <li class="dcard">
              {c.logo ? (
                <span class="dcard__logo">
                  <Logo brand={c.logo} on="light" height={c.logoHeight ?? 32} decorative clearSpace={false} />
                </span>
              ) : (
                <span class="dcard__logo dcard__logo--glyph">
                  <Icon name={c.icon ?? 'globe'} size={26} />
                </span>
              )}
              <h3 class="dcard__title">{c.title}</h3>
              <p class="dcard__line">{c.line}</p>
              <div class="dcard__foot">
                {c.app && c.app !== 'cbz-touch' && <StoreBadges app={c.app} appStore={stores[c.app].appStore} playStore={stores[c.app].playStore} />}
                {c.app === 'cbz-touch' && (
                  <a href="/login#apps" class="btn btn--secondary dcard__btn">
                    Get CBZ Touch
                  </a>
                )}
                {c.actions?.map((a) => (
                  <a href={a.href} class:list={['btn', a.variant === 'primary' ? 'btn--primary' : 'btn--secondary', 'dcard__btn']}>
                    {a.label}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3b. Apply for a Loan (Personal Home) -->
  {
    home.id === 'personal' && (
      <section class="loan-section" id="apply-for-a-loan" aria-labelledby="loan-section-heading">
        <div class="container loan-section__in">
          <div class="loan-section__head">
            <span class="loan-section__badge">Personal Lending</span>
            <h2 id="loan-section-heading" class="loan-section__title">
              Apply for a loan that matches your <strong>ambitions</strong>.
            </h2>
            <p class="loan-section__lede">
              Fast approvals, competitive interest rates, and flexible repayment terms from CBZ Bank and Red Sphere Finance.
            </p>
          </div>

          <div class="loan-grid">
            <article class="loan-card">
              <span class="loan-card__icon" aria-hidden="true">
                <Icon name="wallet" size={26} />
              </span>
              <h3 class="loan-card__title">Salary & Payday Loans</h3>
              <p class="loan-card__desc">
                Fast personal credit for civil servants and private sector employees. Straightforward monthly deductions aligned to your payday.
              </p>
              <ul class="loan-card__perks">
                <li>Civil Servant & Private Payroll options</li>
                <li>Quick processing & flexible terms</li>
                <li>Nostro & local currency options</li>
              </ul>
              <a href="/bank/apply" class="btn btn--primary loan-card__btn">Enquire with a Specialist</a>
            </article>

            <article class="loan-card">
              <span class="loan-card__icon" aria-hidden="true">
                <Icon name="graduation" size={26} />
              </span>
              <h3 class="loan-card__title">Education & School Fees</h3>
              <p class="loan-card__desc">
                Ensure continuous learning with structured tuition financing for primary, secondary, and tertiary education.
              </p>
              <ul class="loan-card__perks">
                <li>Direct tuition disbursement</li>
                <li>Manageable semester installments</li>
                <li>Student loan facility available</li>
              </ul>
              <a href="/bank/apply" class="btn btn--primary loan-card__btn">Enquire for Tuition</a>
            </article>

            <article class="loan-card">
              <span class="loan-card__icon" aria-hidden="true">
                <Icon name="home" size={26} />
              </span>
              <h3 class="loan-card__title">Home & Mortgage Loans</h3>
              <p class="loan-card__desc">
                Purchase, build, or renovate your dream residential property with long-term mortgage financing from CBZ.
              </p>
              <ul class="loan-card__perks">
                <li>Residential mortgages & stands</li>
                <li>CashPlus Housing savings scheme</li>
                <li>Flexible repayment periods</li>
              </ul>
              <a href="/calculators#mortgage" class="btn btn--secondary loan-card__btn">Calculate Repayments</a>
            </article>

            <article class="loan-card">
              <span class="loan-card__icon" aria-hidden="true">
                <Icon name="car" size={26} />
              </span>
              <h3 class="loan-card__title">Vehicle & Asset Finance</h3>
              <p class="loan-card__desc">
                Drive away in the vehicle you need with our Partner Car Loan and asset financing packages for individuals.
              </p>
              <ul class="loan-card__perks">
                <li>New & approved pre-owned vehicles</li>
                <li>Matched repayment structures</li>
                <li>Comprehensive insurance bundle</li>
              </ul>
              <a href="/calculators#car-finance" class="btn btn--secondary loan-card__btn">Calculate Vehicle Finance</a>
            </article>
          </div>

          <div class="loan-banner">
            <div class="loan-banner__copy">
              <span class="loan-banner__tag">Lending Consultations</span>
              <h3 class="loan-banner__title">Speak to a CBZ lending specialist today.</h3>
              <p class="loan-banner__text">
                Request a consultation online or visit any CBZ Bank or Red Sphere branch nationwide with your KYC documents.
              </p>
            </div>
            <div class="loan-banner__actions">
              <a href="/bank/apply" class="btn btn--primary btn--lg">
                Request Consultation <Icon name="arrowRight" size={18} />
              </a>
              <a href="/calculators" class="btn btn--secondary btn--lg">
                Repayment Calculator
              </a>
            </div>
          </div>

          <p class="loan-section__disclaimer">
            All lending facilities are subject to credit assessment, affordability checks, documentation verification, and branch approval.
          </p>
        </div>
      </section>
    )
  }

  <!-- 4. Our businesses -->
  <section class="brands" id="businesses" aria-labelledby="brands-heading">
    <div class="container brands__in">
      <h2 id="brands-heading" class="brands__label">Our businesses</h2>
      <ul role="list" class="brands__list">
        {
          BUSINESSES.map((b) => (
            <li>
              <a href={b.href} class="brands__link">
                <Logo brand={b.key} on="light" height={26} clearSpace={false} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Newsroom -->
  {
    articles.length > 0 && (
      <ArticleRail
        id="newsroom"
        badge="News & Updates"
        heading="Newsroom"
        headingStrong="Newsroom"
        articles={articles}
        seeAll={{ label: 'View all news', href: '/notices' }}
      />
    )
  }
</BaseLayout>

<script>
  // The finder bar: the second select follows the verb; Submit opens the chosen page.
  document.querySelectorAll<HTMLFormElement>('[data-finder]').forEach((form) => {
    const intents = JSON.parse(form.dataset.intents || '[]') as { verb: string; objects: { label: string; href: string; external: boolean }[] }[];
    const verb = form.querySelector<HTMLSelectElement>('[data-verb]');
    const object = form.querySelector<HTMLSelectElement>('[data-object]');
    if (!verb || !object) return;
    const fill = () => {
      const i = intents.find((x) => x.verb === verb.value) ?? intents[0];
      object.replaceChildren(
        ...(i?.objects ?? []).map((o) => {
          const opt = document.createElement('option');
          opt.value = o.href;
          opt.textContent = o.label;
          return opt;
        }),
      );
    };
    verb.addEventListener('change', fill);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const i = intents.find((x) => x.verb === verb.value);
      const o = i?.objects.find((x) => x.href === object.value) ?? i?.objects[0];
      if (!o) return;
      if (o.external) window.open(o.href, '_blank', 'noopener');
      else location.href = o.href;
    });
  });

  // The hero slideshow: crossfades every six seconds; the pause button stops it, and it starts paused for reduced motion.
  document.querySelectorAll<HTMLElement>('[data-slides]').forEach((wrap) => {
    const slides = Array.from(wrap.querySelectorAll<HTMLImageElement>('[data-slide]'));
    const dots = Array.from(wrap.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const pause = wrap.querySelector<HTMLButtonElement>('[data-pause]');
    if (slides.length < 2) return;
    let i = 0;
    let timer = 0;
    let paused = false;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('is-on', k === i);
        if (k === i) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k === i);
        d.setAttribute('aria-pressed', k === i ? 'true' : 'false');
      });
    };
    const start = () => {
      if (still || paused || timer) return;
      timer = window.setInterval(() => show(i + 1), 6000);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };
    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        show(k);
        stop();
        start();
      }),
    );
    pause?.addEventListener('click', () => {
      paused = !paused;
      pause.setAttribute('aria-pressed', paused ? 'true' : 'false');
      pause.setAttribute('aria-label', paused ? 'Play the photographs' : 'Pause the photographs');
      if (paused) stop();
      else start();
    });
    if (still && pause) {
      paused = true;
      pause.setAttribute('aria-pressed', 'true');
      pause.setAttribute('aria-label', 'Play the photographs');
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>

<style>
  /* Shared: the red full stop and the outlined red pill */
  .dot {
    color: var(--red);
  }
  .btn--outline-red {
    background: transparent;
    color: var(--red);
    border-color: var(--red);
  }
  .btn--outline-red:hover {
    background: var(--red-50);
    color: var(--red-700);
    box-shadow: var(--shadow-sm);
  }

  /* ---------- 1. Hero: photographs behind a navy panel, a curved white edge ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--blue-900);
    color: var(--white);
    padding-bottom: 56px;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
    overflow: hidden;
    background: var(--blue-900);
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% 30%;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 1.1s var(--ease),
      transform 7s linear;
  }
  .hero__slide.is-on {
    opacity: 1;
    transform: scale(1);
  }
  /* The navy panel the copy sits on: solid on the left, clearing to the photograph on the right */
  .hero__panel {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(180deg, rgba(0, 23, 54, 0.94) 0%, rgba(0, 23, 54, 0.78) 55%, rgba(0, 23, 54, 0.35) 100%);
  }
  /* A faint ring curling out of the bottom-left corner */
  .hero__ring {
    position: absolute;
    left: -12%;
    bottom: -40%;
    width: 60%;
    max-width: 640px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 48px rgba(255, 255, 255, 0.025);
    z-index: -1;
    pointer-events: none;
  }
  .hero__in {
    position: relative;
    display: grid;
    gap: var(--s-8);
    align-content: center;
    min-height: clamp(520px, 72svh, 720px);
    padding-block: var(--s-12) calc(var(--s-10) + 56px);
  }
  .hero__copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    max-width: 560px;
  }
  .hero__title {
    position: relative;
    font-size: clamp(2.4rem, 1.6rem + 2.9vw, 3.9rem);
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.03em;
    line-height: 1.06;
    padding-left: var(--s-6);
    max-width: 15ch;
  }
  /* The red bar beside the heading */
  .hero__title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.1em;
    width: 4px;
    border-radius: 2px;
    background: var(--red);
  }
  .hero__brand {
    color: var(--white);
  }
  .hero__lede {
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--t-lg);
    line-height: 1.55;
    max-width: 44ch;
    padding-left: var(--s-6);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-8);
    margin-top: var(--s-2);
    padding-left: var(--s-6);
  }
  .hero__link {
    color: var(--white);
    font-weight: 700;
    font-size: var(--t-md);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .hero__link:hover {
    color: var(--white);
    text-decoration-color: var(--red);
  }
  /* Pause and dots */
  .hero__ctrl {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-left: var(--s-6);
  }
  .hero__pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: background-color var(--dur) var(--ease);
  }
  .hero__pause:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .hero__pause .hero__play-ic,
  .hero__pause[aria-pressed='true'] .hero__pause-ic {
    display: none;
  }
  .hero__pause[aria-pressed='true'] .hero__play-ic {
    display: block;
  }
  .hero__dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.8);
    background: transparent;
    transition:
      width var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .hero__dot:hover {
    background: rgba(255, 255, 255, 0.4);
  }
  .hero__dot.is-on {
    width: 36px;
    background: var(--white);
    border-color: var(--white);
  }
  .hero__pause:focus-visible,
  .hero__dot:focus-visible {
    outline-color: var(--white);
  }
  /* The white curve across the hero's foot */
  .hero__curve {
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: -1px;
    height: 90px;
    background: var(--white);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    pointer-events: none;
  }
