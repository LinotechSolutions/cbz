---
/**
 * Footer, navy. The logo, tagline and address on the left, then five
 * columns: Contact Us, Our Businesses, The Group, Access and Explore Our
 * Solutions, each heading underlined in red. Everything comes from nav.ts
 * and facts.ts; a null link is hidden. Regulatory and off-site links live on
 * the sitemap page.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SOCIAL_ICON } from './icons';
import { CONTACT, GROUP, SOCIAL } from '../data/facts';
import { FOOTER } from '../data/nav';
import { visible } from '../lib/visible';
import { isExternal } from '../data/links';

const columns: { heading: string; links: readonly { label: string; href: string | null; external?: boolean }[] }[] = [
  { heading: 'Our Businesses', links: FOOTER.businesses },
  { heading: 'The Group', links: FOOTER.group },
  { heading: 'Access', links: FOOTER.access },
  { heading: 'Explore Our Solutions', links: FOOTER.solutions },
];
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo brand="holdings" on="dark" height={56} />
        <address class="footer__address">
          <Icon name="pin" size={18} class="footer__pin" />
          <span>
            {CONTACT.address.line1},<br />
            {CONTACT.address.line2}
          </span>
        </address>
      </div>

      <div class="footer__contact">
        <h2 class="footer__heading">Contact Us</h2>
        <ul role="list" class="footer__details">
          <li>
            <Icon name="phone" size={18} />
            <span><span class="footer__label">Phone:</span> <a href={CONTACT.contactCentre.href}>{CONTACT.contactCentre.display}</a></span>
          </li>
          <li>
            <Icon name="whatsapp" size={18} />
            <span>
              <span class="footer__label">WhatsApp:</span>
              <a href={CONTACT.whatsapp.href} target="_blank" rel="noopener noreferrer">
                {CONTACT.whatsapp.display}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </span>
          </li>
          <li>
            <Icon name="mail" size={18} />
            <span><span class="footer__label">Email:</span> <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></span>
          </li>
        </ul>
        <p class="footer__note">Our digital banking channels are available 24/7.</p>
        <p class="footer__note footer__note--quiet">Toll-free {CONTACT.tollFree.map((t) => t.display).join(' or ')} on all networks.</p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.heading} class="footer__col">
            <h2 class="footer__heading">{col.heading}</h2>
            <ul role="list" class="footer__links">
              {col.links
                .filter((l) => visible(l.href))
                .map((l) => (
                  <li>
                    <a
                      href={l.href!}
                      target={isExternal(l.href!) ? '_blank' : undefined}
                      rel={isExternal(l.href!) ? 'noopener noreferrer' : undefined}
                    >
                      {l.label}
                      {isExternal(l.href!) && (
                        <>
                          <Icon name="external" size={12} class="ext" />
                          <span class="sr-only">(opens in a new tab)</span>
                        </>
                      )}
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__bottom">
      <ul role="list" class="footer__social" aria-label="CBZ Holdings on social media">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="footer__social-link" title={`${s.name}: ${s.handle}`}>
                <Icon name={SOCIAL_ICON[s.name]} size={18} label={`${s.name} (opens in a new tab)`} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="small footer__legal">
        © {year} {GROUP.legalName}. {GROUP.regulatorLine}.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--blue);
    color: rgba(255, 255, 255, 0.88);
    padding-block: var(--s-12) var(--s-8);
    font-size: var(--t-sm);
  }
  .footer a {
    color: var(--white);
    text-decoration: none;
  }
  .footer a:hover {
    text-decoration: underline;
    color: var(--white);
  }
  /* Brand, contact and four link columns */
  .footer__grid {
    display: grid;
    gap: var(--s-8) var(--s-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-bottom: var(--s-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .footer__brand,
  .footer__contact {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .footer__brand,
    .footer__contact {
      grid-column: auto;
    }
  }
  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .footer__grid {
      grid-template-columns: 1.3fr 1.3fr repeat(4, minmax(0, 1fr));
      gap: var(--s-8) var(--s-5, 20px);
    }
  }
  .footer__brand {
    display: grid;
    gap: var(--s-6);
    align-content: start;
    justify-items: start;
  }
  .footer__address {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    font-style: normal;
    line-height: 1.4;
  }
  .footer__address :global(.footer__pin) {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .footer__contact {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .footer__details {
    display: grid;
    gap: var(--s-3);
  }
  .footer__details li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    font-variant-numeric: tabular-nums;
  }
  .footer__details li :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .footer__label {
    font-weight: 700;
    color: var(--white);
  }
  .footer__note {
    color: rgba(255, 255, 255, 0.88);
    margin-top: var(--s-2);
  }
  .footer__note--quiet {
    margin-top: 0;
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.66);
  }
  /* Headings carry a short red underline */
  .footer__heading {
    position: relative;
    font-size: var(--t-md);
    color: var(--white);
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .footer__heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 32px;
    height: 3px;
    border-radius: 2px;
    background: var(--red);
  }
  .footer__links {
    display: grid;
    gap: var(--s-1);
  }
  .footer__links a {
    display: inline-block;
    padding-block: var(--s-1);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-6);
  }
  .footer__social {
    display: flex;
    gap: var(--s-2);
  }
  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background-color var(--dur) var(--ease);
  }
  .footer__social-link:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .footer__legal {
    color: rgba(255, 255, 255, 0.7);
    max-width: none;
  }
</style>
