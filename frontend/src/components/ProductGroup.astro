---
/**
 * Products as cards in a row that snaps as you scroll: pill filters with an
 * icon each and previous/next arrows, then a card per product with a large
 * photograph (or the unit's icon) under a curved edge, a floating icon badge,
 * the name, a short summary, two benefits with check marks, a red primary
 * button and an understated "Tell me more" link. "Tell me more" opens a
 * dialog with pill tabs: What you get, Who it's for, What it costs, How to
 * get it. Without JavaScript every card shows and every panel is open.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { visible } from '../lib/visible';

export interface ProductRow {
  productId: string;
  category: string;
  name: string;
  summary: string;
  benefits: string[];
  eligibility: string[] | null;
  audience: string | null;
  /** Audience strip tags (personal, business, corporate, diaspora); an empty list shows for every audience. */
  audiences?: string[];
  pricing: string | null;
  details?: { tenor: string | null; interestRate: string | null; adminFee: string | null; limit: string | null };
  apply: { label: string; href: string };
  /** When set, these replace `apply` on the card: first primary, the rest secondary. */
  actions?: { label: string; href: string }[] | null;
  /** A photograph for the top of the card; cards without one show an icon. */
  image?: { src: string; alt: string } | null;
}

interface Props {
  unitSlug: string;
  categories: readonly { id: string; label: string }[];
  products: ProductRow[];
  primaryCta: { label: string; href: string };
  note?: string | null;
  idPrefix?: string;
  hideCta?: boolean;
  /** The unit's icon, used for "All" and for cards whose name suggests nothing more specific. */
  icon?: IconName;
}
const { unitSlug, categories, products, note, idPrefix = unitSlug, icon = 'wallet' } = Astro.props;

const cats = categories.filter((c) => products.some((p) => p.category === c.id));
const showFilters = cats.length > 1;

/* An icon for each filter pill and each card, from the wording. */
const iconFor = (text: string, fallback: IconName): IconName => {
  const t = text.toLowerCase();
  if (/joint|couple|family|group|employee|benefit/.test(t)) return 'users';
  if (/corporate|business|compan|school|church|sme|institution|merchant|pos/.test(t)) return 'building';
  if (/foreign|fca|diaspora|international|nostro|offshore/.test(t)) return 'globe';
  if (/student|education|school fees|tuition/.test(t)) return 'graduation';
  if (/saving|saver|deposit|invest|unit trust|wealth|fund|portfolio|treasury/.test(t)) return 'chart';
  if (/loan|lend|credit|mortgage|finance|capital|debt|syndicat/.test(t)) return 'bank';
  if (/card|visa|payment|pay|cash|wallet/.test(t)) return 'wallet';
  if (/touch|app|mobile|digital|internet|channel|e-statement|ussd/.test(t)) return 'phoneMobile';
  if (/motor|vehicle|car|fleet/.test(t)) return 'car';
  if (/home|house|property|residential|commercial|stand|office|estate/.test(t)) return 'home';
  if (/farm|agro|agri|crop|livestock|season/.test(t)) return 'leaf';
  if (/insur|cover|shield|protect|life|funeral|risk|claim|liabil|broking|reinsur/.test(t)) return 'shield';
  if (/advis|m&a|equity|ipo|listing|valuation|restructur/.test(t)) return 'chart';
  if (/individual|personal|current|private|senior|retail/.test(t)) return 'user';
  return fallback;
};

const factLabels: Record<string, string> = {
  interestRate: 'Interest',
  tenor: 'Term',
  adminFee: 'Admin fee',
  limit: 'Maximum',
};
function factsFor(p: ProductRow) {
  const facts: { value: string; label: string }[] = [];
  for (const [k, label] of Object.entries(factLabels)) {
    const v = p.details?.[k as keyof NonNullable<ProductRow['details']>];
    // Only short values read as big figures; longer ones stay in What it costs.
    if (visible(v) && v!.length <= 16) facts.push({ value: v!, label });
  }
  return facts.slice(0, 4);
}
/** Two short points for the card: the first two benefits, else the pricing line. */
function pointsFor(p: ProductRow) {
  const pts = (p.benefits ?? []).filter((b) => b.length <= 48).slice(0, 2);
  if (pts.length === 0 && visible(p.pricing)) pts.push(p.pricing!);
  return pts;
}
/** Long lists open on the first category so the page stays short; "All" is a tap away. */
const startFilter = products.length > 6 && cats.length > 1 ? cats[0].id : 'all';
const costLine = (p: ProductRow) =>
  visible(p.pricing) ? p.pricing! : 'Pricing is confirmed on application. Ask us for current terms before you rely on anything here.';
---

<div class="pc" data-product-cards data-unit={unitSlug} data-start={startFilter}>
  <div class="pc__bar">
    {
      showFilters ? (
        <div class="pc__filters" role="tablist" aria-label="Filter products">
          <button type="button" role="tab" class="pc__filter" aria-selected={startFilter === 'all' ? 'true' : 'false'} data-filter="all">
            <Icon name={icon} size={18} /> All
          </button>
          {cats.map((c) => (
            <button type="button" role="tab" class="pc__filter" aria-selected={startFilter === c.id ? 'true' : 'false'} data-filter={c.id} id={`panel-${idPrefix}-${c.id}`}>
              <Icon name={iconFor(c.label, icon)} size={18} /> {c.label}
            </button>
          ))}
        </div>
      ) : (
        <span />
      )
    }
    <div class="pc__arrows">
      <button type="button" class="pc__arrow" data-prev aria-label="Previous">
        <Icon name="arrowRight" size={20} class="pc__flip" />
      </button>
      <button type="button" class="pc__arrow" data-next aria-label="Next">
        <Icon name="arrowRight" size={20} />
      </button>
    </div>
  </div>

  <ul role="list" class="pc__grid" data-row>
    {
      products.map((p) => {
        const facts = factsFor(p);
        const points = pointsFor(p);
        const did = `detail-${idPrefix}-${p.productId}`;
        const actions = p.actions && p.actions.length > 0 ? p.actions : [p.apply];
        const hasPhoto = Boolean(p.image && visible(p.image.src));
        return (
          <li class="pcard" id={`product-${unitSlug}-${p.productId}`} data-category={p.category} data-audiences={(p.audiences ?? []).join(' ')}>
            <div class:list={['pcard__top', !hasPhoto && 'pcard__top--plain']}>
              {hasPhoto ? (
                <img src={p.image!.src} alt={p.image!.alt} width={600} height={400} loading="lazy" decoding="async" class="pcard__img" />
              ) : (
                <span class="pcard__wash" aria-hidden="true" />
              )}
              <span class="pcard__curve" aria-hidden="true" />
              <span class="pcard__badge" aria-hidden="true">
                <Icon name={iconFor(`${p.name} ${p.category}`, icon)} size={30} />
              </span>
            </div>
            <div class="pcard__body">
              <h3 class="pcard__title">{p.name}</h3>
              <p class="pcard__summary">{p.summary}</p>
              {points.length > 0 && (
                <ul class="pcard__points">
                  {points.map((b) => (
                    <li>
                      <span class="pcard__tick">
                        <Icon name="check" size={12} />
                      </span>
                      {b}
                    </li>
                  ))}
                </ul>
              )}
              {facts.length > 0 && (
                <dl class="pcard__facts">
                  {facts.map((f) => (
                    <div class="fact">
                      <dd class="fact__value">{f.value}</dd>
                      <dt class="fact__label">{f.label}</dt>
                    </div>
                  ))}
                </dl>
              )}
              <div class="pcard__actions">
                {actions.map((a, ai) => (
                  <Button href={a.href} variant={ai === 0 ? 'primary' : 'secondary'} track="apply_click" trackProps={{ unit: unitSlug, product: p.productId, action: a.label }}>
                    {a.label} {ai === 0 && <Icon name="arrowRight" size={18} />}
                  </Button>
                ))}
                <button type="button" class="pcard__more" aria-haspopup="dialog" aria-controls={did} data-more>
                  Tell me more <Icon name="chevronRight" size={16} class="pcard__more-ic" />
                </button>
              </div>
            </div>

            <dialog class="pdetail" id={did} data-detail aria-labelledby={`${did}-title`}>
              <div class="pdetail__head">
                <p class="pdetail__title" id={`${did}-title`}>{p.name}</p>
                <button type="button" class="pdetail__close" data-close aria-label="Close">
                  <Icon name="close" size={20} />
                </button>
              </div>
              <div class="pdetail__tabs" role="tablist" aria-label={`${p.name} details`}>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="true" data-tab="get">What you get</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="who">Who it's for</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="cost">What it costs</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="how">How to get it</button>
              </div>
              <div class="pdetail__panels">
                <section class="pdetail__panel" data-panel="get" role="tabpanel">
                  <h4 class="pdetail__h">What you get</h4>
                  {visible(p.benefits) ? (
                    <ul class="tri">
                      {p.benefits.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="muted">{p.summary}</p>
                  )}
                </section>
                <section class="pdetail__panel" data-panel="who" role="tabpanel">
                  <h4 class="pdetail__h">Who it's for</h4>
                  {visible(p.audience) ? <p>{p.audience}</p> : <p class="muted">Ask us whether this product fits you.</p>}
                </section>
                <section class="pdetail__panel" data-panel="cost" role="tabpanel">
                  <h4 class="pdetail__h">What it costs</h4>
                  <p>{costLine(p)}</p>
                  {facts.length > 0 && (
                    <ul class="tri">
                      {facts.map((f) => (
                        <li>
                          {f.label}: {f.value}
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
                <section class="pdetail__panel" data-panel="how" role="tabpanel">
                  <h4 class="pdetail__h">How to get it</h4>
                  {visible(p.eligibility) && (
                    <>
                      <p class="small muted">You will need</p>
                      <ul class="tri">
                        {p.eligibility!.map((e) => (
                          <li>{e}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  <p class="pdetail__actions">
                    {actions.map((a, ai) => (
                      <Button href={a.href} variant={ai === 0 ? 'primary' : 'secondary'} track="apply_click" trackProps={{ unit: unitSlug, product: p.productId, action: a.label, from: 'detail' }}>
                        {a.label}
                      </Button>
                    ))}
                  </p>
                </section>
                {visible(note) && <p class="pdetail__note small muted">{note}</p>}
              </div>
            </dialog>
          </li>
        );
      })
    }
  </ul>
  <!-- Shown when the chosen audience has nothing in this group; filled by the script. -->
  <div class="pc__empty" data-empty hidden>
    <p class="pc__empty-text" data-empty-text></p>
    <div class="pc__empty-actions" data-empty-actions></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-cards]').forEach((root) => {
    root.classList.add('pc--js');

    // Filter tabs, combined with the audience chosen in the header strip.
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.pcard'));
    const row = root.querySelector<HTMLElement>('[data-row]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const emptyText = root.querySelector<HTMLElement>('[data-empty-text]');
    const emptyActions = root.querySelector<HTMLElement>('[data-empty-actions]');
    let current = root.dataset.start || 'all';
    const audience = () => document.documentElement.dataset.audience || '';
    const serves = (c: HTMLElement, a: string) => {
      const tags = (c.dataset.audiences || '').split(' ').filter(Boolean);
      return !a || tags.length === 0 || tags.includes(a);
    };
    const labelFor = (a: string) => document.querySelector(`[data-audience-tab="${a}"]`)?.textContent?.trim() ?? a;
    function filter(id: string) {
      const a = audience();
      // A category pill with nothing for this audience is hidden; fall back to All.
      filters.forEach((f) => {
        const cat = f.dataset.filter!;
        f.hidden = cat !== 'all' && !cards.some((c) => c.dataset.category === cat && serves(c, a));
      });
      if (id !== 'all' && filters.some((f) => f.dataset.filter === id && f.hidden)) id = 'all';
      current = id;
      filters.forEach((f) => {
        const on = f.dataset.filter === id;
        f.setAttribute('aria-selected', on ? 'true' : 'false');
        f.tabIndex = on ? 0 : -1;
      });
      let shown = 0;
      cards.forEach((c) => {
        c.hidden = (id !== 'all' && c.dataset.category !== id) || !serves(c, a);
        if (!c.hidden) shown++;
      });
      row?.scrollTo({ left: 0 });
      const none = shown === 0 && a !== '';
      root.dataset.empty = none ? 'true' : 'false';
      // A sub-group with nothing for this audience steps aside when a sibling
      // in the same section still has cards; the empty note shows only when
      // every group in the section is empty.
      requestAnimationFrame(() => {
        const wrap = root.closest<HTMLElement>('.content');
        const body = wrap?.parentElement;
        if (!wrap || !body) return;
        const siblings = Array.from(body.querySelectorAll<HTMLElement>(':scope > .content [data-product-cards]')).filter((g) => g !== root);
        const siblingHasCards = siblings.some((g) => g.dataset.empty === 'false');
        // The wrapper has its own display rule, so toggle inline rather than with `hidden`.
        wrap.style.display = none && siblingHasCards ? 'none' : '';
      });
      if (empty && emptyText && emptyActions) {
        empty.hidden = !none;
        if (none) {
          emptyText.textContent = `Nothing here for ${labelFor(a)} yet.`;
          const others = Array.from(new Set(cards.flatMap((c) => (c.dataset.audiences || '').split(' ').filter(Boolean)))).filter((x) => x !== a);
          emptyActions.replaceChildren(
            ...others.map((o) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'btn btn--secondary';
              b.textContent = `Show ${labelFor(o)}`;
              b.addEventListener('click', () => document.dispatchEvent(new CustomEvent('cbz:audience-set', { detail: o })));
              return b;
            }),
          );
        }
      }
    }
    filter(current);
    document.addEventListener('cbz:audience', () => filter(current));
    filters.forEach((f, i) => {
      f.addEventListener('click', () => filter(f.dataset.filter!));
      f.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight') n = (i + 1) % filters.length;
        if (e.key === 'ArrowLeft') n = (i - 1 + filters.length) % filters.length;
        if (n >= 0) {
          e.preventDefault();
          filters[n].focus();
          filter(filters[n].dataset.filter!);
        }
      });
    });

    // Arrows step one card at a time, skipping cards the filters have hidden.
    if (row) {
      const step = () => (row.querySelector<HTMLElement>('.pcard:not([hidden])')?.offsetWidth ?? 300) + 24;
      const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      root.querySelector('[data-prev]')?.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: smooth }));
      root.querySelector('[data-next]')?.addEventListener('click', () => row.scrollBy({ left: step(), behavior: smooth }));
    }

    // Tell me more opens the details in a modal dialog; Escape, the close
    // button and a click on the backdrop close it, and focus returns to the opener.
    cards.forEach((card) => {
      const more = card.querySelector<HTMLButtonElement>('[data-more]');
      const detail = card.querySelector<HTMLDialogElement>('[data-detail]');
      if (!more || !detail) return;
      more.addEventListener('click', () => {
        detail.showModal();
        detail.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.focus();
      });
      detail.querySelector('[data-close]')?.addEventListener('click', () => detail.close());
      detail.addEventListener('click', (e) => {
        if (e.target === detail) detail.close();
      });
      const tabs = Array.from(detail.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const panels = Array.from(detail.querySelectorAll<HTMLElement>('[data-panel]'));
      function select(id: string, focus = false) {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
        });
      }
      select('get');
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.tab!));
        t.addEventListener('keydown', (e) => {
          let n = -1;
          if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          if (n >= 0) {
            e.preventDefault();
            select(tabs[n].dataset.tab!, true);
          }
        });
      });
    });

    // Deep links: #product-<unit>-<id> opens that card's detail.
    function openHash() {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const card = root.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
      if (!card) return;
      // A deep link to a card outside the chosen audience switches to one it serves.
      const a = audience();
      if (!serves(card, a)) {
        const first = (card.dataset.audiences || '').split(' ').filter(Boolean)[0];
        if (first) document.dispatchEvent(new CustomEvent('cbz:audience-set', { detail: first }));
      }
      filter('all');
      card.scrollIntoView({ block: 'start', inline: 'start' });
      const detail = card.querySelector<HTMLDialogElement>('[data-detail]');
      if (detail && !detail.open) detail.showModal();
    }
    window.addEventListener('hashchange', openHash);
    openHash();
  });
</script>

<style>
  .pc {
    display: grid;
    gap: var(--s-6);
  }
  .pc__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
  }
  /* Pill filters, navy when selected */
  .pc__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .pc__filter {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 var(--s-5, 20px);
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--white);
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--blue);
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .pc__filter:hover {
    background: var(--blue-50);
  }
  .pc__filter[aria-selected='true'] {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--white);
  }
  .pc__filter[hidden] {
    display: none;
  }
  /* The chosen audience has nothing in this group */
  .pc__empty {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-6);
    border: 1px dashed var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .pc__empty[hidden] {
    display: none;
  }
  .pc__empty-text {
    font-weight: 700;
    color: var(--blue);
  }
  .pc__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .pc__arrows {
    display: none;
    gap: var(--s-2);
    margin-left: auto;
  }
  @media (min-width: 640px) {
    .pc__arrows {
      display: flex;
    }
  }
  .pc__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    color: var(--blue);
    border: 1px solid var(--line);
    background: var(--white);
    transition: background-color var(--dur) var(--ease);
  }
  .pc__arrow:hover {
    background: var(--blue-50);
  }
  .pc__arrow :global(.pc__flip) {
    transform: scaleX(-1);
  }

  /* One row that snaps as you scroll: one card on phones, two on tablets,
     three on laptops, four on wide screens */
  .pc__grid {
    display: flex;
    gap: var(--s-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    padding-block: var(--s-2) var(--s-4);
  }
  .pc__grid::-webkit-scrollbar {
    display: none;
  }
  .pcard {
    position: relative;
    flex: 0 0 min(86vw, 340px);
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease);
  }
  @media (min-width: 640px) {
    .pcard {
      flex-basis: calc((100% - var(--s-6)) / 2);
    }
  }
  @media (min-width: 900px) {
    .pcard {
      flex-basis: calc((100% - 2 * var(--s-6)) / 3);
    }
  }
  @media (min-width: 1200px) {
    .pcard {
      flex-basis: calc((100% - 3 * var(--s-6)) / 4);
    }
  }
  .pcard:hover {
    box-shadow: var(--shadow-card);
  }
  .pcard[hidden] {
    display: none;
  }
  /* The photograph under a curved edge, with a red arc in the top corner */
  .pcard__top {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--blue-50);
  }
  .pcard__top--plain {
    aspect-ratio: 4 / 1;
  }
  .pcard__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--blue-100), var(--blue-50) 60%, var(--white));
  }
  .pcard__top::before {
    content: '';
    position: absolute;
    top: -70px;
    left: -70px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 18px solid var(--red);
    opacity: 0.9;
    z-index: 1;
  }
  .pcard__curve {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -1px;
    height: 40px;
    background: var(--white);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    z-index: 2;
  }
  /* The floating icon badge over the join between photograph and copy */
  .pcard__badge {
    position: absolute;
    bottom: -24px;
    left: var(--s-5, 20px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--blue);
    box-shadow: var(--shadow-float);
