---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import { Calculator } from '../islands/Calculator';
import { CALCULATORS } from '../data/calculators';

const items = [
  { id: 'mortgage', key: 'mortgage', label: 'Mortgage' },
  { id: 'car-finance', key: 'carFinance', label: 'Car finance' },
  { id: 'car-insurance', key: 'carInsurance', label: 'Car insurance' },
  { id: 'policy-quote', key: 'policyQuote', label: 'Life policy' },
] as const;
---

<BaseLayout
  title="Calculators"
  description="Work out a mortgage or car finance repayment, and get an indicative car insurance or life policy premium, before you apply."
>
  <div class="container head">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Calculators' }]} />
    <h1>Calculators</h1>
    <p class="lede">Work out a repayment or premium before you apply. Every figure is indicative.</p>
    <nav aria-label="Calculators on this page" class="jump">
      {items.map((i) => <a href={`#${i.id}`}>{i.label}</a>)}
    </nav>
  </div>

  {
    items.map((i, idx) => (
      <Section id={i.id} tone={idx % 2 ? 'tint' : 'white'} heading={CALCULATORS[i.key].title} hideHeading>
        <Calculator client:visible variant={i.key} config={CALCULATORS[i.key]} />
      </Section>
    ))
  }
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-8) var(--s-4);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
  }
  .jump a {
    font-weight: 700;
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .jump a:hover {
    text-decoration: underline;
  }
</style>
