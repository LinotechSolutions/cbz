---
/**
 * A business unit page, built from its site-map branch:
 *   hero → audience chips → one section per branch, in the map's order.
 * Each branch's children render by kind: forms and pages as link cards,
 * off-site links as cards hidden while their URL is null, app stores as
 * badges, product lists, calculators and listings inline, notes as dashed
 * cards. Nothing else is added to the page.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TaskCard from '../components/TaskCard.astro';
import Section from '../components/Section.astro';
import ProductGroup from '../components/ProductGroup.astro';
import Faq from '../components/Faq.astro';
import Listings from '../components/Listings.astro';
import StoreBadges from '../components/StoreBadges.astro';
import StickyCta from '../components/StickyCta.astro';
import Icon from '../components/Icon.astro';
import { Calculator } from '../islands/Calculator';
import { CALCULATORS } from '../data/calculators';
import { LINKS, isExternal } from '../data/links';
import { CONTACT } from '../data/facts';
import { visible } from '../lib/visible';
import type { DarkSafeLogoKey } from '../data/logos';

interface Props {
  unit: CollectionEntry<'units'>['data'];
}
const { unit } = Astro.props;
type Item = (typeof unit.branches)[number]['items'][number];

const products = (await getCollection('products', (p) => p.data.unit === unit.slug))
  .map((p) => p.data)
  .sort((a, b) => a.order - b.order);

const clusterLabel: Record<string, { label: string; href: string }> = {
  banking: { label: 'Banking', href: '/clusters/banking' },
  investments: { label: 'Investments', href: '/clusters/investments' },
  insurance: { label: 'Insurance', href: '/clusters/insurance' },
  'agro-business': { label: 'Agro-Business', href: '/clusters/agro-business' },
  philanthropy: { label: 'The Group', href: '/the-group' },
};
const cluster = clusterLabel[unit.cluster];
const site = Astro.site ?? new URL('https://www.cbz.co.zw');

/** Products for one branch item, by category and/or product id. */
function productsFor(item: Item) {
  return products.filter((p) => {
    const byCat = item.categories ? item.categories.includes(p.category) : false;
    const byId = item.productIds ? item.productIds.includes(p.productId) : false;
    return byCat || byId;
  });
}
function categoriesFor(item: Item) {
  const present = new Set(productsFor(item).map((p) => p.category));
  return unit.categories.filter((c) => present.has(c.id));
}
const isCard = (i: Item) => ['form', 'page', 'external', 'note'].includes(i.kind);
const isShown = (i: Item) => (i.kind === 'external' || i.kind === 'form' || i.kind === 'page' ? visible(i.href) : true);

/** Group consecutive card items so they share a grid; content items stand alone. */
function runs(items: Item[]) {
  const out: { kind: 'cards' | 'content'; items: Item[] }[] = [];
  for (const it of items.filter(isShown)) {
    const last = out[out.length - 1];
    if (isCard(it)) {
      if (last && last.kind === 'cards') last.items.push(it);
      else out.push({ kind: 'cards', items: [it] });
    } else out.push({ kind: 'content', items: [it] });
  }
  return out;
}

const productItemCount = unit.branches.flatMap((b) => b.items).filter((i) => i.kind === 'products').length;
const branches = unit.branches.map((b) => ({ ...b, runs: runs(b.items) })).filter((b) => b.runs.length > 0);
const hiddenBranches = unit.branches.filter((b) => !branches.some((x) => x.id === b.id)).map((b) => b.title);

/** Red Sphere loan calculator: products with the rate and tenor the documentation states. */
const pct = (s: string | null | undefined) => {
  const m = s?.match(/(\d+(?:\.\d+)?)\s*%/);
  return m ? Number(m[1]) : null;
};
const months = (s: string | null | undefined) => {
  const m = s?.match(/(\d+)\s*months?/i);
  return m ? Number(m[1]) : null;
};
const loanProducts = products
  .filter((p) => p.category === 'salary' || p.category === 'business' || p.category === 'partners')
  .map((p) => ({ id: p.productId, label: p.name, ratePct: pct(p.details?.interestRate), maxMonths: months(p.details?.tenor) }));

/* The photograph on each unit's "still unanswered?" card. */
const FAQ_PHOTO: Record<string, { src: string; alt: string }> = {
  bank: { src: '/images/cbz-banking.webp', alt: '' },
  insurance: { src: '/images/insurance-health.webp', alt: '' },
  properties: { src: '/images/loan-home.webp', alt: '' },
  datvest: { src: '/images/cbz-wealth.webp', alt: '' },
  capital: { src: '/images/accounts/partnership.webp', alt: '' },
};

const appLinks = {
  'cbz-touch': { appStore: LINKS.touch.appStore, playStore: LINKS.touch.playStore },
  'red-sphere': { appStore: LINKS.redSphere.appStore, playStore: LINKS.redSphere.playStore },
  'ziki-cash': { appStore: LINKS.zikiCash.appStore, playStore: LINKS.zikiCash.playStore },
} as const;

const segments = unit.segments.map((s) => ({ label: s.label, href: s.href, line: s.line ?? undefined }));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FinancialService',
    name: unit.name,
    description: unit.seo.description,
    parentOrganization: { '@type': 'Organization', name: 'CBZ Holdings Limited' },
    url: new URL(`/${unit.slug}`, site).toString(),
    telephone: CONTACT.contactCentre.display,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
      { '@type': 'ListItem', position: 2, name: cluster.label, item: new URL(cluster.href, site).toString() },
      { '@type': 'ListItem', position: 3, name: unit.name },
    ],
  },
];
---

<BaseLayout
  title={unit.seo.title}
  description={unit.seo.description}
  jsonLd={jsonLd}
  unitLogo={unit.logo as DarkSafeLogoKey}
  preloadImage={unit.hero.image.src}
>
  <Hero
    variant="split"
    title={unit.hero.title}
    lede={unit.hero.lede}
    image={unit.hero.image}
    logo={unit.logo as DarkSafeLogoKey}
    crumbs={[{ label: 'Home', href: '/' }, { label: cluster.label, href: cluster.href }, { label: unit.shortName }]}
    primary={{ ...unit.primaryCta, track: 'apply_click', trackProps: { unit: unit.slug, from: 'hero' } }}
    secondary={unit.secondaryCta ?? undefined}
    overlap={segments.length > 0}
  />

  {segments.length > 0 && <TaskCard heading="Who we serve" items={segments} kind="jump" />}

  <div class="branches" data-unit={unit.slug}>
    {
      branches.map((b, bi) => (
        <Section id={b.id} tone={bi % 2 === 0 ? 'white' : 'tint'} heading={b.title} lede={b.line ?? undefined} class="branch" data-branch={b.id}>
          <div class="branch__body">
            {b.runs.map((run, ri) =>
              run.kind === 'cards' ? (
                <ul role="list" class="cards" style={`--n:${Math.min(run.items.length, 3)}`}>
                  {run.items.map((it) => {
                    if (it.kind === 'note') {
                      return (
                        <li class="note">
                          <span class="note__label">{it.label}</span>
                          {visible(it.line) && <span class="note__line">{it.line}</span>}
                        </li>
                      );
                    }
                    const ext = it.kind === 'external' || isExternal(it.href!);
                    return (
                      <li>
                        <a
                          href={it.href!}
                          class="card-link card-base"
                          target={ext ? '_blank' : undefined}
                          rel={ext ? 'noopener noreferrer' : undefined}
                          data-track="apply_click"
                          data-track-props={JSON.stringify({ unit: unit.slug, branch: b.id, item: it.label })}
                        >
                          <span class="card-link__label">
                            {it.label}
                            {ext && <span class="sr-only"> (opens in a new tab)</span>}
                          </span>
                          {visible(it.line) && <span class="card-link__line">{it.line}</span>}
                          <span class="icon-pill card-link__icon">
                            <Icon name={ext ? 'external' : 'arrowRight'} size={16} />
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                run.items.map((it, ii) => {
                  const key = `${b.id}-${ri}-${ii}`;
                  if (it.kind === 'products') {
                    const list = productsFor(it);
                    const cats = categoriesFor(it);
                    const showHead = b.items.filter((x) => x.kind === 'products').length > 1;
                    return (
                      <div class="content" id={`${b.id}-${it.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
                        {showHead && (
                          <div class="content__head">
                            <h3>{it.label}</h3>
                            {visible(it.line) && <p class="muted small">{it.line}</p>}
                          </div>
                        )}
                        <ProductGroup
                          unitSlug={unit.slug}
                          idPrefix={productItemCount > 1 ? `${unit.slug}-${b.id}-${ii}` : unit.slug}
                          categories={cats}
                          products={list}
                          primaryCta={unit.primaryCta}
                          note={unit.productsNote}
                        />
                      </div>
                    );
                  }
                  if (it.kind === 'calculator' && it.calculator) {
                    return (
                      <div class="content" id={`calc-${key}`}>
                        <Calculator
                          client:visible
                          variant={it.calculator}
                          config={CALCULATORS[it.calculator]}
                          products={it.calculator === 'loan' ? loanProducts : undefined}
                        />
                      </div>
                    );
                  }
                  if (it.kind === 'listings') {
                    return (
                      <div class="content">
                        <Listings />
                      </div>
                    );
                  }
                  if (it.kind === 'faq' && it.faqs && it.faqs.length > 0) {
                    return (
                      <div class="content">
                        <Faq
                          id={unit.slug}
                          faqs={it.faqs}
                          contactHref={it.href ?? '/contact'}
                          contactLabel={it.label}
                          team={unit.name}
                          image={FAQ_PHOTO[unit.slug] ?? { src: '/images/cbz-banking-branch.webp', alt: '' }}
                        />
                      </div>
                    );
                  }
                  if (it.kind === 'app' && it.app) {
                    return (
                      <div class="content app">
                        <span class="app__label">{it.label}</span>
                        <StoreBadges app={it.app} appStore={appLinks[it.app].appStore} playStore={appLinks[it.app].playStore} />
                        {!visible(appLinks[it.app].appStore) && !visible(appLinks[it.app].playStore) && (
                          <p class="small muted">Store links coming soon.</p>
                        )}
                      </div>
                    );
                  }
                  return null;
                })
              ),
            )}
          </div>
        </Section>
      ))
    }
    {hiddenBranches.length > 0 && <span hidden data-branches-awaiting-link={hiddenBranches.join(', ')} />}
  </div>

  <StickyCta label={unit.primaryCta.label} href={unit.primaryCta.href} unit={unit.slug} />
</BaseLayout>

<style>
  .branch__body {
    display: grid;
    gap: var(--s-8);
  }
  .branch__cta {
    order: 99;
  }
  .content {
    display: grid;
    gap: var(--s-4);
  }
  .content__head {
    display: grid;
    gap: var(--s-1);
  }
  .cards {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
  .card-link {
    position: relative;
    display: grid;
    gap: var(--s-1);
    align-content: start;
    min-height: 120px;
    height: 100%;
    padding: var(--s-6) var(--s-12) var(--s-6) var(--s-6);
    text-decoration: none;
    color: var(--ink);
  }
  .card-link:hover {
    color: var(--ink);
  }
  .card-link__label {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
    line-height: 1.25;
  }
  .card-link__line {
    font-size: var(--t-sm);
    color: var(--grey);
  }
  .card-link__icon {
    position: absolute;
    right: var(--s-6);
    top: var(--s-6);
  }
  .note {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    min-height: 120px;
    padding: var(--s-6);
    border: 1px dashed var(--blue-100);
    border-radius: var(--r-md);
    background: var(--blue-50);
  }
  .note__label {
    font-weight: 700;
    color: var(--blue);
    font-size: var(--t-md);
  }
  .note__line {
    font-size: var(--t-sm);
    color: var(--grey);
  }
  .app {
    justify-items: start;
    gap: var(--s-3);
  }
  .app__label {
    font-weight: 700;
    color: var(--blue);
  }
</style>
