# ============================================================
# CBZ Holdings Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://cbz_user:cbz_password@localhost:5432/cbz_holdings

# Redis (caching + rate-limit backing store)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT token lifetimes (seconds)
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=86400

# Gemini AI (chatbot)
GEMINI_API_KEY=your-gemini-api-key-here

# Admin path (obscured — no default /admin/)
ADMIN_URL_PATH=cbz-secure-admin/

# Rate limiting
ANON_THROTTLE_RATE=60/minute
USER_THROTTLE_RATE=120/minute
AUTH_THROTTLE_RATE=5/minute
CHATBOT_THROTTLE_RATE=10/minute

# Security headers (production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Frontend URL (for CSRF trusted origins)
FRONTEND_URL=http://localhost:3000

# Email (customer journey confirmations). Leave EMAIL_HOST empty to print emails to the logs instead.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=webcenter@cbz.co.zw
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CBZ <webcenter@cbz.co.zw>
CONTACT_CENTRE_EMAIL=contactcentre@cbz.co.zw
