---
/**
 * The Group: Structure, Awards, Milestones and Board, as on the site map.
 * The Board renders only once the business supplies the profiles.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { CLUSTERS, companiesIn, heldBy, VALUE_PROPOSITION, type ClusterId } from '../data/group';
import { AWARDS, GROUP, MILESTONES, BOARD } from '../data/facts';
import { LINKS } from '../data/links';
import { visible } from '../lib/visible';
import type { DarkSafeLogoKey } from '../data/logos';

const board = visible(BOARD) ? BOARD! : [];
const jump = [
  { label: 'Structure', href: '#structure' },
  { label: 'Awards', href: '#awards' },
  { label: 'Milestones', href: '#milestones' },
  ...(board.length ? [{ label: 'Board', href: '#board' }] : []),
];
---

<BaseLayout
  title="The Group"
  description="CBZ Holdings, founded in 1980 and listed on the Zimbabwe Stock Exchange, is ten operating companies in four clusters: banking, investments, insurance and agro-business."
>
  <Hero
    title="One group, ten companies"
    lede={`Founded in ${GROUP.founded} and ${GROUP.listingLine.toLowerCase()}, CBZ Holdings brings banking, investments, insurance and agribusiness under one roof.`}
    image={{ src: '/images/cbzpicture1.webp', alt: 'CBZ Holdings head office' }}
    logo="holdings"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'The Group' }]}
    overlap={false}
  />

  <nav class="container jump" aria-label="On this page">
    {jump.map((j) => <a href={j.href}>{j.label}</a>)}
  </nav>

  <Section id="why" heading="Why one group" hideHeading compact>
    <ul role="list" class="why">
      {
        VALUE_PROPOSITION.map((v) => (
          <li class="why__item">
            <h3>{v.title}</h3>
            <p class="small">{v.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="structure" heading="Structure" lede="Four operating clusters, plus the CBZ Foundation held directly by the Group.">
    <div class="structure">
      {
        CLUSTERS.map((c) => (
          <section class="cluster" aria-labelledby={`cl-${c.id}`}>
            <h3 id={`cl-${c.id}`}>
              <a href={c.route}>{c.name}</a>
            </h3>
            <ul role="list" class="cluster__list">
              {companiesIn(c.id as ClusterId).map((co) => {
                const held = heldBy(co.id);
                return (
                  <li class="company">
                    {co.logo ? <Logo brand={co.logo as DarkSafeLogoKey} on="light" height={28} decorative /> : <span class="company__blank" aria-hidden="true" />}
                    <span class="company__text">
                      {co.route ? <a href={co.route}>{co.name}</a> : <span>{co.name}</span>}
                      {held.length > 0 && (
                        <span class="small muted">
                          holds {held.map((h) => `${h.name} (${h.ownership})`).join(', ')}
                        </span>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </Section>

  <Section id="awards" heading="Awards">
    <ul role="list" class="awards">
      {
        AWARDS.map((a) => (
          <li class="award">
            <span class="award__title">{a.title}</span>
            <span class="small muted">
              {a.awarder}, {a.years.join(', ')}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="small ir">
      <ExternalLink href={LINKS.investorRelations}>Investor relations and annual reports</ExternalLink>
    </p>
  </Section>

  <Section id="milestones" heading="Milestones">
    <ol class="timeline" role="list">
      {
        MILESTONES.map((m) => (
          <li class="timeline__item">
            <span class="timeline__period">{m.period}</span>
            <span class="timeline__text">{m.text}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    board.length > 0 && (
      <Section id="board" heading="Board">
        <ul role="list" class="board">
          {board.map((p) => (
            <li class="person">
              {p.image ? <ResponsiveImage src={p.image.src} alt={p.image.alt} ratio="1:1" /> : <div class="person__placeholder" aria-hidden="true" />}
              <span class="person__name">{p.name}</span>
              <span class="small muted">{p.role}</span>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    padding-top: var(--s-6);
  }
  .jump a {
    font-weight: 700;
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .jump a:hover {
    text-decoration: underline;
  }
  .why {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .why {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .why {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .why__item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-6) 0;
    border-top: 2px solid var(--blue-100);
  }
  .structure {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .structure {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cluster {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .cluster h3 a {
    text-decoration: none;
    color: var(--blue);
  }
  .cluster h3 a:hover {
    text-decoration: underline;
  }
  .cluster__list {
    display: grid;
    gap: var(--s-3);
  }
  .company {
    display: flex;
    gap: var(--s-3);
    align-items: center;
  }
  .company__blank {
    width: 40px;
    height: 28px;
    flex-shrink: 0;
  }
  .company__text {
    display: grid;
    gap: 2px;
  }
  .company__text a {
    font-weight: 700;
    text-decoration: none;
  }
  .company__text a:hover {
    text-decoration: underline;
  }
  .awards {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .awards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .award {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .award__title {
    font-weight: 700;
    color: var(--blue);
  }
  .ir {
    margin-top: var(--s-8);
  }
  .timeline {
    display: grid;
    gap: var(--s-4);
    max-width: 720px;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .timeline__period {
    font-weight: 700;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .board {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
  .person {
    display: grid;
    gap: var(--s-2);
  }
  .person__placeholder {
    aspect-ratio: 1;
    background: var(--blue-100);
    border-radius: var(--r-md);
  }
  .person__name {
    font-weight: 700;
    color: var(--blue);
  }
</style>
