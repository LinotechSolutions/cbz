---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleRail from '../../components/ArticleRail.astro';

const notices = (await getCollection('notices'))
  .filter((n) => n.data.category !== 'security')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map((n) => ({
    id: n.id,
    title: n.data.title,
    summary: n.data.summary,
    date: n.data.date,
    category: n.data.category,
    reference: n.data.reference,
    href: `/notices/${n.id}`,
  }));
---

<BaseLayout title="Latest from CBZ" description="Shareholder circulars, customer notices and regulatory announcements from CBZ Holdings.">
  <div class="container crumbs">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Latest from CBZ' }]} />
  </div>
  {
    notices.length > 0 ? (
      <ArticleRail id="notices" heading="Latest from CBZ" headingStrong="Latest" articles={notices} filters />
    ) : (
      <p class="container muted">No notices at the moment.</p>
    )
  }
</BaseLayout>

<style>
  .crumbs {
    padding-top: var(--s-8);
  }
</style>
