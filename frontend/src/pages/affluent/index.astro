---
/**
 * Affluent Banking overview: the three tiers as photo cards, a comparison
 * of what each one includes, and the solutions every tier shares.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import StickyCta from '../../components/StickyCta.astro';
import { TIERS, SOLUTIONS, AFFLUENT_HOME, tierHref, solutionHref } from '../../data/affluent';
import { CONTACT } from '../../data/facts';

const rows: { label: string; values: string[] }[] = [
  { label: 'Who it is for', values: TIERS.map((t) => t.who) },
  { label: 'Relationship', values: TIERS.map((t) => t.know[0].items[0]) },
  { label: 'Card', values: TIERS.map((t) => t.card) },
  { label: 'Income-based loan', values: ['Up to $40,000 over 50 months', 'Up to $30,000 over 48 months', 'Up to $50,000 (bespoke lending)'] },
  { label: 'Overdraft', values: ['Up to $5,000', 'Up to $2,000', 'Up to $5,000'] },
  { label: 'Property-backed equity facility', values: TIERS.map(() => 'Up to 60% of property value') },
  { label: 'Lifestyle', values: ['Airport lounges, gyms, restaurants; exclusive events', 'Networking activities; economic updates', 'Airport lounges, gyms, restaurants; exclusive events'] },
  { label: 'Email', values: TIERS.map((t) => t.email) },
];
---

<BaseLayout title={AFFLUENT_HOME.title} description={AFFLUENT_HOME.lede} unitLogo="bank">
  <header class="hero on-dark" aria-labelledby="hero-heading">
    <span class="hero__arc" aria-hidden="true"></span>
    <div class="container hero__in">
      <Breadcrumbs tone="dark" items={[{ label: 'Home', href: '/' }, { label: 'Banking', href: '/clusters/banking' }, { label: AFFLUENT_HOME.title }]} />
      <p class="hero__eyebrow"><span class="hero__tri" aria-hidden="true"></span>CBZ Bank</p>
      <h1 id="hero-heading" class="hero__title">Affluent Banking</h1>
      <p class="hero__lede">{AFFLUENT_HOME.lede}</p>
      <div class="hero__actions">
        <a href="/bank/call-me-back" class="btn btn--primary btn--lg" data-track="apply_click" data-track-props='{"unit":"bank","from":"affluent"}'>
          Talk to us <Icon name="arrowRight" size={18} />
        </a>
        <a href="#compare" class="btn btn--secondary btn--lg">Compare the tiers</a>
      </div>
    </div>
  </header>

  <section class="band" id="tiers" aria-labelledby="tiers-heading">
    <div class="container">
      <h2 id="tiers-heading" class="sec__title">Three tiers, one relationship</h2>
      <ul role="list" class="tiers">
        {
          TIERS.map((t) => (
            <li class="tier on-dark">
              <img class="tier__img" src={t.image.src} alt="" width={600} height={600} loading="lazy" decoding="async" />
              <div class="tier__copy">
                <h3 class="tier__title">{t.name}</h3>
                <p class="tier__line">{t.title}</p>
                <p class="tier__who">{t.who}</p>
                <a href={tierHref(t.id)} class="btn btn--secondary tier__btn">
                  Tell me more
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" id="compare" aria-labelledby="compare-heading">
    <div class="container">
      <h2 id="compare-heading" class="sec__title">Compare the three tiers</h2>
      <div class="compare__scroll">
        <table class="compare__table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">What</span></th>
              {
                TIERS.map((t) => (
                  <th scope="col">
                    <a href={tierHref(t.id)}>{t.name}</a>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.values.map((v) => (
                    <td>{v.startsWith('privatebanking') || v.startsWith('primebanking') || v.startsWith('wealthmanagement') ? <a href={`mailto:${v}`}>{v}</a> : v}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted">Loans, overdrafts and credit cards are subject to credit approval. Figures are from the CBZ Bank Private Banking, Prime Banking and Wealth Management brochures.</p>
    </div>
  </section>

  <section class="band" id="solutions" aria-labelledby="solutions-heading">
    <div class="container">
      <h2 id="solutions-heading" class="sec__title">What every tier can get</h2>
      <ul role="list" class="sols">
        {
          SOLUTIONS.map((s) => (
            <li>
              <a href={solutionHref(s.id)} class="sol card-base">
                <span class="sol__ic" aria-hidden="true">
                  <Icon name={s.icon} size={26} />
                </span>
                <span class="sol__title">{s.name}</span>
                <span class="sol__line">{s.cardLine}</span>
                <span class="go sol__go">
                  Tell me more <Icon name="arrowRight" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band--compact" aria-label="Contact the affluent banking teams">
    <div class="container contact">
      {
        TIERS.map((t) => (
          <div class="contact__card">
            <strong>{t.name}</strong>
            <a href={`mailto:${t.email}`}>{t.email}</a>
            <span class="small muted">
              {CONTACT.contactCentre.display}, toll free {CONTACT.tollFree.map((x) => x.display).join(' / ')}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <StickyCta label="Talk to us" href="/bank/call-me-back" unit="bank" />
</BaseLayout>

<style>
  .sec__title {
    font-size: var(--t-2xl);
    color: var(--ink);
    margin-bottom: var(--s-8);
  }
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 80% 10%, rgba(255, 255, 255, 0.08), transparent 45%), linear-gradient(135deg, var(--blue-900), var(--blue));
    color: var(--white);
  }
  .hero__arc {
    position: absolute;
    top: -45%;
    right: -8%;
    width: 56vw;
    max-width: 700px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 14px solid var(--red);
    border-color: var(--red) var(--red) transparent transparent;
    transform: rotate(-20deg);
    pointer-events: none;
  }
  .hero__in {
    position: relative;
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding-block: var(--s-8) var(--s-12);
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__tri {
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid var(--red);
  }
  .hero__title {
    font-size: var(--t-3xl);
    color: var(--white);
  }
  .hero__lede {
    color: rgba(255, 255, 255, 0.86);
    max-width: 60ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .hero__actions .btn {
    gap: var(--s-2);
  }
  .tiers {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tier {
    position: relative;
    display: grid;
    grid-template-rows: 200px 1fr;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: linear-gradient(180deg, var(--blue-900), var(--blue));
    color: var(--white);
  }
  .tier__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .tier__copy {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
    padding: 0 var(--s-6) var(--s-6);
  }
  .tier__title {
    color: var(--white);
    font-size: var(--t-xl);
  }
  .tier__line {
    color: var(--white);
    font-weight: 700;
  }
  .tier__who {
    color: rgba(255, 255, 255, 0.84);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .tier__btn {
    margin-top: var(--s-2);
  }
  .compare__scroll {
    overflow-x: auto;
    margin-bottom: var(--s-4);
  }
  .compare__table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  .compare__table th,
  .compare__table td {
    padding: var(--s-4);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }
  .compare__table thead th {
    font-size: var(--t-md);
    color: var(--blue);
    border-bottom: 3px solid var(--red);
  }
  .compare__table thead th a {
    color: var(--blue);
    text-decoration: none;
  }
  .compare__table tbody th {
    color: var(--grey);
    width: 22%;
  }
  .sols {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .sols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .sols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sol {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-5, 20px);
    text-decoration: none;
    color: var(--ink);
  }
  .sol__ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--red-50);
    color: var(--red);
  }
  .sol__title {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
  }
  .sol__line {
    color: var(--grey);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .contact {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 720px) {
    .contact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .contact__card {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-5, 20px);
    border-left: 3px solid var(--red);
    background: var(--blue-50);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  .contact__card strong {
    color: var(--blue);
  }
</style>
