---
import { getCollection, getEntry } from 'astro:content';
import UnitLayout from '../../layouts/UnitLayout.astro';
import Section from '../../components/Section.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { PropertyFilters } from '../../islands/PropertyFilters';
import { Calculator } from '../../islands/Calculator';
import { CALCULATORS } from '../../data/calculators';
import { LINKS } from '../../data/links';
import { visible } from '../../lib/visible';

const unit = (await getEntry('units', 'properties'))!.data;
const listings = (await getCollection('properties')).map((p) => p.data).sort((a, b) => a.order - b.order);
const locations = [...new Set(listings.map((l) => l.location))].sort();
const statusLabel = { 'for-sale': 'For sale', 'to-let': 'To let', sold: 'Sold' } as const;
const typeLabel = { residential: 'Residential', commercial: 'Commercial', land: 'Land' } as const;
---

<UnitLayout unit={unit}>
  <Fragment slot="before-products">
    <Section id="listings" tone="tint" heading="Listings" lede="Filter by type, location and status. The link updates so you can share what you find.">
      <PropertyFilters client:idle locations={locations} total={listings.length} />
      <ul role="list" class="listings">
        {
          listings.map((l) => (
            <li class="lst" data-property data-type={l.type} data-location={l.location} data-status={l.status}>
              <a href={`/properties/${l.id}`} class="lst__link">
                <ResponsiveImage src={l.images[0].src} alt={l.images[0].alt || l.title} ratio="3:2" />
                <span class="lst__body">
                  <span class="lst__meta small">
                    {typeLabel[l.type]}, {l.location}, {statusLabel[l.status].toLowerCase()}
                  </span>
                  <span class="lst__title">{l.title}</span>
                  <span class="lst__price">{visible(l.price) ? l.price : 'Price on application'}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      {listings.length === 0 && <p class="muted">No listings yet. Ask us about current developments.</p>}
    </Section>
  </Fragment>

  <Fragment slot="after-products">
    <Section id="management" heading="Property management" lede="Already with us? Manage your leased or managed property.">
      <div class="mgmt">
        <p>
          CBZ Properties manages leases, rent collection, maintenance and facilities for landlords and tenants.
          Managed-property clients can sign in to view statements and log requests.
        </p>
        <div class="mgmt__actions">
          {
            visible(LINKS.propertiesSite) ? (
              <Button href={LINKS.propertiesSite!} variant="secondary">
                Sign in to property management
              </Button>
            ) : (
              <Button href="/contact" variant="secondary">
                Contact property management
              </Button>
            )
          }
          <a href="/properties/request-a-viewing" class="btn btn--quiet">
            Request a valuation <Icon name="chevronRight" size={16} />
          </a>
        </div>
      </div>
    </Section>

    <Section id="mortgage" tone="tint" heading="Finance it" lede="Estimate the monthly repayment on a CBZ Bank mortgage.">
      <Calculator client:visible variant="mortgage" config={CALCULATORS.mortgage} />
    </Section>
  </Fragment>
</UnitLayout>

<style>
  .listings {
    display: grid;
    gap: var(--gap);
    margin-top: var(--s-6);
  }
  @media (min-width: 640px) {
    .listings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .listings {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .lst[hidden] {
    display: none;
  }
  .lst__link {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--white);
    overflow: hidden;
    height: 100%;
    transition: border-color var(--dur) var(--ease);
  }
  .lst__link:hover {
    border-color: var(--blue-700);
    color: var(--ink);
  }
  .lst__link :global(.frame) {
    border-radius: 0;
  }
  .lst__body {
    display: grid;
    gap: var(--s-1);
    padding: 0 var(--s-4) var(--s-4);
  }
  .lst__meta {
    color: var(--grey);
  }
  .lst__title {
    font-weight: 700;
    color: var(--blue);
    font-size: var(--t-md);
  }
  .lst__price {
    font-weight: 700;
    color: var(--blue-700);
    font-size: var(--t-sm);
  }
  .mgmt {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 900px) {
    .mgmt {
      grid-template-columns: 7fr 5fr;
      align-items: center;
    }
  }
  .mgmt__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
  }
</style>
