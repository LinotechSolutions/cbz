---
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** Accessible label; omit when the icon is decorative beside text. */
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className = '' } = Astro.props;
const icon = ICONS[name] as { d: string; fill?: boolean };
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={icon.d}></path>
</svg>
