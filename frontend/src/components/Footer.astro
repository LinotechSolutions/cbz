---
/**
 * Footer. The logo and address, a Contact Us block, then three columns from
 * the site map: Our Businesses, Explore Our Solutions, The Group and Access.
 * Everything comes from nav.ts and facts.ts; a null link is hidden.
 * Regulatory and off-site links live on the sitemap page.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SOCIAL_ICON } from './icons';
import { CONTACT, GROUP, SOCIAL } from '../data/facts';
import { FOOTER } from '../data/nav';
import { visible } from '../lib/visible';
import { isExternal } from '../data/links';

const columns: { heading: string; links: readonly { label: string; href: string | null; external?: boolean }[] }[] = [
  { heading: 'Our Businesses', links: FOOTER.businesses },
  { heading: 'Explore Our Solutions', links: FOOTER.journeys },
  { heading: 'The Group and Access', links: FOOTER.group },
];
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo brand="holdings" on="dark" height={56} />
        <address class="footer__address">
          {CONTACT.address.line1}, {CONTACT.address.line2}
        </address>
      </div>

      <div class="footer__contact">
        <h2 class="footer__heading">Contact Us</h2>
        <ul role="list" class="footer__details">
          <li>
            <span class="footer__label">Phone:</span>
            <a href={CONTACT.contactCentre.href}>{CONTACT.contactCentre.display}</a>
          </li>
          <li>
            <span class="footer__label">WhatsApp:</span>
            <a href={CONTACT.whatsapp.href} target="_blank" rel="noopener noreferrer">
              {CONTACT.whatsapp.display}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <span class="footer__label">Email:</span>
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          </li>
        </ul>
        <p class="footer__note">Our digital banking channels are available 24/7.</p>
        <p class="footer__note small">Toll-free {CONTACT.tollFree.map((t) => t.display).join(' or ')} on all networks.</p>
      </div>
    </div>

    <div class="footer__cols">
      {
        columns.map((col) => (
          <nav aria-label={col.heading} class="footer__col">
            <h2 class="footer__heading">{col.heading}</h2>
            <ul role="list" class="footer__links">
              {col.links
                .filter((l) => visible(l.href))
                .map((l) => (
                  <li>
                    <a
                      href={l.href!}
                      target={isExternal(l.href!) ? '_blank' : undefined}
                      rel={isExternal(l.href!) ? 'noopener noreferrer' : undefined}
                    >
                      {l.label}
                      {isExternal(l.href!) && (
                        <>
                          <Icon name="external" size={12} class="ext" />
                          <span class="sr-only">(opens in a new tab)</span>
                        </>
                      )}
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__bottom">
      <ul role="list" class="footer__social" aria-label="CBZ Holdings on social media">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="footer__social-link" title={`${s.name}: ${s.handle}`}>
                <Icon name={SOCIAL_ICON[s.name]} size={18} label={`${s.name} (opens in a new tab)`} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="small footer__legal">
        © {year} {GROUP.legalName}. {GROUP.regulatorLine}.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--blue-900);
    color: rgba(255, 255, 255, 0.82);
    padding-block: var(--s-16) var(--s-8);
    font-size: var(--t-sm);
  }
  .footer a {
    color: var(--white);
    text-decoration: none;
  }
  .footer a:hover {
    text-decoration: underline;
    color: var(--white);
  }
  .footer__top {
    display: grid;
    gap: var(--s-8);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }
  .footer__brand {
    display: grid;
    gap: var(--s-5, 20px);
    align-content: start;
    justify-items: start;
  }
  .footer__address {
    font-style: normal;
  }
  .footer__contact {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .footer__details {
    display: grid;
    gap: var(--s-2);
  }
  .footer__details li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-variant-numeric: tabular-nums;
  }
  .footer__details a {
    font-weight: 700;
  }
  .footer__label {
    color: rgba(255, 255, 255, 0.7);
    min-width: 5.5em;
  }
  .footer__note {
    color: rgba(255, 255, 255, 0.82);
  }
  .footer__note + .footer__note {
    color: rgba(255, 255, 255, 0.62);
  }
  .footer__cols {
    display: grid;
    gap: var(--s-8) var(--s-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: var(--s-8);
  }
  @media (min-width: 900px) {
    .footer__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .footer__heading {
    font-size: var(--t-sm);
    color: var(--white);
    margin-bottom: var(--s-3);
  }
  .footer__contact .footer__heading {
    margin-bottom: 0;
  }
  .footer__links {
    display: grid;
    gap: var(--s-2);
  }
  .footer__links a {
    display: inline-block;
    padding-block: var(--s-1);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .footer__social {
    display: flex;
    gap: var(--s-2);
  }
  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background-color var(--dur) var(--ease);
  }
  .footer__social-link:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .footer__legal {
    color: rgba(255, 255, 255, 0.7);
    max-width: none;
  }
</style>
