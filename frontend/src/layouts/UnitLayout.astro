---
/**
 * Every business unit page, in the site map's order:
 *   Opening (hero, the unit's actions, about and key facts)
 *   Products & FAQ
 *   Find the right fit
 *   Leadership
 *   Contact
 * Campaigns, leadership, objectives and audience render only when present.
 * Slots: before-products, after-products, fit (for a suggestion island).
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ProductGroup from '../components/ProductGroup.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import StickyCta from '../components/StickyCta.astro';
import { visible } from '../lib/visible';
import { isExternal } from '../data/links';
import { CONTACT } from '../data/facts';
import type { DarkSafeLogoKey } from '../data/logos';

interface Props {
  unit: CollectionEntry<'units'>['data'];
  heroImage?: { src: string; alt: string };
}
const { unit, heroImage } = Astro.props;

const products = (await getCollection('products', (p) => p.data.unit === unit.slug))
  .map((p) => p.data)
  .sort((a, b) => a.order - b.order);

const now = new Date();
const campaigns = (await getCollection('campaigns', (c) => c.data.unit === unit.slug))
  .map((c) => c.data)
  .filter((c) => new Date(c.starts) <= now && new Date(c.ends) >= now)
  .sort((a, b) => a.order - b.order)
  .slice(0, 3);

const clusterLabel: Record<string, { label: string; href: string }> = {
  banking: { label: 'Banking', href: '/clusters/banking' },
  investments: { label: 'Investments', href: '/clusters/investments' },
  insurance: { label: 'Insurance', href: '/clusters/insurance' },
  'agro-business': { label: 'Agro-Business', href: '/clusters/agro-business' },
  philanthropy: { label: 'The Group', href: '/the-group' },
};
const cluster = clusterLabel[unit.cluster];

const actions = unit.actions.filter((a) => visible(a.href));
const hiddenActions = unit.actions.filter((a) => !visible(a.href));
const leadership = visible(unit.leadership) ? unit.leadership! : [];
const site = Astro.site ?? new URL('https://www.cbz.co.zw');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FinancialService',
    name: unit.name,
    description: unit.seo.description,
    parentOrganization: { '@type': 'Organization', name: 'CBZ Holdings Limited' },
    url: new URL(`/${unit.slug}`, site).toString(),
    telephone: CONTACT.contactCentre.display,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
      { '@type': 'ListItem', position: 2, name: cluster.label, item: new URL(cluster.href, site).toString() },
      { '@type': 'ListItem', position: 3, name: unit.name },
    ],
  },
  ...(unit.faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: unit.faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={unit.seo.title}
  description={unit.seo.description}
  jsonLd={jsonLd}
  unitLogo={unit.logo as DarkSafeLogoKey}
  preloadImage={(heroImage ?? unit.hero.image).src}
>
  <!-- 1. Opening -->
  <Hero
    title={unit.hero.title}
    lede={unit.hero.lede}
    image={heroImage ?? unit.hero.image}
    logo={unit.logo as DarkSafeLogoKey}
    crumbs={[{ label: 'Home', href: '/' }, { label: cluster.label, href: cluster.href }, { label: unit.shortName }]}
    primary={{ ...unit.primaryCta, track: 'apply_click', trackProps: { unit: unit.slug, from: 'hero' } }}
    secondary={unit.secondaryCta ?? undefined}
    overlap={actions.length > 0}
  />

  {
    actions.length > 0 && (
      <div class="actions-wrap">
        <div class="container">
          <nav class="actions" aria-label={`What you can do with ${unit.shortName}`}>
            <ul role="list" class="actions__list" style={`--n:${Math.min(actions.length, 5)}`}>
              {actions.map((a) => {
                const ext = a.kind === 'external' || isExternal(a.href!);
                return (
                  <li>
                    <a
                      href={a.href!}
                      class="action"
                      target={ext ? '_blank' : undefined}
                      rel={ext ? 'noopener noreferrer' : undefined}
                      data-track="apply_click"
                      data-track-props={JSON.stringify({ unit: unit.slug, action: a.label })}
                    >
                      <span class="action__label">
                        {a.label}
                        {ext && <span class="sr-only"> (opens in a new tab)</span>}
                      </span>
                      {visible(a.line) && <span class="action__line">{a.line}</span>}
                      <Icon name={ext ? 'external' : a.kind === 'anchor' ? 'chevronDown' : 'chevronRight'} size={18} class="action__icon" />
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </div>
      </div>
    )
  }

  <Section id="about" heading={`About ${unit.shortName}`} hideHeading>
    <div class="about">
      <div class="about__copy stack">
        <h2 class="about__h">About {unit.shortName}</h2>
        <p>{unit.about}</p>
        {
          visible(unit.heldEntities) && (
            <p class="small muted">
              Also holds {unit.heldEntities!.map((h) => `${h.name} (${h.stake}%)`).join(' and ')}.
            </p>
          )
        }
        {visible(unit.regulator) && <p class="small muted">{unit.regulator}</p>}
      </div>
      <div class="about__facts">
        <KeyFacts facts={unit.keyFacts} />
      </div>
    </div>
    {
      (visible(unit.objectives) || visible(unit.audience)) && (
        <div class="about__extra">
          {visible(unit.objectives) && (
            <div class="stack">
              <h3>Our objectives</h3>
              <ul class="about__list">
                {unit.objectives!.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </div>
          )}
          {visible(unit.audience) && (
            <div class="stack">
              <h3>Who we serve</h3>
              <ul class="about__list">
                {unit.audience!.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )
    }
  </Section>

  <slot name="before-products" />

  <!-- 2. Products & FAQ -->
  {
    products.length > 0 && (
      <Section id="products" tone="tint" heading="Products and services">
        <ProductGroup
          unitSlug={unit.slug}
          categories={unit.categories}
          products={products}
          primaryCta={unit.primaryCta}
          note={unit.productsNote}
        />
      </Section>
    )
  }

  {
    unit.faq.length > 0 && (
      <Section id="faq" heading="Questions people ask" compact>
        <div class="faq rule-list">
          {unit.faq.map((f) => (
            <details class="faq__item">
              <summary class="faq__q">
                {f.q}
                <Icon name="chevronDown" size={20} class="faq__chev" />
              </summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </Section>
    )
  }

  <slot name="after-products" />

  <!-- 3. Find the right fit -->
  {
    (unit.segments.length > 0 || Astro.slots.has('fit')) && (
      <Section id="fit" tone="tint" heading="Find the right fit" lede="Start from who you are, or answer two questions.">
        {unit.segments.length > 0 && (
          <ul role="list" class="segments" style={`--n:${Math.min(unit.segments.length, 4)}`}>
            {unit.segments.map((s) => (
              <li>
                <a href={s.href} class="segment">
                  <span class="segment__label">{s.label}</span>
                  {visible(s.line) && <span class="segment__line">{s.line}</span>}
                  <Icon name="arrowRight" size={18} class="segment__icon" />
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="fit-slot">
          <slot name="fit" />
        </div>
      </Section>
    )
  }

  {
    campaigns.length > 0 && (
      <Section id="offers" heading="Offers" compact>
        <ul role="list" class="offers" style={`--n:${campaigns.length}`}>
          {campaigns.map((c) => (
            <li class="offer">
              <ResponsiveImage src={c.image.src} alt={c.image.alt} ratio="4:3" />
              <div class="offer__body stack">
                {visible(c.offer) && <p class="figure">{c.offer}</p>}
                <h3>{c.title}</h3>
                <p class="small muted">{c.body}</p>
                <Button href={c.cta.href} variant="secondary">
                  {c.cta.label}
                </Button>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- 4. Leadership -->
  {
    leadership.length > 0 && (
      <Section id="leadership" tone="surface" heading="Leadership" compact>
        <ul role="list" class="people">
          {leadership.map((p) => (
            <li class="person">
              {p.image ? (
                <ResponsiveImage src={p.image.src} alt={p.image.alt} ratio="1:1" class="person__img" />
              ) : (
                <div class="person__placeholder" aria-hidden="true" />
              )}
              <span class="person__name">{p.name}</span>
              <span class="person__role small muted">{p.role}</span>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- 5. Contact -->
  <Section id="contact" tone="dark">
    <div class="contact on-dark">
      <div class="stack">
        <h2>{unit.contact.heading}</h2>
        <p class="contact__body">{unit.contact.body}</p>
      </div>
      <div class="contact__actions">
        <Button href={unit.primaryCta.href} variant="primary" size="lg" track="apply_click" trackProps={{ unit: unit.slug, from: 'contact' }}>
          {unit.primaryCta.label}
        </Button>
        <a href={CONTACT.contactCentre.href} class="btn btn--secondary btn--lg">
          Call {CONTACT.contactCentre.display}
        </a>
      </div>
    </div>
  </Section>

  {hiddenActions.length > 0 && <span hidden data-actions-awaiting-link={hiddenActions.map((a) => a.label).join(', ')} />}

  <StickyCta label={unit.primaryCta.label} href={unit.primaryCta.href} unit={unit.slug} />
</BaseLayout>

<style>
  .actions-wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--overlap, 56px));
  }
  .actions {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--s-3);
  }
  .actions__list {
    display: grid;
    gap: var(--s-1);
  }
  @media (min-width: 900px) {
    .actions__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 0;
    }
    .actions__list > li + li {
      border-left: 1px solid var(--line);
    }
  }
  .action {
    position: relative;
    display: grid;
    gap: 2px;
    padding: var(--s-3) var(--s-10, 40px) var(--s-3) var(--s-4);
    min-height: var(--tap);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
    transition: background-color var(--dur) var(--ease);
  }
  .action:hover {
    background: var(--blue-50);
    color: var(--ink);
  }
  .action__label {
    font-weight: 700;
    color: var(--blue);
  }
  .action__line {
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .action__icon {
    position: absolute;
    right: var(--s-3);
    top: var(--s-3);
    color: var(--blue-700);
  }
  .about {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-12);
      align-items: start;
    }
  }
  .about__h {
    font-size: var(--t-xl);
  }
  .about__extra {
    display: grid;
    gap: var(--s-8);
    margin-top: var(--s-12);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .about__extra {
      grid-template-columns: 1fr 1fr;
    }
  }
  .about__list {
    padding-left: 1.1em;
    display: grid;
    gap: var(--s-2);
  }
  .faq {
    max-width: 800px;
  }
  .faq__item {
    padding: var(--s-2) 0;
  }
  .faq__q {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    min-height: var(--tap);
    padding: var(--s-2) 0;
    cursor: pointer;
    font-weight: 700;
    color: var(--blue);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__chev {
    flex-shrink: 0;
    color: var(--blue-700);
    transition: transform var(--dur) var(--ease);
  }
  .faq__item[open] .faq__chev {
    transform: rotate(180deg);
  }
  .faq__a {
    padding: 0 0 var(--s-4);
    max-width: var(--measure);
  }
  .segments {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .segments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .segments {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
  .segment {
    position: relative;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6) var(--s-12) var(--s-6) var(--s-6);
    min-height: 120px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--dur) var(--ease);
  }
  .segment:hover {
    border-color: var(--blue-700);
    color: var(--ink);
  }
  .segment__label {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
  }
  .segment__line {
    font-size: var(--t-sm);
    color: var(--grey);
  }
  .segment__icon {
    position: absolute;
    right: var(--s-6);
    top: var(--s-6);
    color: var(--blue-700);
  }
  .fit-slot:not(:empty) {
    margin-top: var(--s-8);
  }
  .offers {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .offers {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
  .offer {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .offer :global(.frame) {
    border-radius: 0;
  }
  .offer__body {
    padding: var(--s-6);
  }
  .people {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
  .person {
    display: grid;
    gap: var(--s-2);
  }
  .person__placeholder {
    aspect-ratio: 1;
    background: var(--blue-100);
    border-radius: var(--r-md);
  }
  .person__name {
    font-weight: 700;
    color: var(--blue);
  }
  .contact {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1fr auto;
    }
  }
  .contact__body {
    color: rgba(255, 255, 255, 0.82);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
