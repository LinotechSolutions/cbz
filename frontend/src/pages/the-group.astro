---
/**
 * The Group: Structure, Awards, Milestones, Board and Executive committee,
 * as on the site map. Board and executive names come from the annual report;
 * portraits show a placeholder until photographs are supplied.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import OrgChart from '../components/OrgChart.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { CLUSTERS, companiesIn, heldBy, VALUE_PROPOSITION, type ClusterId } from '../data/group';
import { AWARDS, GROUP, MILESTONES, BOARD, BOARD_COMMITTEES, EXCO } from '../data/facts';
import { LINKS } from '../data/links';
import { visible } from '../lib/visible';
import type { DarkSafeLogoKey } from '../data/logos';

const board = visible(BOARD) ? BOARD! : [];
/* The structure cards: the verb on the first line, the promise on the second. */
const SUBLINE: Record<string, string> = {
  banking: 'for every day',
  investments: 'to grow your wealth',
  insurance: 'what matters most',
  'agro-business': 'the whole value chain',
};
const operating = CLUSTERS.filter((c) => c.isOperating);
const foundation = CLUSTERS.find((c) => c.id === 'philanthropy');
const jump = [
  { label: 'Structure', href: '#structure' },
  { label: 'Awards', href: '#awards' },
  { label: 'Milestones', href: '#milestones' },
  ...(board.length ? [{ label: 'Board', href: '#board' }] : []),
  ...(EXCO.length ? [{ label: 'Executive management', href: '#exco' }] : []),
];
---

<BaseLayout
  title="The Group"
  description="CBZ Holdings, founded in 1980 and listed on the Zimbabwe Stock Exchange, is ten operating companies in four clusters: banking, investments, insurance and farming."
>
  <!-- Who we are: a wide photograph with a navy panel rising out of its lower edge -->
  <header class="who" id="about" aria-labelledby="who-heading">
    <div class="who__photo">
      <img src="/images/about-capital.webp" alt="" width={1280} height={960} loading="eager" fetchpriority="high" decoding="async" />
      <div class="container who__crumbs">
        <Breadcrumbs tone="dark" items={[{ label: 'Home', href: '/' }, { label: 'About us' }, { label: 'Who we are' }]} />
      </div>
    </div>
    <div class="container">
      <div class="who__panel on-dark">
        <h1 id="who-heading" class="who__title">Who we are</h1>
        <p class="who__text">
          CBZ Holdings is your partner for success. Founded in {GROUP.founded} and {GROUP.listingLine.charAt(0).toLowerCase()}{GROUP.listingLine.slice(1)}, the Group brings banking, investments, insurance and farming
          together under one roof: {GROUP.companies.toLowerCase()} in {GROUP.clusters.toLowerCase()}, built around the sectors our clients work in.
        </p>
        <p class="who__text">{GROUP.regulatorLine}.</p>
      </div>
    </div>
  </header>

  <nav class="container jump" aria-label="On this page">
    {jump.map((j) => <a href={j.href}>{j.label}</a>)}
  </nav>

  <Section id="why" heading="Why one group" hideHeading compact>
    <ul role="list" class="why">
      {
        VALUE_PROPOSITION.map((v) => (
          <li class="why__item">
            <h3>{v.title}</h3>
            <p class="small">{v.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="structure" heading="Structure" lede="Four operating clusters, plus the CBZ Foundation held directly by the Group.">
    <div class="structure">
      {
        operating.map((c) => {
          const companies = companiesIn(c.id as ClusterId);
          const held = companies.flatMap((co) => heldBy(co.id).map((h) => ({ ...h, parent: co.name })));
          return (
            <section class="cl" aria-labelledby={`cl-${c.id}`}>
              <div class="cl__top">
                <span class="cl__blob" aria-hidden="true" />
                <ul role="list" class="cl__logos">
                  {companies.map((co) => (
                    <li class="cl__logo">
                      {co.logo ? (
                        co.route ? (
                          <a href={co.route} aria-label={co.name}>
                            <Logo brand={co.logo as DarkSafeLogoKey} on="light" height={26} decorative />
                          </a>
                        ) : (
                          <Logo brand={co.logo as DarkSafeLogoKey} on="light" height={26} decorative />
                        )
                      ) : (
                        <span class="cl__name">{co.name}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="cl__head">
                <span class="cl__chev" aria-hidden="true" />
                <h3 id={`cl-${c.id}`} class="cl__title">
                  <span class="cl__verb">{c.taskLabel}</span>
                  <span class="cl__sub">{SUBLINE[c.id] ?? c.line}</span>
                </h3>
              </div>
              <p class="cl__text">
                {c.summary}
                {held.length > 0 && ` ${held.map((h) => `${h.parent} holds ${h.name} (${h.ownership}).`).join(' ')}`}
              </p>
              <ul role="list" class="cl__names">
                {companies.map((co) => (
                  <li>{co.route ? <a href={co.route}>{co.name}</a> : co.name}</li>
                ))}
              </ul>
              <a href={c.route} class="btn btn--primary btn--lg cl__btn">
                Explore {c.shortName} <Icon name="arrowRight" size={18} />
              </a>
            </section>
          );
        })
      }
    </div>
    {
      foundation && (
        <p class="structure__note">
          <Icon name="users" size={20} />
          <span>
            Alongside the four clusters, the <a href={foundation.route}>CBZ Foundation</a> is held directly by CBZ Holdings: {foundation.summary}
          </span>
        </p>
      )
    }
  </Section>

  <Section id="awards" heading="Awards">
    <ul role="list" class="awards">
      {
        AWARDS.map((a) => (
          <li class="award">
            <span class="award__title">{a.title}</span>
            <span class="small muted">
              {a.awarder}, {a.years.join(', ')}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="small ir">
      <ExternalLink href={LINKS.investorRelations}>Investor relations and annual reports</ExternalLink>
    </p>
  </Section>

  <Section id="milestones" heading="Milestones">
    <ol class="timeline" role="list">
      {
        MILESTONES.map((m) => (
          <li class="timeline__item">
            <span class="timeline__period">{m.period}</span>
            <span class="timeline__text">{m.text}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    board.length > 0 && (
      <Section
        id="board"
        heading="Board leadership"
        lede="Six independent non-executive directors and two executive directors, with the Group Chief Legal Counsel attending ex officio."
      >
        <OrgChart
          id="board"
          variant="board"
          lead="chair"
          people={board}
          rowMax={5}
          bandTitle="Executive directors"
          bandLine="The Group CEO and CFO sit on the board; the Group Chief Legal Counsel attends ex officio."
        />
        <div class="committees">
          <span class="committees__label">Board committees</span>
          <ul role="list" class="committees__list">
            {BOARD_COMMITTEES.map((c) => (
              <li class="committees__item">{c}</li>
            ))}
          </ul>
        </div>
      </Section>
    )
  }

  {
    EXCO.length > 0 && (
      <Section id="exco" heading="Executive management" lede="The Group executive committee leads the eleven operating companies day to day.">
        <OrgChart
          id="exco"
          variant="executive"
          lead="first"
          leadTag="Group Chief Executive Officer"
          people={EXCO}
          rowMax={5}
          bandTitle="Group functions and clusters"
          bandLine="Twelve executives lead the eleven operating companies."
        />
      </Section>
    )
  }
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    padding-top: var(--s-6);
  }
  .jump a {
    font-weight: 700;
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .jump a:hover {
    text-decoration: underline;
  }
  .why {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .why {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .why {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .why__item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-6) 0;
    border-top: 2px solid var(--blue-100);
  }
  /* ---------- Who we are ---------- */
  .who {
    background: var(--surface);
    padding-bottom: var(--s-8);
  }
  .who__photo {
    position: relative;
    height: 300px;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .who__photo {
      height: 440px;
    }
  }
  .who__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
    filter: saturate(0.6);
  }
  .who__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 23, 54, 0.55), rgba(0, 23, 54, 0.1) 40%, transparent);
  }
  .who__crumbs {
    position: relative;
    z-index: 1;
    padding-top: var(--s-4);
  }
  /* The panel rises out of the photograph: navy where the design has green, with the brand's red rule */
  .who__panel {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-4);
    max-width: 960px;
    margin: -120px auto 0;
    padding: var(--s-8) var(--s-6) var(--s-10, 40px);
    border-radius: var(--r-sm);
    background: var(--blue);
    color: var(--white);
    box-shadow: var(--shadow-float);
  }
  @media (min-width: 900px) {
    .who__panel {
      margin-top: -180px;
      padding: var(--s-12) var(--s-12) var(--s-12);
    }
  }
  .who__panel::before {
    content: '';
    width: 56px;
    height: 4px;
    border-radius: 2px;
    background: var(--red);
  }
  .who__title {
    color: var(--white);
    font-size: var(--t-3xl);
    letter-spacing: -0.015em;
  }
  .who__text {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--t-md);
    line-height: 1.7;
    max-width: 70ch;
  }

  /* ---------- Structure: four tall cards ---------- */
  .structure {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .structure {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .structure {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .cl {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: var(--s-5, 20px);
    padding: var(--s-6) var(--s-6) var(--s-8);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
  }
  /* Company logos on a soft navy blob, like the partner logos on the design */
  .cl__top {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 170px;
    padding: var(--s-4);
  }
  .cl__blob {
    position: absolute;
    inset: 10% 8%;
    border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%;
    background: var(--blue-50);
  }
  .cl__logos {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-3) var(--s-5, 20px);
  }
  .cl__logo a {
    display: inline-flex;
    padding: var(--s-1);
    border-radius: var(--r-sm);
  }
  .cl__name {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--blue);
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--line);
  }
  /* The heading: a red half-disc pointing at the big verb and its promise */
  .cl__head {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--s-4);
    align-items: center;
    margin-left: calc(-1 * var(--s-6));
  }
  .cl__chev {
    width: 56px;
    height: 88px;
    background: var(--red);
    border-radius: 0 88px 88px 0;
  }
  .cl__title {
    display: grid;
    line-height: 1;
  }
  .cl__verb {
    font-size: var(--t-3xl);
    font-weight: 700;
    color: var(--blue);
    letter-spacing: -0.02em;
  }
  .cl__sub {
    font-size: var(--t-lg);
    font-weight: 400;
    color: var(--blue);
    margin-top: var(--s-1);
  }
  .cl__text {
    color: var(--grey);
    font-size: var(--t-sm);
    line-height: 1.6;
  }
  .cl__names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-size: var(--t-xs);
    font-weight: 700;
  }
  .cl__names a {
    text-decoration: none;
    color: var(--blue-700);
  }
  .cl__names a:hover {
    text-decoration: underline;
  }
  .cl__btn {
    justify-self: start;
    gap: var(--s-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--t-sm);
  }
  .structure__note {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    margin-top: var(--s-8);
    color: var(--grey);
    font-size: var(--t-sm);
    max-width: var(--measure);
  }
  .structure__note :global(svg) {
    color: var(--red);
    flex-shrink: 0;
  }
  .awards {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .awards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .award {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .award__title {
    font-weight: 700;
    color: var(--blue);
  }
  .ir {
    margin-top: var(--s-8);
  }
  .timeline {
    display: grid;
    gap: var(--s-4);
    max-width: 720px;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .timeline__period {
    font-weight: 700;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  /* Board committees under the hierarchy chart */
  .committees {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .committees__label {
    font-weight: 700;
    color: var(--blue);
  }
  .committees__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .committees__item {
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-pill);
    background: var(--blue-50);
    color: var(--blue);
    font-size: var(--t-sm);
    font-weight: 700;
  }
</style>
