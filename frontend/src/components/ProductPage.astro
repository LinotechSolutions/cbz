    interested.length > 0 && (
      <section class="band" id="interested" aria-labelledby="interested-heading">
        <div class="container">
          <h2 id="interested-heading" class="sec__title">You might be interested in</h2>
          <ul role="list" class="rel">
            {interested.map((r) => {
              const ra = (r.actions && r.actions[0]) ?? r.apply;
              return (
                <li class="rel__card">
                  <h3 class="rel__title">{r.name}</h3>
                  <div class="rel__row">
                    <img class="rel__img" src={imageFor(r)} alt="" width={240} height={240} loading="lazy" decoding="async" />
