---
/**
 * The white strip above the header: Personal, Business, School and Diaspora.
 * It sticks to the top with the navy bar beneath it.
 *
 * A tab opens that audience's home page (/, /business, /school, /diaspora)
 * and makes it the chosen audience. The choice is kept in localStorage and
 * follows the visitor from page to page: the navy tab stays put, and every
 * product carousel and property listing shows that audience's products. A
 * page can also be opened for one audience with `?for=<audience>`. Visiting
 * an audience home selects that audience. Without JavaScript the tabs are
 * plain links and the server's default (the page's own audience, else
 * Personal) is marked.
 */
import { AUDIENCES } from '../data/nav';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
/** The audience whose home this is; Personal everywhere else before the visitor chooses. */
const own = AUDIENCES.find((a) => a.match.test(currentPath))?.id ?? '';
const active = own || 'personal';
---

<nav class="aud" aria-label="Who we serve" data-audience-bar data-own={own}>
  <div class="container aud__inner">
    <ul role="list" class="aud__list">
      {
        AUDIENCES.map((a) => (
          <li class:list={['aud__item', { 'is-active': a.id === active }]}>
            <a href={a.href} class="aud__tab" data-audience-tab={a.id} aria-current={a.id === active ? 'true' : undefined}>
              {a.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const KEY = 'cbz-audience';
  const root = document.querySelector<HTMLElement>('[data-audience-bar]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-audience-tab]'));
    const ids = tabs.map((t) => t.dataset.audienceTab!);
    const own = root.dataset.own || '';

    const stored = (): string => {
      const q = new URLSearchParams(location.search).get('for');
      if (q && ids.includes(q)) return q;
      try {
        const s = localStorage.getItem(KEY);
        if (s && ids.includes(s)) return s;
      } catch {
        /* storage blocked */
      }
      return '';
    };
    const remember = (id: string) => {
      try {
        localStorage.setItem(KEY, id);
      } catch {
        /* storage blocked */
      }
    };
    const apply = (id: string) => {
      document.documentElement.dataset.audience = id;
      tabs.forEach((t) => {
        const on = t.dataset.audienceTab === id;
        t.parentElement?.classList.toggle('is-active', on);
        if (on) t.setAttribute('aria-current', 'true');
        else t.removeAttribute('aria-current');
      });
      document.dispatchEvent(new CustomEvent('cbz:audience', { detail: id }));
    };

    // An audience home selects its audience; elsewhere the remembered choice applies.
    const initial = own || stored() || 'personal';
    if (own) remember(own);
    apply(initial);

    // A tab is a link to the audience home; remember the choice on the way.
    tabs.forEach((t) => t.addEventListener('click', () => remember(t.dataset.audienceTab!)));

    // Product groups offer the audiences they do serve when the chosen one is empty.
    document.addEventListener('cbz:audience-set', (e) => {
      const id = (e as CustomEvent<string>).detail;
      if (!ids.includes(id)) return;
      remember(id);
      apply(id);
      const u = new URL(location.href);
      u.searchParams.set('for', id);
      history.replaceState(null, '', u);
    });
  }
</script>

<style>
  .aud {
    position: sticky;
    top: 0;
    z-index: 51;
    background: var(--white);
    height: var(--strip-h);
  }
  .aud__inner {
    height: 100%;
  }
  .aud__list {
    display: flex;
    align-items: stretch;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .aud__list::-webkit-scrollbar {
    display: none;
  }
  .aud__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  /* Thin rules between tabs; none next to the navy tab. */
  .aud__item + .aud__item::before {
    content: '';
    width: 1px;
    height: 20px;
    background: var(--line);
  }
  .aud__item.is-active::before,
  .aud__item.is-active + .aud__item::before {
    background: transparent;
  }
  .aud__tab {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--s-6);
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--blue);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--r-sm) var(--r-sm) 0 0;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .aud__tab:hover {
    background: var(--blue-50);
    color: var(--blue);
  }
  .aud__tab:focus-visible {
    outline-offset: -3px;
  }
  .aud__item.is-active .aud__tab {
    background: var(--blue-900);
    color: var(--white);
  }
  .aud__item.is-active .aud__tab:hover {
    background: var(--blue);
  }
  .aud__item.is-active .aud__tab:focus-visible {
    outline-color: var(--white);
  }
  @media (max-width: 899px) {
    .aud__tab {
      padding: 0 var(--s-4);
      font-size: var(--t-xs);
    }
  }
  /* Both bars stick, so in-page anchors stop below them. */
  :global(main section[id]),
  :global(main .content[id]) {
    scroll-margin-top: calc(var(--strip-h) + var(--header-h) + var(--s-4));
  }
</style>
