# CBZ Holdings — Strapi CMS environment (set these in Railway → Variables)
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://your-cms.up.railway.app

APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Exact origins, comma-separated; a single * wildcard per entry is allowed
CORS_ORIGINS=https://cbz.co.zw,https://www.cbz.co.zw,https://your-frontend.up.railway.app

DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
