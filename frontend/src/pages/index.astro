---
/**
 * Home: Hero, What can we help you with?, Life-stage journeys, Learn more.
 * A white split hero with the photograph bleeding right, a navy band that
 * fades to white under the benefit cards, the journey carousel, and the rail.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRail from '../components/ArticleRail.astro';
import Icon from '../components/Icon.astro';
import { OpenAccountMenu } from '../islands/OpenAccountMenu';
import { OPEN_ACCOUNT_ITEMS } from '../data/nav';
import { CONTACT, GROUP } from '../data/facts';
import { CLUSTERS } from '../data/group';
import { LIFE_STAGES } from '../data/lifeStages';
import type { IconName } from '../components/icons';

const clusterIcon: Record<string, IconName> = { banking: 'bank', investments: 'chart', insurance: 'shield', 'agro-business': 'leaf' };
const clusters = CLUSTERS.filter((c) => c.isOperating);

const articles = (await getCollection('notices'))
  .filter((n) => n.data.category !== 'security')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map((n) => ({
    id: n.id,
    title: n.data.title,
    summary: n.data.summary,
    date: n.data.date,
    category: n.data.category,
    reference: n.data.reference,
    href: `/notices/${n.id}`,
  }));
---

<BaseLayout
  title={GROUP.name}
  description="CBZ Holdings: banking, insurance, investments and agribusiness in one place. Open an account, apply for a loan, get a quote or start investing."
  preloadImage="/images/insurance-family.webp"
>
  <!-- 1. Hero: white split banner, copy left and a photograph bleeding right -->
  <header class="hero" aria-labelledby="hero-heading">
    <div class="hero__inner">
      <div class="hero__copy">
        <div class="hero__copy-in">
          <h1 id="hero-heading" class="hero__title">
            <strong>Bank, insure, invest</strong> and grow, in one place
          </h1>
          <p class="hero__lede">Accounts, cover, investments and finance for the season or the business, from one group that has partnered Zimbabweans since {GROUP.founded}.</p>
          <div class="hero__actions">
            <OpenAccountMenu client:idle items={OPEN_ACCOUNT_ITEMS} />
            <a href={CONTACT.whatsapp.chatHref} class="round" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp (opens in a new tab)">
              <Icon name="whatsapp" size={22} />
            </a>
            <a href="/contact" class="btn btn--secondary btn--lg">Talk to us</a>
          </div>
        </div>
      </div>
      <div class="hero__media">
        <img src="/images/insurance-family.webp" alt="A family together outdoors" width={1400} height={900} loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </header>

  <!-- 2. What can we help you with? -->
  <section class="top" aria-labelledby="help-heading">
    <div class="container help" id="help">
      <h2 id="help-heading" class="sr-only">What can we help you with?</h2>
      <a href="/login#apps" class="help__photo">
        <span class="help__photo-mark" aria-hidden="true"><Icon name="phoneMobile" size={40} /></span>
        <span class="help__photo-body">
          <span class="help__photo-title">Bank from your phone</span>
          <span class="help__photo-line">CBZ Touch, ZikiCash and internet banking <Icon name="arrowRight" size={16} /></span>
        </span>
      </a>
      <ul role="list" class="help__cards">
        {
          clusters.map((c, i) => (
            <li>
              <a href={c.route} class:list={['benefit', i % 2 === 1 && 'benefit--blue']}>
                <span class="benefit__shield" aria-hidden="true">
                  <Icon name={clusterIcon[c.id]} size={26} />
                </span>
                <span class="benefit__title">{c.taskLabel}</span>
                <span class="benefit__line">{c.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Life-stage journeys: a carousel of the moments we help with -->
  <section class="container stages" id="journeys" aria-labelledby="stages-heading" data-stages>
      <div class="stages__head">
        <div class="stages__intro">
          <p class="stages__eyebrow">Life stages</p>
          <h2 id="stages-heading" class="stages__title">Wherever you are in life, <strong>we have a next step</strong></h2>
        </div>
        <a href="/journeys" class="stages__all">All journeys <Icon name="arrowRight" size={18} /></a>
        <div class="stages__arrows">
          <button type="button" class="stages__arrow" data-prev aria-label="Previous">
            <Icon name="arrowRight" size={20} class="stages__flip" />
          </button>
          <button type="button" class="stages__arrow" data-next aria-label="Next">
            <Icon name="arrowRight" size={20} />
          </button>
        </div>
      </div>
      <ul role="list" class="stages__row" data-row>
        {
          LIFE_STAGES.map((s) => (
            <li class="stage">
              <a href={s.href} class="stage__link" data-track="apply_click" data-track-props={JSON.stringify({ unit: s.unit, from: 'home-stages' })}>
                <img src={s.image.src} alt="" width={600} height={800} loading="lazy" decoding="async" class="stage__img" />
                <span class="stage__shade" aria-hidden="true" />
                <span class="stage__tag">{s.tag}</span>
                <span class="stage__body">
                  <span class="stage__q">{s.question}</span>
                  <span class="stage__promise">{s.promise}</span>
                  <span class="stage__offers">
                    {s.offers.map((o) => (
                      <span class="stage__offer">{o}</span>
                    ))}
                  </span>
                  <span class="stage__cta">
                    Let's go <Icon name="arrowRight" size={18} />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="stages__foot" aria-hidden="true">
        <ol class="stages__dots" role="list">
          {LIFE_STAGES.map(() => <li class="stages__dot" />)}
        </ol>
        <p class="stages__count small muted"><span data-count>1</span> of {LIFE_STAGES.length}</p>
      </div>
  </section>

  <!-- 4. Learn more -->
  {
    articles.length > 0 && (
      <ArticleRail id="learn" heading="Learn more" headingStrong="Learn" articles={articles} seeAll={{ label: 'See all', href: '/notices' }} />
    )
  }
</BaseLayout>

<script>
  // Arrows step one card at a time; the dots follow the scroll position.
  document.querySelectorAll<HTMLElement>('[data-stages]').forEach((wrap) => {
    const row = wrap.querySelector<HTMLElement>('[data-row]');
    if (!row) return;
    const dots = Array.from(wrap.querySelectorAll<HTMLElement>('.stages__dot'));
    const step = () => (row.querySelector<HTMLElement>('.stage')?.offsetWidth ?? 280) + 16;
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    wrap.querySelector('[data-prev]')?.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: smooth }));
    wrap.querySelector('[data-next]')?.addEventListener('click', () => row.scrollBy({ left: step(), behavior: smooth }));
    const count = wrap.querySelector<HTMLElement>('[data-count]');
    const mark = () => {
      const i = Math.min(dots.length - 1, Math.max(0, Math.round(row.scrollLeft / step())));
      dots.forEach((d, k) => d.classList.toggle('stages__dot--on', k === i));
      if (count) count.textContent = String(i + 1);
    };
    row.addEventListener('scroll', mark, { passive: true });
    mark();
  });
</script>

<style>
  /* ---------- Hero: white split banner ---------- */
  .hero {
    background: var(--white);
  }
  .hero__inner {
    display: grid;
  }
  .hero__copy {
    display: flex;
    justify-content: flex-end;
  }
  .hero__copy-in {
    width: 100%;
    max-width: calc(var(--max) / 2);
    padding: var(--s-12) var(--gutter) var(--s-8);
    display: grid;
    gap: var(--s-5, 20px);
    justify-items: start;
    align-content: center;
  }
  .hero__title {
    font-size: var(--t-3xl);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.015em;
    max-width: 16ch;
  }
  .hero__title strong {
    font-weight: 700;
  }
  .hero__lede {
    color: var(--grey);
    font-size: var(--t-md);
    max-width: 44ch;
  }
  .hero__media {
    position: relative;
    min-height: 260px;
    background: var(--blue-50);
  }
  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: 560px;
    }
    .hero__copy-in {
      padding: var(--s-12) var(--s-10, 40px) var(--s-12) var(--gutter);
    }
    .hero__media {
      margin-block: var(--s-6) 0;
      box-shadow: 0 24px 40px -28px rgba(0, 23, 54, 0.5);
    }
    .hero__media img {
      aspect-ratio: auto;
      height: 100%;
    }
  }
  /* ---------- Help band: white ---------- */
  .top {
    position: relative;
    background: var(--white);
    padding-block: var(--s-10, 40px) var(--s-8);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue);
    transition:
      transform var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .round:hover {
    transform: scale(1.05);
    background: var(--blue-100);
    color: var(--blue);
  }

  /* Life-stage journeys: photo cards in a row that snaps as you scroll */
  .stages {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--band) 0;
  }
  .stages__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--s-4) var(--s-6);
  }
  .stages__intro {
    display: grid;
    gap: var(--s-2);
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .stages__head {
      grid-template-columns: 1fr auto auto;
    }
    .stages__intro {
      grid-column: auto;
    }
  }
  .stages__eyebrow {
    position: relative;
    padding-left: var(--s-8);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red-700);
  }
  .stages__eyebrow::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 20px;
    height: 2px;
    background: var(--red);
  }
  .stages__title {
    font-size: var(--t-2xl);
    font-weight: 400;
    color: var(--ink);
    max-width: 24ch;
    line-height: 1.15;
  }
  .stages__title strong {
    font-weight: 700;
    color: var(--blue);
  }
  .stages__all {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    font-weight: 700;
    color: var(--red-700);
    text-decoration: none;
  }
  .stages__all:hover {
    text-decoration: underline;
    color: var(--red-700);
  }
  .stages__arrows {
    display: none;
    gap: var(--s-2);
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .stages__arrows {
      display: flex;
    }
  }
  .stages__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    color: var(--red-700);
    border: 1px solid var(--line);
    transition: background-color var(--dur) var(--ease);
  }
  .stages__arrow:hover {
    background: var(--red-50);
  }
  .stages__arrow :global(.stages__flip) {
    transform: scaleX(-1);
  }
  .stages__row {
    display: flex;
    gap: var(--s-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    padding-bottom: var(--s-2);
  }
  .stages__row::-webkit-scrollbar {
    display: none;
  }
  .stage {
    flex: 0 0 min(78vw, 320px);
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .stage {
      flex-basis: calc((100% - var(--s-4)) / 2);
    }
  }
  @media (min-width: 900px) {
    .stage {
      flex-basis: calc((100% - 2 * var(--s-4)) / 3);
    }
  }
  .stage__link {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    background: var(--blue);
    isolation: isolate;
    box-shadow: 0 24px 48px -28px rgba(0, 23, 54, 0.55);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .stage__link:hover,
  .stage__link:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 32px 56px -28px rgba(0, 23, 54, 0.65);
    color: var(--white);
  }
  .stage__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform var(--dur-slow) var(--ease);
  }
  .stage__link:hover .stage__img {
    transform: scale(1.06);
  }
  .stage__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 23, 54, 0.96) 0%, rgba(0, 23, 54, 0.7) 38%, rgba(0, 23, 54, 0.1) 68%, rgba(0, 23, 54, 0) 100%);
  }
  .stage__tag {
    position: absolute;
    top: var(--s-4);
    left: var(--s-4);
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.92);
    color: var(--blue);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .stage__body {
    position: absolute;
    left: var(--s-5, 20px);
    right: var(--s-5, 20px);
    bottom: var(--s-5, 20px);
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
  .stage__q {
    font-size: var(--t-xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--white);
    letter-spacing: -0.01em;
  }
  .stage__promise {
    font-size: var(--t-md);
    color: rgba(255, 255, 255, 0.88);
  }
  .stage__offers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }
  .stage__offer {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.12);
    font-size: var(--t-xs);
    color: var(--white);
  }
  .stage__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    padding: 0 var(--s-5, 20px);
    margin-top: var(--s-2);
    border-radius: var(--r-pill);
    background: var(--red);
    color: var(--white);
    font-weight: 700;
    font-size: var(--t-sm);
    transition: background-color var(--dur) var(--ease);
  }
  .stage__link:hover .stage__cta {
    background: var(--red-700);
  }
  .stages__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .stages__count {
    font-variant-numeric: tabular-nums;
  }
  .stages__dots {
    display: flex;
    gap: var(--s-2);
  }
  .stages__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--line);
    transition:
      width var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .stages__dot--on {
    width: 28px;
    background: var(--red);
  }

  /* Help row: photo card + dark cards */
  .help {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .help {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
  .help__photo {
    position: relative;
    display: block;
    min-height: 240px;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    box-shadow: var(--shadow-float);
  }
  .help__photo {
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-900) 100%);
  }
  .help__photo-mark {
    position: absolute;
    top: var(--s-6);
    left: var(--s-6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }
  .help__photo-body {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6);
    background: linear-gradient(to top, rgba(0, 23, 54, 0.95), rgba(0, 23, 54, 0));
  }
  .help__photo-title {
    font-weight: 700;
    font-size: var(--t-lg);
  }
  .help__photo-line {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--t-sm);
    color: rgba(255, 255, 255, 0.85);
  }
  /* Benefit cards: alternating white and blue, with a shield badge rising above each card */
  .help__cards {
    display: grid;
    gap: var(--gap);
    padding-top: var(--s-10, 40px);
  }
  @media (min-width: 640px) {
    .help__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .help__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .benefit {
    position: relative;
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: center;
    text-align: center;
    height: 100%;
    padding: var(--s-12) var(--s-5, 20px) var(--s-8);
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    transition: transform var(--dur) var(--ease);
  }
  .benefit--blue {
    border-color: transparent;
  }
  .benefit:hover {
    transform: translateY(-3px);
    color: var(--ink);
  }
  .benefit--blue {
    background: var(--blue);
    color: var(--white);
  }
  .benefit--blue:hover {
    color: var(--white);
  }
  .benefit__shield {
    position: absolute;
    top: -34px;
    left: 50%;
    transform: translateX(-50%);
    width: 68px;
    height: 76px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 8px;
    color: var(--white);
    background: linear-gradient(to bottom, var(--blue-700), var(--blue));
    clip-path: polygon(0 0, 100% 0, 100% 62%, 50% 100%, 0 62%);
  }
  .benefit--blue .benefit__shield {
    background: linear-gradient(to bottom, var(--red), var(--red-700));
  }
  .benefit__title {
    font-size: var(--t-xl);
    font-weight: 400;
    color: var(--blue);
    margin-top: var(--s-2);
  }
  .benefit--blue .benefit__title {
    color: var(--white);
  }
  .benefit__line {
    font-size: var(--t-sm);
    color: var(--grey);
    max-width: 24ch;
  }
  .benefit--blue .benefit__line {
    color: rgba(255, 255, 255, 0.85);
  }

  /* About split */
  .about {
    display: grid;
    gap: var(--s-8);
    padding-top: var(--s-8);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-12);
      align-items: start;
    }
  }
  .about__media {
    display: grid;
    gap: var(--s-6);
  }
  .about__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .about__copy {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .about__title {
    font-size: var(--t-2xl);
    max-width: 18ch;
  }
  .about__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: start;
  }
  .about__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--red-50);
    color: var(--red);
  }
  .about__h3 {
    font-size: var(--t-md);
    margin-bottom: var(--s-1);
  }
  .about__banner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5, 20px);
    border-radius: var(--r-pill);
    background: var(--blue-900);
    color: var(--white);
    text-decoration: none;
  }
  .about__banner:hover {
    color: var(--white);
  }
  .about__banner-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--red);
  }
  .about__banner-text {
