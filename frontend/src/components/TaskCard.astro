---
/**
 * The white card that overlaps the bottom edge of a unit hero: a "Who we
 * serve" label over a short title, then one entry per audience with an icon
 * chip, a name, one line and a chevron, divided by hairlines.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Item {
  label: string;
  href: string;
  line?: string;
  icon?: IconName;
}
interface Props {
  heading: string;
  /** The short title under the heading, e.g. "Banking for everyone." */
  title: string;
  items: Item[];
}
const { heading, title, items } = Astro.props;
---

<div class="wrap">
  <div class="container">
    <nav class="card" aria-label={heading} style={`--n:${items.length}`}>
      <div class="card__intro">
        <h2 class="card__heading">{heading}</h2>
        <p class="card__title">{title}</p>
      </div>
      <ul role="list" class="card__list">
        {
          items.map((it) => (
            <li class="card__cell">
              <a href={it.href} class="card__item">
                <span class="card__icon" aria-hidden="true">
                  <Icon name={it.icon ?? 'user'} size={24} />
                </span>
                <span class="card__text">
                  <span class="card__label">{it.label}</span>
                  {it.line && <span class="card__line">{it.line}</span>}
                </span>
                <Icon name="chevronRight" size={18} class="card__chev" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<style>
  .wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--overlap, 56px));
  }
  .card {
    display: grid;
    gap: var(--s-4);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--s-5, 20px) var(--s-6);
    box-shadow: var(--shadow-card);
  }
  .card__intro {
    display: grid;
    gap: var(--s-1);
    align-content: center;
  }
  .card__heading {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--blue);
  }
  .card__heading::before {
    content: '';
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--red);
  }
  .card__title {
    font-size: var(--t-lg);
    font-weight: 700;
    color: var(--blue);
    line-height: 1.2;
    max-width: 12ch;
  }
  .card__list {
    display: grid;
  }
  .card__cell + .card__cell {
    border-top: 1px solid var(--line);
  }
  .card__item {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: var(--tap);
    padding: var(--s-3) 0;
    color: var(--blue);
    text-decoration: none;
    border-radius: var(--r-sm);
  }
  .card__item:hover {
    color: var(--blue);
  }
  .card__item:hover .card__label {
    text-decoration: underline;
  }
  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue);
    flex-shrink: 0;
  }
  .card__text {
    display: grid;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .card__label {
    font-weight: 700;
    font-size: var(--t-md);
    line-height: 1.25;
  }
  .card__line {
    color: var(--grey);
    font-size: var(--t-sm);
    line-height: 1.35;
  }
  .card :global(.card__chev) {
    flex-shrink: 0;
    color: var(--blue);
    transition: transform var(--dur) var(--ease);
  }
  .card__item:hover :global(.card__chev) {
    transform: translateX(3px);
  }
  @media (min-width: 900px) {
    .card {
      grid-template-columns: auto 1fr;
      gap: var(--s-6);
      padding: var(--s-4) var(--s-6);
    }
    .card__intro {
      padding-right: var(--s-6);
      border-right: 1px solid var(--line);
    }
    .card__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
    .card__cell + .card__cell {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
    .card__item {
      padding: var(--s-2) var(--s-5, 20px);
    }
    .card__cell:first-child .card__item {
      padding-left: 0;
    }
  }
</style>
