---
/**
 * Home, in the site map's order: Hero, What can we help you with?, Nine
 * businesses, Latest from CBZ, Branches & ATMs. The digital channels sit in
 * a blue feature panel between the task card and the businesses.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TaskCard from '../components/TaskCard.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import StoreBadges from '../components/StoreBadges.astro';
import BranchFinder from '../components/BranchFinder.astro';
import Icon from '../components/Icon.astro';
import { OpenAccountMenu } from '../islands/OpenAccountMenu';
import { OPEN_ACCOUNT_ITEMS } from '../data/nav';
import { LINKS } from '../data/links';
import { GROUP } from '../data/facts';
import { CLUSTERS } from '../data/group';
import { formatDate } from '../lib/format';
import type { IconName } from '../components/icons';
import type { DarkSafeLogoKey } from '../data/logos';

const clusterIcon: Record<string, IconName> = { banking: 'bank', investments: 'chart', insurance: 'shield', 'agro-business': 'leaf' };
const tasks = CLUSTERS.filter((c) => c.isOperating).map((c) => ({
  label: c.taskLabel,
  line: c.line,
  href: c.route,
  icon: clusterIcon[c.id],
}));

const units = (await getCollection('units', (u) => u.data.cluster !== 'philanthropy'))
  .map((u) => u.data)
  .sort((a, b) => a.order - b.order);

const latest = (await getCollection('notices'))
  .filter((n) => n.data.category !== 'security')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
---

<BaseLayout
  title={GROUP.name}
  description="CBZ Holdings: banking, insurance, investments and agribusiness in one place. Open an account, apply for a loan, get a quote or start investing."
  preloadImage="/images/cbz-payments.webp"
>
  <Hero
    variant="home"
    eyebrow="CBZ Holdings"
    title="Bank, insure, invest and grow, in one place"
    lede="Nine businesses, one group. Open an account, get a quote or start investing today."
    image={{ src: '/images/cbz-payments.webp', alt: 'A shop owner taking a card payment from a customer at the counter' }}
    secondary={{ label: 'Talk to us', href: '/contact' }}
    chip={{ icon: 'phoneMobile', title: 'CBZ Touch', line: 'Zero-rated mobile banking' }}
  >
    <OpenAccountMenu client:idle items={OPEN_ACCOUNT_ITEMS} slot="primary" />
  </Hero>

  <TaskCard heading="What can we help you with?" items={tasks} />

  <section class="container digital-band" aria-labelledby="digital-heading" id="digital-channels">
    <div class="panel on-dark">
      <div class="panel__copy">
        <h2 id="digital-heading" class="panel__title">Bank from your phone</h2>
        <p class="panel__lede">Pay, send and save without visiting a branch. Every channel runs on the official CBZ domains.</p>
        <StoreBadges app="cbz-touch" appStore={LINKS.touch.appStore} playStore={LINKS.touch.playStore} tone="dark" />
      </div>
      <ul role="list" class="chips">
        <li>
          <a href={LINKS.zikiCash.site ?? '/contact'} class="chip">
            <Logo brand="ziki-cash" on="light" height={26} decorative />
            <span class="chip__text">
              <span class="chip__title">ZikiCash</span>
              <span class="chip__line">{LINKS.zikiCash.site ? 'Send, pay and save' : 'Ask us how to start'}</span>
            </span>
            <Icon name="arrowRight" size={16} class="chip__icon" />
          </a>
        </li>
        <li>
          <a href="/login#apps" class="chip">
            <Logo brand="cbz-touch" on="light" height={30} decorative />
            <span class="chip__text">
              <span class="chip__title">CBZ Touch</span>
              <span class="chip__line">Transfers, bills, school fees</span>
            </span>
            <Icon name="arrowRight" size={16} class="chip__icon" />
          </a>
        </li>
        <li>
          <a href="/login" class="chip">
            <span class="chip__glyph"><Icon name="globe" size={22} /></span>
            <span class="chip__text">
              <span class="chip__title">Internet banking</span>
              <span class="chip__line">Personal and corporate</span>
            </span>
            <Icon name="arrowRight" size={16} class="chip__icon" />
          </a>
        </li>
        <li>
          <a href={LINKS.zikiMall} class="chip" target="_blank" rel="noopener noreferrer">
            <Logo brand="ziki-mall" on="light" height={22} decorative />
            <span class="chip__text">
              <span class="chip__title">Ziki Mall</span>
              <span class="chip__line">Shop online, pay with CBZ</span>
            </span>
            <Icon name="external" size={16} class="chip__icon" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <Section id="businesses" heading="Nine businesses" lede="One group behind every stage of life and business." align="center">
    <ul role="list" class="units">
      {
        units.map((u) => (
          <li>
            <a href={`/${u.slug}`} class="unit card-base">
              <span class="unit__logo">
                <Logo brand={u.logo as DarkSafeLogoKey} on="light" height={30} decorative />
              </span>
              <span class="unit__name">{u.name}</span>
              <span class="unit__line">{u.hero.lede}</span>
              <span class="unit__foot">
                <span class="unit__more">Visit {u.shortName}</span>
                <span class="icon-pill"><Icon name="arrowRight" size={16} /></span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    latest.length > 0 && (
      <Section id="latest" tone="tint" heading="Latest from CBZ" lede="Shareholder circulars, customer notices and announcements." align="center">
        <ul role="list" class="latest">
          {latest.map((n) => (
            <li>
              <a href={`/notices/${n.id}`} class="news card-base">
                <time datetime={n.data.date} class="news__date">
                  {formatDate(n.data.date)}
                </time>
                <span class="news__title">{n.data.title}</span>
                <span class="news__summary">{n.data.summary}</span>
                <span class="news__foot">
                  <span class="news__more">Read the notice</span>
                  <span class="icon-pill"><Icon name="arrowRight" size={16} /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="latest__all">
          <a href="/notices" class="btn btn--secondary">All notices</a>
        </p>
      </Section>
    )
  }

  <Section id="branches" heading="Branches and ATMs" lede="Search the map, or open it in your own maps app for directions.">
    <BranchFinder id="home-branches" />
  </Section>

  <Section id="trust" tone="dark" compact>
    <dl class="trust">
      <div>
        <dd class="trust__v">{GROUP.founded}</dd>
        <dt>Founded</dt>
      </div>
      <div>
        <dd class="trust__v">{GROUP.listing}</dd>
        <dt>{GROUP.listingLine}</dt>
      </div>
      <div>
        <dd class="trust__v">{GROUP.companies}</dd>
        <dt>In {GROUP.clusters.toLowerCase()}</dt>
      </div>
    </dl>
  </Section>
</BaseLayout>

<style>
  .digital-band {
    padding-block: var(--s-8) 0;
  }
  .panel {
    display: grid;
    gap: var(--s-8);
    padding: var(--s-8) var(--s-6);
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 55%),
      var(--blue);
    color: var(--white);
  }
  @media (min-width: 900px) {
    .panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      padding: var(--s-12);
    }
  }
  .panel__copy {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .panel__title {
    color: var(--white);
    font-size: var(--t-2xl);
  }
  .panel__lede {
    color: rgba(255, 255, 255, 0.82);
    max-width: 36ch;
  }
  .chips {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 640px) {
    .chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .chip {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: var(--s-3);
    min-height: 80px;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .chip:hover {
    color: var(--ink);
    transform: translateY(-2px);
    box-shadow: var(--shadow-float);
  }
  .chip > :global(.logo) {
    justify-self: center;
  }
  .chip__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: var(--blue-50);
    color: var(--blue);
    justify-self: center;
  }
  .chip__text {
    display: grid;
    gap: 1px;
  }
  .chip__title {
    font-weight: 700;
    color: var(--blue);
  }
  .chip__line {
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .chip__icon {
    color: var(--blue-700);
  }
  .units {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .units {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .units {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .unit {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-6);
    text-decoration: none;
    color: var(--ink);
  }
  .unit:hover {
    color: var(--ink);
  }
  .unit__logo {
    display: flex;
    align-items: center;
    height: 44px;
  }
  .unit__name {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
  }
  .unit__line {
    font-size: var(--t-sm);
    color: var(--grey);
  }
  .unit__foot,
  .news__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
  }
  .unit__more,
  .news__more {
    font-weight: 700;
    color: var(--blue-700);
  }
  .latest {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .latest {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .news {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-6);
    text-decoration: none;
    color: var(--ink);
  }
  .news:hover {
    color: var(--ink);
  }
  .news__date {
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .news__title {
    font-weight: 700;
    color: var(--blue);
    line-height: 1.3;
  }
  .news__summary {
    font-size: var(--t-sm);
    color: var(--grey);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .latest__all {
    display: flex;
    justify-content: center;
    margin-top: var(--s-8);
  }
  .trust {
    margin: 0;
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 640px) {
    .trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .trust div {
    display: grid;
    gap: var(--s-1);
  }
  .trust__v {
    margin: 0;
    font-size: var(--t-xl);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
  }
  .trust dt {
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.72);
  }
</style>
