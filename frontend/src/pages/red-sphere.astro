---
import { getEntry } from 'astro:content';
import UnitLayout from '../layouts/UnitLayout.astro';
import Section from '../components/Section.astro';
import SeasonalBanner from '../components/SeasonalBanner.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Tile from '../components/Tile.astro';
import ExternalLink from '../components/ExternalLink.astro';
import Logo from '../components/Logo.astro';
import { Calculator } from '../islands/Calculator';
import { CALCULATORS } from '../data/calculators';
import { LINKS } from '../data/links';
import { visible } from '../lib/visible';

const unit = (await getEntry('units', 'red-sphere'))!.data;
---

<UnitLayout unit={unit}>
  <Fragment slot="before-products">
    <Section id="season" compact>
      <SeasonalBanner />
    </Section>
  </Fragment>

  <Fragment slot="after-products">
    <Section id="app" heading="Apply from your phone" lede="The Red Sphere app takes you from application to payout.">
      <div class="app">
        <div class="app__card">
          <Logo brand="red-sphere" on="light" height={40} decorative />
          <p>Apply, upload your documents and track your loan in the Red Sphere app, or apply on the web portal.</p>
          <StoreBadges app="red-sphere" appStore={LINKS.redSphere.appStore} playStore={LINKS.redSphere.playStore} />
          <p>
            <ExternalLink href={LINKS.redSphere.portal}>Apply on the Red Sphere portal</ExternalLink>
          </p>
          {
            visible(LINKS.zse) && (
              <p class="small">
                <ExternalLink href={LINKS.zse!}>Zimbabwe Stock Exchange</ExternalLink>
              </p>
            )
          }
        </div>
        <Tile
          title="Farmer onboarding with Agro-Yield"
          line="Contract farming finance for the season, with inputs and offtake arranged."
          href="/agro-yield/apply"
          icon="leaf"
          track="apply_click"
          trackProps={{ unit: 'agro-yield', from: 'red-sphere' }}
        />
      </div>
    </Section>

    <Section id="calculator" tone="tint" heading="Loan calculator" lede="Estimate the monthly repayment on a Red Sphere loan over one to twenty-four months.">
      <Calculator client:visible variant="loan" config={CALCULATORS.loan} />
    </Section>

    <Section id="car-finance" heading="Car finance" lede="Estimate what a vehicle will cost each month.">
      <Calculator client:visible variant="carFinance" config={CALCULATORS.carFinance} />
    </Section>
  </Fragment>
</UnitLayout>

<style>
  .app {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .app {
      grid-template-columns: 7fr 5fr;
      align-items: start;
    }
  }
  .app__card {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
</style>
