---
/**
 * Property listings grid with the URL-synced filters island. Rendered inside
 * the "Property listing" branch of the CBZ Properties page.
 */
import { getCollection } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import { PropertyFilters } from '../islands/PropertyFilters';
import { visible } from '../lib/visible';

const listings = (await getCollection('properties')).map((p) => p.data).sort((a, b) => a.order - b.order);
const locations = [...new Set(listings.map((l) => l.location))].sort();
const statusLabel = { 'for-sale': 'For sale', 'to-let': 'To let', sold: 'Sold' } as const;
const typeLabel = { residential: 'Residential', commercial: 'Commercial', land: 'Land' } as const;
---

<div class="listings-wrap" id="listings">
  <PropertyFilters client:idle locations={locations} total={listings.length} />
  <ul role="list" class="listings">
    {
      listings.map((l) => (
        <li class="lst" data-property data-type={l.type} data-location={l.location} data-status={l.status}>
          <a href={`/properties/${l.id}`} class="lst__link card-base">
            <ResponsiveImage src={l.images[0].src} alt={l.images[0].alt || l.title} ratio="3:2" />
            <span class="lst__body">
              <span class="lst__meta small">
                {typeLabel[l.type]}, {l.location}, {statusLabel[l.status].toLowerCase()}
              </span>
              <span class="lst__title">{l.title}</span>
              <span class="lst__price">{visible(l.price) ? l.price : 'Price on application'}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {listings.length === 0 && <p class="muted">No listings yet. Ask us about current developments.</p>}
</div>

<style>
  .listings-wrap {
    display: grid;
    gap: var(--s-6);
  }
  .listings {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .listings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .listings {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .lst[hidden] {
    display: none;
  }
  .lst__link {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    height: 100%;
  }
  .lst__link:hover {
    color: var(--ink);
  }
  .lst__link :global(.frame) {
    border-radius: 0;
  }
  .lst__body {
    display: grid;
    gap: var(--s-1);
    padding: 0 var(--s-5, 20px) var(--s-5, 20px);
  }
  .lst__meta {
    color: var(--grey);
  }
  .lst__title {
    font-weight: 700;
    color: var(--blue);
    font-size: var(--t-md);
  }
  .lst__price {
    font-weight: 700;
    color: var(--blue-700);
    font-size: var(--t-sm);
  }
</style>
