---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { CLUSTERS, companiesIn, heldBy, VALUE_PROPOSITION, type ClusterId } from '../data/group';
import { AWARDS, GROUP, MILESTONES } from '../data/facts';
import { LINKS } from '../data/links';
import type { DarkSafeLogoKey } from '../data/logos';
---

<BaseLayout
  title="About CBZ Holdings"
  description="CBZ Holdings, founded in 1980 and listed on the Zimbabwe Stock Exchange, is ten operating companies in four clusters: banking, investments, insurance and agro-business."
>
  <Hero
    title="One group, ten companies"
    lede={`Founded in ${GROUP.founded} and ${GROUP.listingLine.toLowerCase()}, CBZ Holdings brings banking, investments, insurance and agribusiness under one roof.`}
    image={{ src: '/images/cbzpicture1.webp', alt: 'CBZ Holdings head office' }}
    logo="holdings"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    overlap={false}
  />

  <Section id="why" heading="Why one group" hideHeading>
    <ul role="list" class="why">
      {
        VALUE_PROPOSITION.map((v) => (
          <li class="why__item">
            <h3>{v.title}</h3>
            <p class="small">{v.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="structure" tone="tint" heading="How we are structured" lede="Four operating clusters, plus the CBZ Foundation held directly by the Group.">
    <div class="structure">
      {
        CLUSTERS.map((c) => (
          <section class="cluster" aria-labelledby={`cl-${c.id}`}>
            <h3 id={`cl-${c.id}`}>
              <a href={c.route}>{c.name}</a>
            </h3>
            <ul role="list" class="cluster__list">
              {companiesIn(c.id as ClusterId).map((co) => {
                const held = heldBy(co.id);
                return (
                  <li class="company">
                    {co.logo ? <Logo brand={co.logo as DarkSafeLogoKey} on="light" height={28} decorative /> : <span class="company__blank" aria-hidden="true" />}
                    <span class="company__text">
                      {co.route ? <a href={co.route}>{co.name}</a> : <span>{co.name}</span>}
                      {held.length > 0 && (
                        <span class="small muted">
                          holds {held.map((h) => `${h.name} (${h.ownership})`).join(', ')}
                        </span>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </Section>

  <Section id="milestones" heading="Milestones">
    <ol class="timeline" role="list">
      {
        MILESTONES.map((m) => (
          <li class="timeline__item">
            <span class="timeline__period">{m.period}</span>
            <span class="timeline__text">{m.text}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="awards" tone="tint" heading="Recognition">
    <ul role="list" class="awards">
      {
        AWARDS.map((a) => (
          <li class="award">
            <span class="award__title">{a.title}</span>
            <span class="small muted">
              {a.awarder}, {a.years.join(', ')}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="small ir">
      <ExternalLink href={LINKS.investorRelations}>Investor relations and annual reports</ExternalLink>
    </p>
  </Section>
</BaseLayout>

<style>
  .why {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .why {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .why {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .why__item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-6) 0;
    border-top: 2px solid var(--blue-100);
  }
  .structure {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .structure {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cluster {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .cluster h3 a {
    text-decoration: none;
    color: var(--blue);
  }
  .cluster h3 a:hover {
    text-decoration: underline;
  }
  .cluster__list {
    display: grid;
    gap: var(--s-3);
  }
  .company {
    display: flex;
    gap: var(--s-3);
    align-items: center;
  }
  .company__blank {
    width: 40px;
    height: 28px;
    flex-shrink: 0;
  }
  .company__text {
    display: grid;
    gap: 2px;
  }
  .company__text a {
    font-weight: 700;
    text-decoration: none;
  }
  .company__text a:hover {
    text-decoration: underline;
  }
  .timeline {
    display: grid;
    gap: var(--s-4);
    max-width: 720px;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .timeline__period {
    font-weight: 700;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .awards {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .awards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .award {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .award__title {
    font-weight: 700;
    color: var(--blue);
  }
  .ir {
    margin-top: var(--s-8);
  }
</style>
