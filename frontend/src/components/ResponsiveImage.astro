---
/**
 * Fixed-ratio image. Every image reserves its box so nothing shifts on load.
 * Pass an imported image (src/assets) to get AVIF/WebP and srcset from Astro's
 * pipeline; pass a /public path for assets that are already final-format.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Ratio = '16:9' | '4:5' | '4:3' | '3:2' | '1:1';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  ratio: Ratio;
  /** Mobile ratio, when it differs (heroes use 4:5 on phones). */
  mobileRatio?: Ratio;
  priority?: boolean;
  sizes?: string;
  widths?: number[];
  class?: string;
}

const {
  src,
  alt,
  ratio,
  mobileRatio,
  priority = false,
  sizes = '(min-width: 1200px) 1200px, 100vw',
  widths = [480, 768, 1024, 1440],
  class: className = '',
} = Astro.props;

const RATIOS: Record<Ratio, [number, number]> = {
  '16:9': [16, 9],
  '4:5': [4, 5],
  '4:3': [4, 3],
  '3:2': [3, 2],
  '1:1': [1, 1],
};
const [w, h] = RATIOS[ratio];
const [mw, mh] = RATIOS[mobileRatio ?? ratio];
const style = `--ratio:${w}/${h};--ratio-m:${mw}/${mh}`;
const isPublic = typeof src === 'string';
---

<div class={`frame ${className}`} style={style}>
  {
    isPublic ? (
      <img
        src={src as string}
        alt={alt}
        width={1200}
        height={Math.round((1200 * h) / w)}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        sizes={sizes}
      />
    ) : (
      <Picture
        src={src as ImageMetadata}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    )
  }
</div>

<style>
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio-m);
    overflow: hidden;
    background: var(--blue-100);
    border-radius: var(--r-md);
  }
  @media (min-width: 900px) {
    .frame {
      aspect-ratio: var(--ratio);
    }
  }
  .frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
