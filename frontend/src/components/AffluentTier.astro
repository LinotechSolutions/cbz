---
/**
 * One Affluent Banking tier (Private Banking, Prime Banking or Wealth
 * Management), laid out as the design brief: a full-bleed photograph hero
 * with the title over it; a row of four icon pillars ("Experience …");
 * "What you need to know", a panel with vertical tabs on the left and the
 * list for the chosen tab on the right; "What you can also get", cards with
 * a coloured left edge and a "Tell me more" link to each solution screen;
 * "Why clients choose CBZ" with the welcome letter; and "You may be
 * interested in", two navy photo cards to the other tiers.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import StickyCta from './StickyCta.astro';
import { TIERS, SOLUTIONS, ALSO_GET, AFFLUENT_HOME, solutionHref, tierHref, type Tier } from '../data/affluent';
import { CONTACT } from '../data/facts';

interface Props {
  tier: Tier;
}
const { tier } = Astro.props;
const others = TIERS.filter((t) => t.id !== tier.id);
const also = ALSO_GET.map((id) => SOLUTIONS.find((s) => s.id === id)!);
const EXPERIENCE: Record<Tier['id'], string> = {
  'private-banking': 'Experience exclusivity with Private Banking',
  'prime-banking': 'Experience priority with Prime Banking',
  'wealth-management': 'Experience expertise with Wealth Management',
};
const BANKER: Record<Tier['id'], string> = {
  'private-banking': 'Talk to a Private Banker',
  'prime-banking': 'Discover Prime Banking',
  'wealth-management': 'Start your wealth planning conversation',
};
const site = Astro.site ?? new URL('https://www.cbz.co.zw');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
      { '@type': 'ListItem', position: 2, name: AFFLUENT_HOME.title, item: new URL(AFFLUENT_HOME.path, site).toString() },
      { '@type': 'ListItem', position: 3, name: tier.name },
    ],
  },
];
---

<BaseLayout title={`${tier.name}: ${tier.title}`} description={tier.lede} unitLogo="bank" preloadImage={tier.image.src} jsonLd={jsonLd}>
  <!-- Hero: the photograph full bleed, the title over a navy wash -->
  <header class="hero on-dark" aria-labelledby="hero-heading">
    <img class="hero__img" src={tier.image.src} alt="" width={1000} height={1000} loading="eager" fetchpriority="high" decoding="async" />
    <span class="hero__arc" aria-hidden="true"></span>
    <div class="container hero__in">
      <Breadcrumbs tone="dark" items={[{ label: 'Home', href: '/' }, { label: AFFLUENT_HOME.title, href: AFFLUENT_HOME.path }, { label: tier.name }]} />
      <p class="hero__eyebrow"><span class="hero__tri" aria-hidden="true"></span>{tier.name}</p>
      <h1 id="hero-heading" class="hero__title">{tier.title}</h1>
      <p class="hero__lede">{tier.lede}</p>
      <div class="hero__actions">
        <a href="/bank/call-me-back" class="btn btn--primary btn--lg" data-track="apply_click" data-track-props={JSON.stringify({ unit: 'bank', from: tier.id })}>
          {BANKER[tier.id]} <Icon name="arrowRight" size={18} />
        </a>
        <a href={`mailto:${tier.email}`} class="btn btn--secondary btn--lg">
          <Icon name="mail" size={18} /> Email the team
        </a>
      </div>
    </div>
  </header>

  <!-- Experience …: four icon pillars -->
  <section class="band pillars" id="experience" aria-labelledby="experience-heading">
    <div class="container">
      <h2 id="experience-heading" class="sec__title">{EXPERIENCE[tier.id]}</h2>
      <ul role="list" class="pillars__grid">
        {
          tier.pillars.map((p) => (
            <li class="pillar">
              <Icon name={p.icon} size={40} class="pillar__ic" />
              <strong class="pillar__title">{p.title}</strong>
              <span class="pillar__body">{p.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What you need to know: vertical tabs on the left, the list on the right -->
  <section class="band know" id="know" aria-labelledby="know-heading">
    <div class="container">
      <h2 id="know-heading" class="sec__title">What you need to know</h2>
      <div class="know__panel" data-tabs>
        <div class="know__tabs" role="tablist" aria-label="What you need to know" aria-orientation="vertical">
          {
            tier.know.map((k, i) => (
              <button type="button" role="tab" id={`know-tab-${k.id}`} class="know__tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`know-panel-${k.id}`} tabindex={i === 0 ? 0 : -1} data-tab={k.id}>
                <span>{k.label}</span>
                <Icon name="play" size={16} class="know__tri" />
              </button>
            ))
          }
        </div>
        {
          tier.know.map((k, i) => (
            <div role="tabpanel" id={`know-panel-${k.id}`} class="know__body" aria-labelledby={`know-tab-${k.id}`} hidden={i !== 0} tabindex="0">
              <ul class="know__list">
                {k.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
              {k.note && <p class="know__note">{k.note}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What you can also get: cards with a coloured left edge -->
  <section class="band also" id="also" aria-labelledby="also-heading">
    <div class="container">
      <h2 id="also-heading" class="sec__title">What you can also get</h2>
      <ul role="list" class="also__grid">
        {
          also.map((s) => (
            <li class="also__card">
              <span class="also__edge" aria-hidden="true" />
              <h3 class="also__title">{s.name}</h3>
              <p class="also__line">{s.cardLine}</p>
              <a href={solutionHref(s.id)} class="also__more">Tell me more</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why clients choose CBZ, with the welcome letter -->
  <section class="band why" id="why" aria-labelledby="why-heading">
    <div class="container why__grid">
      <div class="why__panel on-dark">
        <h2 id="why-heading" class="why__title">Why clients choose CBZ</h2>
        <ol class="why__list">
          {
            tier.why.map((w) => (
              <li>
                <strong>{w.title}</strong>
                <span>{w.body}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="letter">
        <p class="letter__eyebrow">Welcome to CBZ {tier.name}</p>
        <p class="letter__dear">Dear Partner</p>
        {tier.letter.paragraphs.map((p) => <p class="letter__p">{p}</p>)}
        <p class="letter__p">Warm regards,</p>
        <p class="letter__sign">{tier.letter.signoff}</p>
        <ul role="list" class="letter__contact">
          <li>
            <Icon name="mail" size={18} /> <a href={`mailto:${tier.email}`}>{tier.email}</a>
          </li>
          <li>
            <Icon name="phone" size={18} /> <a href={CONTACT.contactCentre.href}>{CONTACT.contactCentre.display}</a>, toll free {CONTACT.tollFree.map((t) => t.display).join(' / ')}
          </li>
          <li>
            <Icon name="whatsapp" size={18} /> <a href={CONTACT.whatsapp.href} target="_blank" rel="noopener noreferrer">WhatsApp {CONTACT.whatsapp.display}<span class="sr-only"> (opens in a new tab)</span></a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- You may be interested in: the other two tiers -->
  <section class="band interested" id="interested" aria-labelledby="interested-heading">
    <div class="container">
      <h2 id="interested-heading" class="sec__title">You may be interested in</h2>
      <ul role="list" class="interested__grid">
        {
          others.map((t) => (
            <li class="int on-dark">
              <div class="int__copy">
                <h3 class="int__title">{t.name}</h3>
                <p class="int__line">{t.who}</p>
                <a href={tierHref(t.id)} class="btn btn--secondary int__btn">
                  Tell me more
                </a>
              </div>
              <img class="int__img" src={t.image.src} alt="" width={600} height={600} loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <StickyCta label={BANKER[tier.id]} href="/bank/call-me-back" unit="bank" />
</BaseLayout>

<script>
  // Tabs: a click or an arrow key chooses a tab; the matching panel shows. A hash naming a tab opens it.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((wrap) => {
    const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const show = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        show(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });
    const wanted = tabs.find((t) => t.dataset.tab && `#${t.dataset.tab}` === location.hash);
    if (wanted) show(wanted);
  });
</script>

<style>
  .sec__title {
    font-size: var(--t-2xl);
    color: var(--ink);
    margin-bottom: var(--s-8);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--blue-900);
    color: var(--white);
    overflow: hidden;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 30%;
    z-index: -2;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 23, 54, 0.92) 0%, rgba(0, 23, 54, 0.72) 45%, rgba(0, 23, 54, 0.35) 100%);
  }
  /* The brochure's red arc, curling in from the top right */
  .hero__arc {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 60vw;
    max-width: 760px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 14px solid var(--red);
    border-color: var(--red) var(--red) transparent transparent;
    transform: rotate(-20deg);
    opacity: 0.9;
    pointer-events: none;
  }
  .hero__in {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding-block: var(--s-8) var(--s-12);
    min-height: 420px;
    align-content: end;
  }
  @media (min-width: 900px) {
    .hero__in {
      min-height: 520px;
      padding-block: var(--s-8) var(--s-16);
    }
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
  }
  .hero__tri {
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid var(--red);
  }
  .hero__title {
    font-size: var(--t-3xl);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--white);
    max-width: 16ch;
  }
  .hero__lede {
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--t-md);
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .hero__actions .btn {
    gap: var(--s-2);
  }

  /* ---------- Pillars ---------- */
  .pillars__grid {
    display: grid;
    gap: var(--s-8) var(--gap);
  }
  @media (min-width: 640px) {
    .pillars__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .pillars__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .pillar {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .pillar :global(.pillar__ic) {
    color: var(--red);
  }
  .pillar__title {
    color: var(--ink);
    font-size: var(--t-md);
  }
  .pillar__body {
    color: var(--grey);
    line-height: 1.55;
  }

  /* ---------- What you need to know ---------- */
  .know__panel {
    display: grid;
    gap: var(--s-6);
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 900px) {
    .know__panel {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: var(--s-10, 40px);
      padding: var(--s-8);
    }
  }
  .know__tabs {
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .know__tabs::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 900px) {
    .know__tabs {
      flex-direction: column;
      overflow: visible;
      gap: var(--s-3);
    }
  }
  .know__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: var(--s-3) var(--s-6);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    font-size: var(--t-sm);
    white-space: nowrap;
    text-align: center;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .know__tab:hover {
    background: var(--blue-50);
  }
  .know__tab[aria-selected='true'] {
    background: var(--blue);
    color: var(--white);
    box-shadow: var(--shadow-card);
  }
  .know__tab :global(.know__tri) {
    display: none;
    position: absolute;
    right: -20px;
    color: var(--red);
    fill: currentColor;
  }
  @media (min-width: 900px) {
    .know__tab {
      width: 100%;
      white-space: normal;
    }
    .know__tab[aria-selected='true'] :global(.know__tri) {
      display: block;
    }
  }
  .know__body[hidden] {
    display: none;
  }
  .know__body {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding-top: var(--s-2);
  }
  .know__list {
    display: grid;
    gap: var(--s-3);
    padding-left: 1.2em;
    max-width: var(--measure);
    line-height: 1.55;
  }
  .know__note {
    color: var(--grey);
    font-size: var(--t-sm);
  }

  /* ---------- What you can also get ---------- */
  .also__grid {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .also__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .also__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .also__card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-6) var(--s-6) calc(var(--s-6) + 8px);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--white);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .also__edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8px;
    background: linear-gradient(180deg, var(--red), var(--blue));
  }
  .also__title {
    font-size: var(--t-xl);
    color: var(--ink);
  }
  .also__line {
    color: var(--grey);
    line-height: 1.55;
  }
  .also__more {
    justify-self: start;
    font-weight: 700;
    color: var(--red-700);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .also__more:hover {
    color: var(--red);
  }

  /* ---------- Why clients choose CBZ, and the letter ---------- */
  .why__grid {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 900px) {
    .why__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--s-12);
      align-items: start;
    }
  }
  .why__panel {
    position: relative;
    overflow: hidden;
    padding: var(--s-8);
    border-radius: var(--r-lg);
    background: radial-gradient(circle at 85% 20%, rgba(255, 255, 255, 0.08), transparent 40%), var(--blue-900);
    color: var(--white);
  }
  .why__title {
    color: var(--white);
    font-size: var(--t-xl);
    margin-bottom: var(--s-6);
  }
  .why__list {
    display: grid;
    gap: var(--s-5, 20px);
    padding-left: 1.4em;
    counter-reset: why;
  }
  .why__list li {
    display: grid;
    gap: 2px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
  }
  .why__list li strong {
    color: var(--white);
  }
  .letter {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .letter__eyebrow {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red-700);
  }
  .letter__dear,
  .letter__sign {
    font-weight: 700;
    color: var(--blue);
  }
  .letter__p {
    color: var(--ink);
    line-height: 1.6;
  }
  .letter__contact {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
  }
  .letter__contact li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
  }
  .letter__contact :global(svg) {
    color: var(--red);
    flex-shrink: 0;
  }

  /* ---------- You may be interested in ---------- */
  .interested__grid {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .interested__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .int {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    min-height: 260px;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: linear-gradient(135deg, var(--blue-900), var(--blue) 70%, var(--blue-700));
    color: var(--white);
  }
  .int__copy {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
    padding: var(--s-6);
  }
  .int__title {
    color: var(--white);
    font-size: var(--t-xl);
  }
  .int__line {
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.5;
  }
  .int__btn {
    margin-top: var(--s-2);
  }
  .int__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    mask-image: linear-gradient(to right, transparent, #000 35%);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 35%);
  }
</style>
