---
/**
 * Products as cards: filter tabs with a blue underline, then a card per
 * product with its name over a short rule, a summary, up to four big facts,
 * and two buttons. "Tell me more" opens a panel with pill tabs: What you
 * get, Who it's for, What it costs, How to get it. Without JavaScript every
 * card shows and every panel is open.
 */
import Button from './Button.astro';
import { visible } from '../lib/visible';

export interface ProductRow {
  productId: string;
  category: string;
  name: string;
  summary: string;
  benefits: string[];
  eligibility: string[] | null;
  audience: string | null;
  pricing: string | null;
  details?: { tenor: string | null; interestRate: string | null; adminFee: string | null; limit: string | null };
  apply: { label: string; href: string };
}

interface Props {
  unitSlug: string;
  categories: readonly { id: string; label: string }[];
  products: ProductRow[];
  primaryCta: { label: string; href: string };
  note?: string | null;
  idPrefix?: string;
  hideCta?: boolean;
}
const { unitSlug, categories, products, note, idPrefix = unitSlug } = Astro.props;

const cats = categories.filter((c) => products.some((p) => p.category === c.id));
const showFilters = cats.length > 1;

const factLabels: Record<string, string> = {
  interestRate: 'Interest',
  tenor: 'Term',
  adminFee: 'Admin fee',
  limit: 'Maximum',
};
function factsFor(p: ProductRow) {
  const facts: { value: string; label: string }[] = [];
  for (const [k, label] of Object.entries(factLabels)) {
    const v = p.details?.[k as keyof NonNullable<ProductRow['details']>];
    if (visible(v)) facts.push({ value: v!, label });
  }
  return facts.slice(0, 4);
}
/** Long lists open on the first category so the page stays short; "All" is a tap away. */
const startFilter = products.length > 6 && cats.length > 1 ? cats[0].id : 'all';
const costLine = (p: ProductRow) =>
  visible(p.pricing) ? p.pricing! : 'Pricing is confirmed on application. Ask us for current terms before you rely on anything here.';
---

<div class="pc" data-product-cards data-unit={unitSlug} data-start={startFilter}>
  {
    showFilters && (
      <div class="pc__filters" role="tablist" aria-label="Filter products">
        <button type="button" role="tab" class="pc__filter" aria-selected={startFilter === 'all' ? 'true' : 'false'} data-filter="all">
          All
        </button>
        {cats.map((c) => (
          <button type="button" role="tab" class="pc__filter" aria-selected={startFilter === c.id ? 'true' : 'false'} data-filter={c.id} id={`panel-${idPrefix}-${c.id}`}>
            {c.label}
          </button>
        ))}
      </div>
    )
  }

  <ul role="list" class="pc__grid">
    {
      products.map((p) => {
        const facts = factsFor(p);
        const did = `detail-${idPrefix}-${p.productId}`;
        return (
          <li class="pcard" id={`product-${unitSlug}-${p.productId}`} data-category={p.category}>
            <div class="pcard__body">
              <h3 class="pcard__title">{p.name}</h3>
              <span class="pcard__rule" aria-hidden="true" />
              <p class="pcard__summary">{p.summary}</p>
              {visible(p.pricing) && <p class="pcard__pricing">{p.pricing}</p>}
              {facts.length > 0 && (
                <dl class="pcard__facts">
                  {facts.map((f) => (
                    <div class="fact">
                      <dd class="fact__value">{f.value}</dd>
                      <dt class="fact__label">{f.label}</dt>
                    </div>
                  ))}
                </dl>
              )}
              <div class="pcard__actions">
                <Button href={p.apply.href} variant="primary" track="apply_click" trackProps={{ unit: unitSlug, product: p.productId }}>
                  {p.apply.label}
                </Button>
                <button type="button" class="btn btn--secondary pcard__more" aria-expanded="false" aria-controls={did} data-more>
                  Tell me more
                </button>
              </div>
            </div>

            <div class="pdetail" id={did} data-detail>
              <div class="pdetail__tabs" role="tablist" aria-label={`${p.name} details`}>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="true" data-tab="get">What you get</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="who">Who it's for</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="cost">What it costs</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="how">How to get it</button>
              </div>
              <div class="pdetail__panels">
                <section class="pdetail__panel" data-panel="get" role="tabpanel">
                  <h4 class="pdetail__h">What you get</h4>
                  {visible(p.benefits) ? (
                    <ul class="tri">
                      {p.benefits.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="muted">{p.summary}</p>
                  )}
                </section>
                <section class="pdetail__panel" data-panel="who" role="tabpanel">
                  <h4 class="pdetail__h">Who it's for</h4>
                  {visible(p.audience) ? <p>{p.audience}</p> : <p class="muted">Ask us whether this product fits you.</p>}
                </section>
                <section class="pdetail__panel" data-panel="cost" role="tabpanel">
                  <h4 class="pdetail__h">What it costs</h4>
                  <p>{costLine(p)}</p>
                  {facts.length > 0 && (
                    <ul class="tri">
                      {facts.map((f) => (
                        <li>
                          {f.label}: {f.value}
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
                <section class="pdetail__panel" data-panel="how" role="tabpanel">
                  <h4 class="pdetail__h">How to get it</h4>
                  {visible(p.eligibility) && (
                    <>
                      <p class="small muted">You will need</p>
                      <ul class="tri">
                        {p.eligibility!.map((e) => (
                          <li>{e}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  <p>
                    <Button href={p.apply.href} variant="primary" track="apply_click" trackProps={{ unit: unitSlug, product: p.productId, from: 'detail' }}>
                      {p.apply.label}
                    </Button>
                  </p>
                </section>
                {visible(note) && <p class="pdetail__note small muted">{note}</p>}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-cards]').forEach((root) => {
    root.classList.add('pc--js');

    // Filter tabs
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.pcard'));
    function filter(id: string) {
      filters.forEach((f) => {
        const on = f.dataset.filter === id;
        f.setAttribute('aria-selected', on ? 'true' : 'false');
        f.tabIndex = on ? 0 : -1;
      });
      cards.forEach((c) => {
        c.hidden = id !== 'all' && c.dataset.category !== id;
      });
    }
    if (filters.length) filter(root.dataset.start || 'all');
    filters.forEach((f, i) => {
      f.addEventListener('click', () => filter(f.dataset.filter!));
      f.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight') n = (i + 1) % filters.length;
        if (e.key === 'ArrowLeft') n = (i - 1 + filters.length) % filters.length;
        if (n >= 0) {
          e.preventDefault();
          filters[n].focus();
          filter(filters[n].dataset.filter!);
        }
      });
    });

    // Tell me more + detail tabs
    cards.forEach((card) => {
      const more = card.querySelector<HTMLButtonElement>('[data-more]');
      const detail = card.querySelector<HTMLElement>('[data-detail]');
      if (!more || !detail) return;
      detail.hidden = true;
      more.addEventListener('click', () => {
        const open = detail.hidden;
        detail.hidden = !open;
        more.setAttribute('aria-expanded', open ? 'true' : 'false');
        more.textContent = open ? 'Show less' : 'Tell me more';
        if (open) detail.querySelector<HTMLElement>('[role="tab"]')?.focus();
      });
      const tabs = Array.from(detail.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const panels = Array.from(detail.querySelectorAll<HTMLElement>('[data-panel]'));
      function select(id: string, focus = false) {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
        });
      }
      select('get');
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.tab!));
        t.addEventListener('keydown', (e) => {
          let n = -1;
          if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          if (n >= 0) {
            e.preventDefault();
            select(tabs[n].dataset.tab!, true);
          }
        });
      });
    });

    // Deep links: #product-<unit>-<id> opens that card's detail.
    function openHash() {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const card = root.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
      if (!card) return;
      filter('all');
      const more = card.querySelector<HTMLButtonElement>('[data-more]');
      if (more && more.getAttribute('aria-expanded') !== 'true') more.click();
      card.scrollIntoView({ block: 'start' });
    }
    window.addEventListener('hashchange', openHash);
    openHash();
  });
</script>

<style>
  .pc {
    display: grid;
    gap: var(--s-6);
  }
  .pc__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    border-bottom: 1px solid var(--line);
  }
  .pc__filter {
    position: relative;
    min-height: var(--tap);
    padding: 0 var(--s-1);
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--grey);
    letter-spacing: 0.01em;
    transition: color var(--dur) var(--ease);
  }
  .pc__filter:hover,
  .pc__filter[aria-selected='true'] {
    color: var(--blue);
  }
  .pc__filter[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--blue);
  }
  .pc__grid {
    display: grid;
    gap: var(--gap);
  }
  /* Three across on laptops, four on wide screens; two on tablets. */
  @media (min-width: 640px) {
    .pc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .pc__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .pc__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .pcard {
    display: grid;
    align-content: start;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .pcard[hidden] {
    display: none;
  }
  .pcard__body {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-5, 20px);
  }
  .pcard__title {
    font-size: var(--t-lg);
    font-weight: 400;
    color: var(--blue);
  }
  .pcard__rule {
    display: block;
    width: 56px;
    height: 3px;
    background: var(--red);
    margin-top: calc(-1 * var(--s-2));
  }
  .pcard__summary {
    color: var(--ink);
    max-width: 60ch;
  }
  .pcard__pricing {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--blue-700);
  }
  .pcard__facts {
    margin: var(--s-2) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-4);
  }
  .fact {
    display: grid;
    gap: var(--s-1);
  }
  .fact__value {
    margin: 0;
    font-size: var(--t-xl);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .fact__label {
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .pcard__actions {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }
  .pcard__actions :global(.btn) {
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--t-xs);
  }

  /* Detail panel: pill tabs over a grey body */
  .pdetail {
    padding: 0 var(--s-4) var(--s-4);
  }
  .pdetail[hidden] {
    display: none;
  }
  .pdetail__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }
  .pc:not(.pc--js) .pdetail__tabs {
    display: none;
  }
  .pdetail__tab {
    min-height: var(--tap);
    padding: 0 var(--s-5, 20px);
    border-radius: var(--r-md) var(--r-md) 0 0;
    background: var(--line);
    color: var(--blue);
    font-weight: 700;
    font-size: var(--t-sm);
    transition: background-color var(--dur) var(--ease);
  }
  .pdetail__tab[aria-selected='true'] {
    background: var(--surface);
  }
  .pdetail__panels {
    background: var(--surface);
    border-radius: 0 var(--r-md) var(--r-md) var(--r-md);
    padding: var(--s-6);
    display: grid;
    gap: var(--s-6);
  }
  .pdetail__panel {
    display: grid;
    gap: var(--s-3);
  }
  .pdetail__panel[hidden] {
    display: none;
  }
  .pdetail__h {
    font-size: var(--t-sm);
    color: var(--grey);
    font-weight: 400;
  }
  .pc--js .pdetail__h {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .tri {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .tri li {
    position: relative;
    padding-left: var(--s-8);
  }
  .tri li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 10px solid var(--red);
  }
  .pdetail__note {
    max-width: var(--measure);
    padding-top: var(--s-2);
    border-top: 1px solid var(--line);
  }
</style>
