---
/**
 * The hero: a rounded panel with the photograph full-bleed behind a navy
 * gradient, the copy on the left, and a frosted glass chip on the photo that
 * carries one fact. On phones the gradient rises from the bottom.
 */
import Logo from './Logo.astro';
import Button from './Button.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import type { DarkSafeLogoKey } from '../data/logos';
import type { IconName } from './icons';

interface Cta {
  label: string;
  href: string;
  track?: string;
  trackProps?: Record<string, string | number | boolean>;
}
interface Props {
  title: string;
  lede: string;
  image: { src: string; alt: string };
  logo?: DarkSafeLogoKey;
  eyebrow?: string;
  crumbs?: { label: string; href?: string }[];
  primary?: Cta;
  secondary?: Cta;
  /** One fact shown on a frosted chip over the photo. */
  chip?: { icon?: IconName; title: string; line?: string };
  /** 'split' is the white-left, photo-right banner; 'unit' and 'home' are the navy panel. */
  variant?: 'unit' | 'home' | 'split';
  overlap?: boolean;
}
const { title, lede, image, logo, eyebrow, crumbs, primary, secondary, chip, variant = 'unit', overlap = true } = Astro.props;
---

{
  variant === 'split' ? (
    <header class:list={['split', overlap && 'split--overlap']}>
      <div class="split__inner">
        <div class="split__copy">
          <div class="split__copy-in">
            {crumbs && <Breadcrumbs items={crumbs} />}
            {eyebrow ? <p class="split__eyebrow">{eyebrow}</p> : logo && <Logo brand={logo} on="light" height={30} class="split__logo" />}
            <h1 class="split__title">{title}</h1>
            <p class="split__lede">{lede}</p>
            {(primary || secondary) && (
              <div class="split__actions">
                {primary && (
                  <Button href={primary.href} variant="primary" size="lg" track={primary.track} trackProps={primary.trackProps}>
                    {primary.label} <Icon name="arrowRight" size={18} />
                  </Button>
                )}
                {secondary && (
                  <Button href={secondary.href} variant="secondary" size="lg" track={secondary.track} trackProps={secondary.trackProps}>
                    {secondary.label} <Icon name="arrowRight" size={18} />
                  </Button>
                )}
              </div>
            )}
            <span class="split__marks" aria-hidden="true">
              <i />
              <i class="is-on" />
              <i />
            </span>
          </div>
        </div>
        <div class="split__media">
          <img src={image.src} alt={image.alt} width={1400} height={900} loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </header>
  ) : (
<header class:list={['hero-wrap', overlap && 'hero-wrap--overlap']}>
  <div class="container">
    <div class:list={['hero', `hero--${variant}`, 'on-dark']}>
      <img
        class="hero__img"
        src={image.src}
        alt={image.alt}
        width={1400}
        height={900}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        sizes="(min-width: 1200px) 1200px, 100vw"
      />
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="hero__inner">
        <div class="hero__copy">
          {crumbs && <Breadcrumbs items={crumbs} tone="dark" />}
          {logo && <Logo brand={logo} on="dark" height={30} class="hero__logo" />}
          {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
          <h1 class:list={['hero__title', variant === 'home' && 'display']}>{title}</h1>
          <p class="hero__lede">{lede}</p>
          {
            (primary || secondary || Astro.slots.has('primary')) && (
              <div class="hero__actions">
                <slot name="primary">
                  {primary && (
                    <Button href={primary.href} variant="primary" size="lg" track={primary.track} trackProps={primary.trackProps}>
                      {primary.label}
                    </Button>
                  )}
                </slot>
                {secondary && (
                  <Button href={secondary.href} variant="secondary" size="lg" track={secondary.track} trackProps={secondary.trackProps}>
                    {secondary.label}
                  </Button>
                )}
              </div>
            )
          }
        </div>

        {
          chip && (
            <div class="hero__chip" aria-hidden="true">
              <span class="hero__chip-icon">
                <Icon name={chip.icon ?? 'check'} size={18} />
              </span>
              <span class="hero__chip-text">
                <span class="hero__chip-title">{chip.title}</span>
                {chip.line && <span class="hero__chip-line">{chip.line}</span>}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</header>
  )
}

<style>
  /* Split banner: white copy on the left, the photograph bleeding to the right edge */
  .split {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .split--overlap {
    padding-bottom: var(--overlap, 56px);
  }
  .split__inner {
    display: grid;
  }
  .split__copy {
    display: flex;
    justify-content: flex-end;
  }
  .split__copy-in {
    width: 100%;
    max-width: calc(var(--max) / 2);
    padding: var(--s-10, 40px) var(--gutter) var(--s-8);
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    align-content: center;
  }
  .split__logo {
    margin-left: calc(-1 * var(--s-1));
  }
  /* Unit name as a small-caps eyebrow after a short red dash */
  .split__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .split__eyebrow::before {
    content: '';
    width: 40px;
    height: 3px;
    border-radius: 2px;
    background: var(--red);
  }
  .split__title {
    font-size: var(--t-3xl);
    font-weight: 700;
    color: var(--blue);
    letter-spacing: -0.015em;
    line-height: 1.1;
    max-width: 14ch;
  }
  .split__lede {
    color: var(--grey);
    font-size: var(--t-md);
    max-width: 44ch;
  }
  .split__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .split__actions :global(.btn) {
    gap: var(--s-2);
    min-width: 200px;
  }
  .split__actions :global(.btn--secondary) {
    border-color: var(--blue);
    color: var(--blue);
  }
  .split__marks {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }
  .split__marks i {
    width: 28px;
    height: 3px;
    background: var(--line);
    border-radius: 2px;
  }
  .split__marks i.is-on {
    background: var(--blue-700);
  }
  /* The photograph is supplied already composed: white on the left, the
     subject in a circle on the right with a red arc. Anchor it to the right
     so the circle always stays in view and the white meets the copy. */
  .split__media {
    min-height: 260px;
    background: var(--white);
  }
  .split__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 900px) {
    .split__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: 520px;
    }
    /* Keep the copy short enough that the photo is never taller than about
       half its width, which is what keeps the whole circle in view. */
    .split__copy-in {
      padding: var(--s-8) var(--s-8) var(--s-8) var(--gutter);
    }
    .split__title {
      font-size: var(--t-2xl);
    }
    .split__media {
      min-height: 520px;
    }
    .split__media img {
      aspect-ratio: auto;
      height: 100%;
    }
  }
  @media (min-width: 1200px) {
    .split__copy-in {
      padding: var(--s-12) var(--s-8) var(--s-12) var(--gutter);
    }
    .split__title {
      font-size: var(--t-3xl);
    }
  }

  .hero-wrap {
    padding-top: var(--s-4);
  }
  .hero-wrap--overlap {
    padding-bottom: var(--overlap, 56px);
  }
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--blue-900);
    color: var(--white);
    min-height: 560px;
    display: grid;
    isolation: isolate;
  }
  .hero--home {
    min-height: 640px;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
    z-index: -2;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(0, 23, 54, 0.96) 0%, rgba(0, 23, 54, 0.72) 45%, rgba(0, 23, 54, 0.15) 100%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--s-6);
    padding: var(--s-8) var(--s-6);
  }
  .hero__copy {
    display: grid;
    gap: var(--s-4);
    max-width: 38rem;
  }
  .hero__logo {
    margin-left: calc(-1 * var(--s-1));
  }
  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--t-sm);
    padding-top: var(--s-3);
    position: relative;
  }
  .hero__eyebrow::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--red);
  }
  .hero--unit .hero__eyebrow::before {
    background: var(--blue-100);
  }
  .hero__title {
    color: var(--white);
    text-shadow: 0 1px 2px rgba(0, 23, 54, 0.3);
  }
  .hero__lede {
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--t-lg);
    line-height: 1.4;
    max-width: 32rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    justify-self: start;
    padding: var(--s-3) var(--s-4) var(--s-3) var(--s-3);
    border-radius: var(--r-md);
    background: var(--glass-bg);
    border: 1px solid var(--glass-line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px -12px rgba(0, 23, 54, 0.5);
  }
  .hero__chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue);
    flex-shrink: 0;
  }
  .hero__chip-text {
    display: grid;
    gap: 1px;
  }
  .hero__chip-title {
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--white);
  }
  .hero__chip-line {
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.8);
  }

  @media (min-width: 900px) {
    .hero__shade {
      background:
        linear-gradient(to right, rgba(0, 23, 54, 0.94) 0%, rgba(0, 23, 54, 0.78) 38%, rgba(0, 23, 54, 0.25) 70%, rgba(0, 23, 54, 0.1) 100%);
    }
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      align-content: stretch;
      padding: var(--s-12) var(--s-12);
      min-height: inherit;
    }
    .hero__copy {
      align-self: center;
      padding-right: var(--s-8);
    }
    .hero__chip {
      justify-self: end;
      align-self: end;
    }
  }
  @media (max-width: 639px) {
    .hero-wrap {
      padding-top: 0;
    }
    .hero {
      border-radius: 0 0 var(--r-lg) var(--r-lg);
      min-height: 520px;
    }
    .hero__inner {
      padding: var(--s-6) var(--gutter) var(--s-8);
    }
  }
</style>
