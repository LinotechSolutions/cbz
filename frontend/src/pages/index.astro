---
/**
 * Home: Hero, What can we help you with?, Life-stage journeys, Learn more.
 * A navy top that fades to white, benefit cards with shield badges, the
 * journey carousel, and the article rail.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRail from '../components/ArticleRail.astro';
import Icon from '../components/Icon.astro';
import { OpenAccountMenu } from '../islands/OpenAccountMenu';
import { OPEN_ACCOUNT_ITEMS } from '../data/nav';
import { CONTACT, GROUP } from '../data/facts';
import { CLUSTERS } from '../data/group';
import { LIFE_STAGES } from '../data/lifeStages';
import type { IconName } from '../components/icons';

const clusterIcon: Record<string, IconName> = { banking: 'bank', investments: 'chart', insurance: 'shield', 'agro-business': 'leaf' };
const clusters = CLUSTERS.filter((c) => c.isOperating);

const articles = (await getCollection('notices'))
  .filter((n) => n.data.category !== 'security')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map((n) => ({
    id: n.id,
    title: n.data.title,
    summary: n.data.summary,
    date: n.data.date,
    category: n.data.category,
    reference: n.data.reference,
    href: `/notices/${n.id}`,
  }));
---

<BaseLayout
  title={GROUP.name}
  description="CBZ Holdings: banking, insurance, investments and agribusiness in one place. Open an account, apply for a loan, get a quote or start investing."
>
  <!-- 1. Hero: navy top fading to white -->
  <section class="top on-dark" aria-labelledby="hero-heading">
    <div class="container hero">
      <div class="hero__copy">
        <h1 id="hero-heading" class="hero__title display">Bank, insure, invest and grow, in one place</h1>
        <div class="hero__actions">
          <OpenAccountMenu client:idle items={OPEN_ACCOUNT_ITEMS} />
          <a href={CONTACT.whatsapp.chatHref} class="round" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp (opens in a new tab)">
            <Icon name="whatsapp" size={22} />
          </a>
          <a href="/contact" class="btn btn--secondary btn--lg">Talk to us</a>
        </div>
      </div>

    </div>

    <!-- 2. What can we help you with? -->
    <div class="container help" id="help">
      <h2 class="sr-only">What can we help you with?</h2>
      <a href="/login#apps" class="help__photo">
        <span class="help__photo-mark" aria-hidden="true"><Icon name="phoneMobile" size={40} /></span>
        <span class="help__photo-body">
          <span class="help__photo-title">Bank from your phone</span>
          <span class="help__photo-line">CBZ Touch, ZikiCash and internet banking <Icon name="arrowRight" size={16} /></span>
        </span>
      </a>
      <ul role="list" class="help__cards">
        {
          clusters.map((c, i) => (
            <li>
              <a href={c.route} class:list={['benefit', i % 2 === 1 && 'benefit--blue']}>
                <span class="benefit__shield" aria-hidden="true">
                  <Icon name={clusterIcon[c.id]} size={26} />
                </span>
                <span class="benefit__title">{c.taskLabel}</span>
                <span class="benefit__line">{c.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Life-stage journeys: a carousel of the moments we help with -->
  <section class="container stages" id="journeys" aria-labelledby="stages-heading" data-stages>
      <div class="stages__head">
        <h2 id="stages-heading" class="stages__title">Wherever you are in life, <strong>we have a next step</strong></h2>
        <div class="stages__arrows">
          <button type="button" class="stages__arrow" data-prev aria-label="Previous">
            <Icon name="arrowRight" size={20} class="stages__flip" />
          </button>
          <button type="button" class="stages__arrow" data-next aria-label="Next">
            <Icon name="arrowRight" size={20} />
          </button>
        </div>
      </div>
      <ul role="list" class="stages__row" data-row>
        {
          LIFE_STAGES.map((s) => (
            <li class="stage">
              <a href={s.href} class="stage__link" data-track="apply_click" data-track-props={JSON.stringify({ unit: s.unit, from: 'home-stages' })}>
                <img src={s.image.src} alt="" width={600} height={750} loading="lazy" decoding="async" class="stage__img" />
                <span class="stage__shade" aria-hidden="true" />
                <span class="stage__body">
                  <span class="stage__q">{s.question}</span>
                  <span class="stage__promise">{s.promise}</span>
                </span>
                <span class="stage__go" aria-hidden="true">
                  <Icon name="arrowRight" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <ol class="stages__dots" role="list" aria-hidden="true">
        {LIFE_STAGES.map(() => <li class="stages__dot" />)}
      </ol>
  </section>

  <!-- 4. Learn more -->
  {
    articles.length > 0 && (
      <ArticleRail id="learn" heading="Learn more" headingStrong="Learn" articles={articles} seeAll={{ label: 'See all', href: '/notices' }} />
    )
  }
</BaseLayout>

<script>
  // Arrows step one card at a time; the dots follow the scroll position.
  document.querySelectorAll<HTMLElement>('[data-stages]').forEach((wrap) => {
    const row = wrap.querySelector<HTMLElement>('[data-row]');
    if (!row) return;
    const dots = Array.from(wrap.querySelectorAll<HTMLElement>('.stages__dot'));
    const step = () => (row.querySelector<HTMLElement>('.stage')?.offsetWidth ?? 280) + 16;
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    wrap.querySelector('[data-prev]')?.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: smooth }));
    wrap.querySelector('[data-next]')?.addEventListener('click', () => row.scrollBy({ left: step(), behavior: smooth }));
    const mark = () => {
      const i = Math.round(row.scrollLeft / step());
      dots.forEach((d, k) => d.classList.toggle('stages__dot--on', k === i));
    };
    row.addEventListener('scroll', mark, { passive: true });
    mark();
  });
</script>

<style>
  /* ---------- Top: navy fading to white ---------- */
  .top {
    position: relative;
    color: var(--white);
    background: linear-gradient(to bottom, var(--blue-900) 0%, var(--blue-900) 58%, var(--blue) 78%, var(--white) 100%);
    padding-bottom: var(--s-8);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--s-4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--r-pill);
    font-size: var(--t-xs);
    color: var(--white);
    width: fit-content;
  }
  .eyebrow--light {
    color: var(--red-700);
    border-color: var(--red-50);
    background: var(--red-50);
    font-weight: 700;
  }
  .hero {
    display: grid;
    gap: var(--s-10, 40px);
    padding-block: var(--s-12) var(--s-12);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: var(--s-16) var(--s-16);
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .hero__title {
    color: var(--white);
    max-width: 16ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue-900);
    transition: transform var(--dur) var(--ease);
  }
  .round:hover {
    transform: scale(1.05);
    color: var(--blue-900);
  }
  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-top: var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    width: 100%;
  }
  .proof {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .proof__big {
    font-size: var(--t-2xl);
    font-weight: 700;
    color: var(--white);
    line-height: 1;
  }
  .proof__text {
    display: grid;
    gap: 2px;
  }
  .proof__title {
    font-weight: 700;
    color: var(--white);
    font-size: var(--t-sm);
  }
  .proof__line {
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.72);
  }
  .proof__link {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .proof__logos {
    display: flex;
  }
  .proof__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    border: 2px solid var(--blue-900);
    margin-left: -8px;
  }
  .proof__dot:first-child {
    margin-left: 0;
  }

  /* Life-stage journeys: photo cards in a row that snaps as you scroll */
  .stages {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--band) 0;
  }
  .stages__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .stages__title {
    font-size: var(--t-2xl);
    font-weight: 400;
    color: var(--ink);
    max-width: 24ch;
  }
  .stages__title strong {
    font-weight: 700;
    color: var(--blue);
  }
  .stages__arrows {
    display: none;
    gap: var(--s-2);
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .stages__arrows {
      display: flex;
    }
  }
  .stages__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    color: var(--red-700);
    border: 1px solid var(--line);
    transition: background-color var(--dur) var(--ease);
  }
  .stages__arrow:hover {
    background: var(--red-50);
  }
  .stages__arrow :global(.stages__flip) {
    transform: scaleX(-1);
  }
  .stages__row {
    display: flex;
    gap: var(--s-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    padding-bottom: var(--s-2);
  }
  .stages__row::-webkit-scrollbar {
    display: none;
  }
  .stage {
    flex: 0 0 min(72vw, 280px);
    scroll-snap-align: start;
  }
  @media (min-width: 900px) {
    .stage {
      flex-basis: calc((100% - 3 * var(--s-4)) / 4);
    }
  }
  .stage__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    background: var(--blue);
    isolation: isolate;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.6);
  }
  .stage__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform var(--dur-slow) var(--ease);
  }
  .stage__link:hover .stage__img {
    transform: scale(1.05);
  }
  .stage__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 23, 54, 0.95) 0%, rgba(0, 23, 54, 0.55) 40%, rgba(0, 23, 54, 0) 70%);
  }
  .stage__body {
    position: absolute;
    left: var(--s-5, 20px);
    right: var(--s-5, 20px);
    bottom: var(--s-5, 20px);
    display: grid;
    gap: var(--s-1);
    padding-right: 48px;
  }
  .stage__q {
    font-size: var(--t-lg);
    font-weight: 700;
    line-height: 1.2;
    color: var(--white);
  }
  .stage__promise {
    font-size: var(--t-sm);
    color: rgba(255, 255, 255, 0.85);
  }
  .stage__go {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    transition: transform var(--dur) var(--ease);
  }
  .stage__link:hover .stage__go {
    transform: translateX(3px);
  }
  .stages__dots {
    display: flex;
    gap: var(--s-2);
  }
  .stages__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--line);
    transition:
      width var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .stages__dot--on {
    width: 28px;
    background: var(--red);
  }

  /* Help row: photo card + dark cards */
  .help {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 900px) {
    .help {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
  .help__photo {
    position: relative;
    display: block;
    min-height: 240px;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    box-shadow: var(--shadow-float);
  }
  .help__photo {
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-900) 100%);
  }
  .help__photo-mark {
    position: absolute;
    top: var(--s-6);
    left: var(--s-6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }
  .help__photo-body {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6);
    background: linear-gradient(to top, rgba(0, 23, 54, 0.95), rgba(0, 23, 54, 0));
  }
  .help__photo-title {
    font-weight: 700;
    font-size: var(--t-lg);
  }
  .help__photo-line {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--t-sm);
    color: rgba(255, 255, 255, 0.85);
  }
  /* Benefit cards: alternating white and blue, with a shield badge rising above each card */
  .help__cards {
    display: grid;
    gap: var(--gap);
    padding-top: var(--s-10, 40px);
  }
  @media (min-width: 640px) {
    .help__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .help__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .benefit {
    position: relative;
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: center;
    text-align: center;
    height: 100%;
    padding: var(--s-12) var(--s-5, 20px) var(--s-8);
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform var(--dur) var(--ease);
  }
  .benefit:hover {
    transform: translateY(-3px);
    color: var(--ink);
  }
  .benefit--blue {
    background: var(--blue);
    color: var(--white);
  }
  .benefit--blue:hover {
    color: var(--white);
  }
  .benefit__shield {
    position: absolute;
    top: -34px;
    left: 50%;
    transform: translateX(-50%);
    width: 68px;
    height: 76px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 8px;
    color: var(--white);
    background: linear-gradient(to bottom, var(--blue-700), var(--blue));
    clip-path: polygon(0 0, 100% 0, 100% 62%, 50% 100%, 0 62%);
  }
  .benefit--blue .benefit__shield {
    background: linear-gradient(to bottom, var(--red), var(--red-700));
  }
  .benefit__title {
    font-size: var(--t-xl);
    font-weight: 400;
    color: var(--blue);
    margin-top: var(--s-2);
  }
  .benefit--blue .benefit__title {
    color: var(--white);
  }
  .benefit__line {
    font-size: var(--t-sm);
    color: var(--grey);
    max-width: 24ch;
  }
  .benefit--blue .benefit__line {
    color: rgba(255, 255, 255, 0.85);
  }

  /* About split */
  .about {
    display: grid;
    gap: var(--s-8);
    padding-top: var(--s-8);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-12);
      align-items: start;
    }
  }
  .about__media {
    display: grid;
    gap: var(--s-6);
  }
  .about__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .about__copy {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .about__title {
    font-size: var(--t-2xl);
    max-width: 18ch;
  }
  .about__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: start;
  }
  .about__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--red-50);
    color: var(--red);
  }
  .about__h3 {
    font-size: var(--t-md);
    margin-bottom: var(--s-1);
  }
  .about__banner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5, 20px);
    border-radius: var(--r-pill);
    background: var(--blue-900);
    color: var(--white);
    text-decoration: none;
  }
  .about__banner:hover {
    color: var(--white);
  }
  .about__banner-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--red);
  }
  .about__banner-text {
    font-size: var(--t-sm);
  }
  @media (max-width: 639px) {
    .about__banner {
      grid-template-columns: auto 1fr;
      border-radius: var(--r-lg);
    }
    .about__banner .btn {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* Number strip */
  .stats {
    margin: var(--s-12) 0;
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: grid;
    gap: var(--s-2);
    position: relative;
    padding-top: var(--s-4);
  }
  .stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 3px;
    background: var(--red);
  }
  .stat__value {
    margin: 0;
    font-size: var(--t-3xl);
    font-weight: 700;
    color: var(--blue);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    font-size: var(--t-sm);
    color: var(--grey);
    max-width: 24ch;
  }

  /* Business cards */
  .biz-head {
    display: grid;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  @media (min-width: 900px) {
    .biz-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }
  .biz-head .eyebrow--light {
    margin-bottom: var(--s-4);
  }
  .biz-title {
    font-size: var(--t-2xl);
    max-width: 22ch;
  }
  .biz-head__aside {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .biz {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .biz {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .biz {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .biz-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--white);
    background: var(--blue-900);
  }
  .biz-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .biz-card:hover .biz-card__img {
    transform: scale(1.04);
  }
  .biz-card__panel {
    position: absolute;
    left: var(--s-4);
    right: var(--s-4);
    bottom: var(--s-4);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: rgba(0, 23, 54, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .biz-card__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }
  .biz-card__text {
    display: grid;
