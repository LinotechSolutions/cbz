---
/**
 * A leadership hierarchy. The lead (the chairperson for a board, the chief
 * executive for management) sits on a wide card at the top; connector
 * lines run to a row of compact cards; anyone beyond `rowMax` goes in a
 * band of small cards. Every portrait is a circle inside a red and navy
 * ring, showing initials until a photograph arrives. The executive variant
 * sits in a tinted panel under a navy strip so board and management read
 * as distinct sections.
 */
import Icon from './Icon.astro';

export interface Person {
  name: string;
  role: string;
  image: { src: string; alt: string } | null;
  since?: string;
  line?: string;
}

interface Props {
  id: string;
  people: Person[];
  /** Board: red tag, chair on top. Executive: navy tag, tinted panel. */
  variant?: 'board' | 'executive';
  /** Who leads: the person whose role says chair (none if nobody does), or the first person. */
  lead?: 'chair' | 'first';
  /** The tag on the lead card; derived from the role when absent. */
  leadTag?: string;
  /** A small title above the chart, e.g. "Board leadership". */
  title?: string;
  /** How many sit in the connected row; the rest go to the band. */
  rowMax?: number;
  bandTitle?: string;
  bandLine?: string;
  bandLink?: { label: string; href: string };
}
const {
  id,
  people,
  variant = 'board',
  lead = 'chair',
  leadTag,
  title,
  rowMax = 5,
  bandTitle = 'Our leadership',
  bandLine,
  bandLink,
} = Astro.props;

const chairIndex = people.findIndex((p) => /chair/i.test(p.role));
const topIndex = lead === 'first' ? (people.length > 0 ? 0 : -1) : chairIndex;
const top = topIndex >= 0 ? people[topIndex] : null;
const rest = people.filter((_, i) => i !== topIndex);
const row = rest.slice(0, rowMax);
const band = rest.slice(rowMax);
const tag =
  leadTag ??
  (top && /chair/i.test(top.role)
    ? /acting/i.test(top.role)
      ? 'Acting Chairperson'
      : 'Chairperson'
    : top
      ? top.role.split(/,| and /)[0]
      : '');
/* The role under the lead's name, without repeating the tag */
const leadRole = top ? (top.role.toLowerCase().startsWith(tag.toLowerCase()) ? top.role.slice(tag.length).replace(/^[,\s]*(and\s+)?/, '') : top.role) : '';

const initials = (name: string) =>
  name
    .replace(/^(Dr|Prof\.?|Mr|Mrs|Ms)\s+/i, '')
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<div class:list={['org', `org--${variant}`, top && row.length > 0 && 'org--led']} style={`--n:${row.length}`} data-org={id}>
  {
    title && (
      <h3 class="org__title">
        <span class="org__title-dot" aria-hidden="true" />
        {title}
      </h3>
    )
  }

  {
    top && (
      <div class="org__top">
        <article class="org__lead card-base">
          <span class="org__corner" aria-hidden="true" />
          <span class="org__avatar org__avatar--lead" aria-hidden="true">
            {top.image ? <img src={top.image.src} alt="" width={320} height={320} loading="lazy" decoding="async" /> : <span class="org__initials">{initials(top.name)}</span>}
          </span>
          <div class="org__lead-text">
            <span class="org__tag">{tag}</span>
            <span class="org__name org__name--lead">{top.name}</span>
            {leadRole && <span class="org__role org__role--lead">{leadRole}</span>}
            {top.since && <span class="org__since">Appointed {top.since}</span>}
            {top.line && <span class="org__line org__line--lead">{top.line}</span>}
          </div>
        </article>
      </div>
    )
  }

  {
    row.length > 0 && (
      <ul role="list" class="org__row">
        {row.map((p) => (
          <li class="org__node">
            <article class="org__card card-base">
              <span class="org__corner" aria-hidden="true" />
              <span class="org__avatar" aria-hidden="true">
                {p.image ? <img src={p.image.src} alt="" width={200} height={200} loading="lazy" decoding="async" /> : <span class="org__initials">{initials(p.name)}</span>}
              </span>
              <span class="org__name">{p.name}</span>
              <span class="org__role">{p.role}</span>
              {p.since && <span class="org__since">Appointed {p.since}</span>}
              {p.line && <span class="org__line">{p.line}</span>}
              <span class="org__rule" aria-hidden="true" />
            </article>
          </li>
        ))}
      </ul>
    )
  }

  {
    band.length > 0 && (
      <div class="org__band">
        <div class="org__band-copy">
          <h4 class="org__band-title">{bandTitle}</h4>
          {bandLine && <p class="org__band-line">{bandLine}</p>}
          {bandLink && (
            <a href={bandLink.href} class="go">
              {bandLink.label} <Icon name="arrowRight" size={16} />
            </a>
          )}
        </div>
        <ul role="list" class="org__band-list">
          {band.map((p) => (
            <li class="org__mini card-base">
              <span class="org__avatar org__avatar--mini" aria-hidden="true">
                {p.image ? <img src={p.image.src} alt="" width={120} height={120} loading="lazy" decoding="async" /> : <span class="org__initials">{initials(p.name)}</span>}
              </span>
              <span class="org__mini-text">
                <span class="org__name">{p.name}</span>
                <span class="org__role">{p.role}</span>
                {p.since && <span class="org__since">Appointed {p.since}</span>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .org {
    --org-accent: var(--red);
    --org-line: var(--blue-100);
    display: grid;
    gap: var(--s-5, 20px);
  }
  /* Executive management: a tinted panel under a navy strip */
  .org--executive {
    --org-accent: var(--blue);
    padding: var(--s-5, 20px);
    border-radius: var(--r-lg);
    background: var(--blue-50);
    border-top: 4px solid var(--blue);
  }
  .org--executive .org__band {
    background: var(--white);
    border: 1px solid var(--line);
  }
  .org__title {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .org__title-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--org-accent);
  }

  /* Portrait: a circle inside a ring that is red for three quarters and
     navy for the last quarter; initials until a photograph arrives. */
  .org__avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 84px;
    aspect-ratio: 1;
    padding: 4px;
    border-radius: 50%;
    background: conic-gradient(from 200deg, var(--red) 0 270deg, var(--blue) 270deg 360deg);
    flex-shrink: 0;
  }
  .org__avatar img,
  .org__initials {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 3px solid var(--white);
    object-fit: cover;
    object-position: top;
  }
  .org__initials {
    display: inline-grid;
    place-items: center;
    background: var(--blue-50);
    color: var(--blue);
    font-weight: 700;
    font-size: var(--t-md);
    letter-spacing: 0.02em;
  }
  .org__avatar--lead {
    width: 128px;
    padding: 5px;
  }
  .org__avatar--lead .org__initials {
    font-size: var(--t-xl);
  }
  .org__avatar--mini {
    width: 56px;
    padding: 3px;
  }
  .org__avatar--mini .org__initials {
    font-size: var(--t-xs);
    border-width: 2px;
  }

  /* A small red and navy curve in the card's top-left corner */
  .org__corner {
    position: absolute;
    top: -40px;
    left: -40px;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 6px 6px 0 0 var(--blue);
    pointer-events: none;
  }

  .org__name {
    display: block;
    font-weight: 700;
    color: var(--blue);
    font-size: var(--t-sm);
    line-height: 1.2;
  }
  .org__role {
    display: block;
    font-size: var(--t-xs);
    color: var(--grey);
    line-height: 1.3;
  }
  .org__since {
    display: block;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--red-700);
  }
  .org__line {
    display: block;
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .org__rule {
    display: block;
    width: 32px;
    height: 3px;
    border-radius: 2px;
    background: var(--org-accent);
    margin-top: var(--s-2);
  }
  .org__tag {
    display: inline-block;
    justify-self: start;
    padding: 3px var(--s-3);
    border-radius: var(--r-pill);
    background: var(--org-accent);
    color: var(--white);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  /* Top: the lead, a wide card with the portrait beside the text */
  .org__top {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .org__lead {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-5, 20px);
    align-items: center;
    width: min(100%, 640px);
    padding: var(--s-5, 20px) var(--s-6);
    overflow: hidden;
    box-shadow: var(--shadow-float);
  }
  .org__lead-text {
    display: grid;
    gap: var(--s-1);
    align-content: center;
  }
  .org__name--lead {
    font-size: var(--t-xl);
    line-height: 1.1;
  }
  .org__role--lead {
    font-size: var(--t-sm);
    color: var(--ink);
  }
  .org__line--lead {
    font-size: var(--t-sm);
    margin-top: var(--s-1);
  }
  .org__lead-text .org__tag {
    margin-bottom: var(--s-1);
  }
  @media (max-width: 479px) {
    .org__lead {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .org__avatar--lead {
      width: 96px;
    }
  }

  /* Row: compact cards, connected to the lead by a stem, a rail and a stub */
  .org__row {
    position: relative;
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .org__node {
    display: grid;
  }
  .org__card {
    position: relative;
    display: grid;
    gap: 2px;
    align-content: start;
    justify-items: center;
    text-align: center;
    padding: var(--s-5, 20px) var(--s-3) var(--s-4);
    overflow: hidden;
  }
  .org__card .org__avatar {
    margin-bottom: var(--s-2);
  }
  @media (min-width: 900px) {
    .org--led .org__top::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: calc(-1 * var(--s-6));
      height: var(--s-6);
      border-left: 2px solid var(--org-line);
    }
    .org__row {
      grid-template-columns: repeat(var(--n, 5), minmax(0, 220px));
      justify-content: center;
    }
    .org--led .org__row {
      padding-top: var(--s-6);
    }
    .org--led .org__row::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(50% / var(--n, 5));
      width: calc(100% - 100% / var(--n, 5));
      border-top: 2px solid var(--org-line);
    }
    .org--led .org__node {
      position: relative;
    }
    .org--led .org__node::before {
      content: '';
      position: absolute;
      top: calc(-1 * var(--s-6));
      left: 50%;
      height: var(--s-6);
      border-left: 2px solid var(--org-line);
    }
    .org[style*='--n:1'] .org__row::before {
      display: none;
    }
  }

  /* Band: the rest, as small cards beside a short title */
  .org__band {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: var(--blue-50);
  }
  @media (min-width: 900px) {
    .org__band {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: center;
    }
  }
  .org__band-copy {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding-left: var(--s-4);
    border-left: 3px solid var(--org-accent);
  }
  .org__band-title {
    font-size: var(--t-lg);
    font-weight: 700;
    color: var(--blue);
    line-height: 1.1;
  }
  .org__band-line {
    font-size: var(--t-sm);
    color: var(--grey);
    max-width: 30ch;
  }
  /* Red on the tinted band needs the darker red for contrast */
  .org__band-copy :global(.go) {
    color: var(--red-700);
  }
  .org__band-list {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 640px) {
    .org__band-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .org__mini {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    padding: var(--s-3) var(--s-4);
  }
  .org__mini-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
</style>
