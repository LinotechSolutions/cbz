---
/**
 * A leadership hierarchy. The lead (the chairperson for a board, the chief
 * executive for management) sits on a large card at the top; connector
 * lines run to a row of smaller cards; anyone beyond `rowMax` goes in a
 * band of compact cards. The executive variant sits in a tinted panel with
 * a navy strip so board and management read as distinct sections.
 * Portraits show initials until photographs arrive.
 */
import Icon from './Icon.astro';

export interface Person {
  name: string;
  role: string;
  image: { src: string; alt: string } | null;
  since?: string;
  line?: string;
}

interface Props {
  id: string;
  people: Person[];
  /** Board: red tag, chair on top. Executive: navy tag, tinted panel. */
  variant?: 'board' | 'executive';
  /** Who leads: the person whose role says chair (none if nobody does), or the first person. */
  lead?: 'chair' | 'first';
  /** The tag on the lead card; derived from the role when absent. */
  leadTag?: string;
  /** A small title above the chart, e.g. "Board leadership". */
  title?: string;
  /** How many sit in the connected row; the rest go to the band. */
  rowMax?: number;
  bandTitle?: string;
  bandLine?: string;
  bandLink?: { label: string; href: string };
}
const {
  id,
  people,
  variant = 'board',
  lead = 'chair',
  leadTag,
  title,
  rowMax = 5,
  bandTitle = 'Our leadership',
  bandLine,
  bandLink,
} = Astro.props;

const chairIndex = people.findIndex((p) => /chair/i.test(p.role));
const topIndex = lead === 'first' ? (people.length > 0 ? 0 : -1) : chairIndex;
const top = topIndex >= 0 ? people[topIndex] : null;
const rest = people.filter((_, i) => i !== topIndex);
const row = rest.slice(0, rowMax);
const band = rest.slice(rowMax);
const tag =
  leadTag ??
  (top && /chair/i.test(top.role)
    ? /acting/i.test(top.role)
      ? 'Acting Chairperson'
      : 'Chairperson'
    : top
      ? top.role.split(/,| and /)[0]
      : '');

const initials = (name: string) =>
  name
    .replace(/^(Dr|Prof\.?|Mr|Mrs|Ms)\s+/i, '')
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<div class:list={['org', `org--${variant}`, top && row.length > 0 && 'org--led']} style={`--n:${row.length}`} data-org={id}>
  {
    title && (
      <h3 class="org__title">
        <span class="org__title-dot" aria-hidden="true" />
        {title}
      </h3>
    )
  }

  {
    top && (
      <div class="org__top">
        <article class="org__lead card-base">
          <span class="org__photo org__photo--lead" aria-hidden="true">
            <span class="org__swoosh org__swoosh--navy" />
            <span class="org__swoosh org__swoosh--red" />
            {top.image ? <img src={top.image.src} alt="" width={600} height={600} loading="lazy" decoding="async" /> : <span class="org__initials org__initials--lead">{initials(top.name)}</span>}
          </span>
          <div class="org__lead-text">
            <span class="org__tag">{tag}</span>
            <span class="org__name org__name--lead">{top.name}</span>
            <span class="org__role org__role--lead">{top.role}</span>
            {top.since && <span class="org__since">Appointed {top.since}</span>}
            {top.line && <span class="org__line org__line--lead">{top.line}</span>}
            <span class="org__rule" aria-hidden="true" />
          </div>
        </article>
      </div>
    )
  }

  {
    row.length > 0 && (
      <ul role="list" class="org__row">
        {row.map((p) => (
          <li class="org__node">
            <article class="org__card card-base">
              <span class="org__photo" aria-hidden="true">
                <span class="org__swoosh org__swoosh--navy" />
                <span class="org__swoosh org__swoosh--red" />
                {p.image ? <img src={p.image.src} alt="" width={480} height={360} loading="lazy" decoding="async" /> : <span class="org__initials">{initials(p.name)}</span>}
              </span>
              <span class="org__name">{p.name}</span>
              <span class="org__role">{p.role}</span>
              {p.since && <span class="org__since">Appointed {p.since}</span>}
              {p.line && <span class="org__line">{p.line}</span>}
              <span class="org__rule" aria-hidden="true" />
            </article>
          </li>
        ))}
      </ul>
    )
  }

  {
    band.length > 0 && (
      <div class="org__band">
        <div class="org__band-copy">
          <h4 class="org__band-title">{bandTitle}</h4>
          {bandLine && <p class="org__band-line">{bandLine}</p>}
          {bandLink && (
            <a href={bandLink.href} class="go">
              {bandLink.label} <Icon name="arrowRight" size={16} />
            </a>
          )}
        </div>
        <ul role="list" class="org__band-list">
          {band.map((p) => (
            <li class="org__mini card-base">
              <span class="org__photo org__photo--mini" aria-hidden="true">
                <span class="org__swoosh org__swoosh--navy" />
                <span class="org__swoosh org__swoosh--red" />
                {p.image ? <img src={p.image.src} alt="" width={240} height={240} loading="lazy" decoding="async" /> : <span class="org__initials org__initials--mini">{initials(p.name)}</span>}
              </span>
              <span class="org__mini-text">
                <span class="org__name">{p.name}</span>
                <span class="org__role">{p.role}</span>
                {p.since && <span class="org__since">Appointed {p.since}</span>}
                <span class="org__rule" aria-hidden="true" />
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .org {
    --org-accent: var(--red);
    --org-line: var(--blue-100);
    display: grid;
    gap: var(--s-6);
  }
  /* Executive management: a tinted panel under a navy strip */
  .org--executive {
    --org-accent: var(--blue);
    padding: var(--s-6);
    border-radius: var(--r-lg);
    background: var(--blue-50);
    border-top: 4px solid var(--blue);
  }
  .org--executive .org__band {
    background: var(--white);
    border: 1px solid var(--line);
  }
  .org__title {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .org__title-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--org-accent);
  }

  /* Portrait: a pale panel with navy and red curves rising from the
     bottom-left, the photograph or initials on top. */
  .org__photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    max-height: 150px;
    overflow: hidden;
    border-radius: var(--r-md);
    background: linear-gradient(160deg, var(--blue-50), var(--white) 70%);
  }
  .org--executive .org__photo {
    background: linear-gradient(160deg, var(--blue-100), var(--white) 70%);
  }
  .org__photo img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .org__swoosh {
    position: absolute;
    border-radius: 50%;
    width: 150px;
    height: 150px;
  }
  .org__swoosh--navy {
    left: -56px;
    bottom: -94px;
    background: var(--blue);
  }
  .org__swoosh--red {
    left: -50px;
    bottom: -100px;
    background: var(--red);
  }
  .org__initials {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 56px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue);
    font-weight: 700;
    font-size: var(--t-sm);
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-card);
  }

  .org__name {
    display: block;
    font-weight: 700;
    color: var(--blue);
    font-size: var(--t-sm);
    line-height: 1.2;
  }
  .org__role {
    display: block;
    font-size: var(--t-xs);
    color: var(--grey);
    line-height: 1.3;
  }
  .org__since {
    display: block;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--red-700);
  }
  .org__line {
    display: block;
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .org__rule {
    display: block;
    width: 36px;
    height: 3px;
    border-radius: 2px;
    background: var(--org-accent);
    margin-top: var(--s-2);
  }
  .org__tag {
    display: inline-block;
    justify-self: start;
    padding: 3px var(--s-3);
    border-radius: var(--r-pill);
    background: var(--org-accent);
    color: var(--white);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  /* Top: the lead, on a large card with the portrait beside the text */
  .org__top {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .org__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, 720px);
    overflow: hidden;
    box-shadow: var(--shadow-float);
  }
  @media (min-width: 640px) {
    .org__lead {
      grid-template-columns: 260px minmax(0, 1fr);
    }
  }
  .org__photo--lead {
    aspect-ratio: 16 / 9;
    max-height: 200px;
    border-radius: 0;
  }
  @media (min-width: 640px) {
    .org__photo--lead {
      aspect-ratio: auto;
      max-height: none;
      height: 100%;
      min-height: 240px;
    }
  }
  .org__photo--lead .org__swoosh {
    width: 220px;
    height: 220px;
  }
  .org__photo--lead .org__swoosh--navy {
    left: -80px;
    bottom: -136px;
  }
  .org__photo--lead .org__swoosh--red {
    left: -72px;
    bottom: -146px;
  }
  .org__initials--lead {
    width: 96px;
    font-size: var(--t-xl);
  }
  .org__lead-text {
    display: grid;
    gap: var(--s-1);
    align-content: center;
    padding: var(--s-6) var(--s-6) var(--s-6);
  }
  .org__name--lead {
    font-size: var(--t-2xl);
    line-height: 1.1;
  }
  .org__role--lead {
    font-size: var(--t-md);
    color: var(--ink);
  }
  .org__line--lead {
    font-size: var(--t-sm);
  }
  .org__lead-text .org__tag {
    margin-bottom: var(--s-2);
  }
  .org__lead-text .org__rule {
    width: 56px;
  }

  /* Row: connected to the lead by a stem, a rail and a stub per card */
  .org__row {
    position: relative;
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .org__node {
    display: grid;
  }
  .org__card {
    display: grid;
    gap: 2px;
    align-content: start;
    justify-items: center;
    text-align: center;
    padding: var(--s-3) var(--s-3) var(--s-4);
  }
  .org__card .org__photo {
    width: 100%;
    margin-bottom: var(--s-2);
  }
  @media (min-width: 900px) {
    .org--led .org__top::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: calc(-1 * var(--s-6));
      height: var(--s-6);
      border-left: 2px solid var(--org-line);
    }
    .org__row {
      grid-template-columns: repeat(var(--n, 5), minmax(0, 260px));
      justify-content: center;
    }
    .org--led .org__row {
      padding-top: var(--s-6);
    }
    .org--led .org__row::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(50% / var(--n, 5));
      width: calc(100% - 100% / var(--n, 5));
      border-top: 2px solid var(--org-line);
    }
    .org--led .org__node {
      position: relative;
    }
    .org--led .org__node::before {
      content: '';
      position: absolute;
      top: calc(-1 * var(--s-6));
      left: 50%;
      height: var(--s-6);
      border-left: 2px solid var(--org-line);
    }
    .org[style*='--n:1'] .org__row::before {
      display: none;
    }
  }

  /* Band: the rest, as compact cards beside a short title */
  .org__band {
    display: grid;
    gap: var(--s-5, 20px);
    padding: var(--s-5, 20px);
    border-radius: var(--r-lg);
    background: var(--blue-50);
  }
  @media (min-width: 900px) {
    .org__band {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: center;
    }
  }
  .org__band-copy {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding-left: var(--s-4);
    border-left: 3px solid var(--org-accent);
  }
  .org__band-title {
    font-size: var(--t-lg);
    font-weight: 700;
    color: var(--blue);
    line-height: 1.1;
  }
  .org__band-line {
    font-size: var(--t-sm);
    color: var(--grey);
    max-width: 30ch;
  }
  /* Red on the tinted band needs the darker red for contrast */
  .org__band-copy :global(.go) {
    color: var(--red-700);
  }
  .org__band-list {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 640px) {
    .org__band-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .org__mini {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: var(--s-3);
    align-items: center;
    overflow: hidden;
  }
  .org__photo--mini {
    aspect-ratio: auto;
    width: 88px;
    height: 100%;
    min-height: 88px;
    max-height: none;
    border-radius: 0;
  }
  .org__photo--mini .org__swoosh {
    width: 80px;
    height: 80px;
  }
  .org__photo--mini .org__swoosh--navy {
    left: -30px;
    bottom: -52px;
  }
  .org__photo--mini .org__swoosh--red {
    left: -26px;
    bottom: -56px;
  }
  .org__initials--mini {
    width: 40px;
    font-size: var(--t-xs);
  }
  .org__mini-text {
    display: grid;
    gap: 2px;
    padding: var(--s-3) var(--s-3) var(--s-3) 0;
  }
</style>
