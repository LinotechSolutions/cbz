---
/**
 * A navigation tile: one radius, one border, a whisper of shadow on hover.
 * The whole tile is the link. `size="lead"` makes a tile the largest.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { isExternal } from '../data/links';

interface Props {
  title: string;
  line?: string;
  href: string;
  icon?: IconName;
  size?: 'default' | 'lead' | 'small';
  track?: string;
  trackProps?: Record<string, string | number | boolean>;
  class?: string;
}
const { title, line, href, icon, size = 'default', track, trackProps, class: className = '' } = Astro.props;
const external = isExternal(href);
---

<a
  href={href}
  class:list={['tile', 'card-base', `tile--${size}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-track={track}
  data-track-props={trackProps ? JSON.stringify(trackProps) : undefined}
>
  <slot name="media" />
  <span class="tile__body">
    {
      icon && (
        <span class="tile__icon">
          <Icon name={icon} size={size === 'lead' ? 34 : 26} />
        </span>
      )
    }
    <span class="tile__title">
      {title}
      {external && <span class="sr-only">(opens in a new tab)</span>}
    </span>
    {line && <span class="tile__line">{line}</span>}
    <slot />
  </span>
  <span class="go tile__go">
    {external ? 'Visit' : 'Explore'} <Icon name={external ? 'external' : 'arrowRight'} size={16} />
  </span>
</a>

<style>
  /* Red outline icon, navy title, grey line, red Explore at the foot */
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5, 20px);
    min-height: 120px;
    color: var(--ink);
    text-decoration: none;
  }
  .tile:hover {
    color: var(--ink);
  }
  .tile--lead {
    min-height: 180px;
    padding: var(--s-6);
  }
  .tile--small {
    min-height: 112px;
    padding: var(--s-5, 20px) var(--s-6);
  }
  .tile__body {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    flex: 1;
  }
  .tile__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--red-50);
    color: var(--red);
    margin-bottom: var(--s-1);
  }
  .tile--lead .tile__icon {
    width: 64px;
    height: 64px;
  }
  .tile__title {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
    line-height: 1.25;
  }
  .tile--lead .tile__title {
    font-size: var(--t-xl);
  }
  .tile__line {
    color: var(--grey);
    font-size: var(--t-sm);
    max-width: 40ch;
  }
  .tile__go {
    margin-top: auto;
  }
</style>
