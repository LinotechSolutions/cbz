---
/**
 * Home, in the site map's order: Hero, What can we help you with?, Nine
 * businesses, Latest from CBZ, Branches & ATMs. The digital channels sit as
 * one compact row under the task card.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TaskCard from '../components/TaskCard.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import StoreBadges from '../components/StoreBadges.astro';
import BranchFinder from '../components/BranchFinder.astro';
import Icon from '../components/Icon.astro';
import { OpenAccountMenu } from '../islands/OpenAccountMenu';
import { OPEN_ACCOUNT_ITEMS } from '../data/nav';
import { LINKS } from '../data/links';
import { GROUP } from '../data/facts';
import { CLUSTERS } from '../data/group';
import { formatDate } from '../lib/format';
import type { IconName } from '../components/icons';
import type { DarkSafeLogoKey } from '../data/logos';

const clusterIcon: Record<string, IconName> = { banking: 'bank', investments: 'chart', insurance: 'shield', 'agro-business': 'leaf' };
const tasks = CLUSTERS.filter((c) => c.isOperating).map((c) => ({
  label: c.taskLabel,
  line: c.line,
  href: c.route,
  icon: clusterIcon[c.id],
}));

const units = (await getCollection('units', (u) => u.data.cluster !== 'philanthropy'))
  .map((u) => u.data)
  .sort((a, b) => a.order - b.order);

const latest = (await getCollection('notices'))
  .filter((n) => n.data.category !== 'security')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
---

<BaseLayout
  title={GROUP.name}
  description="CBZ Holdings: banking, insurance, investments and agribusiness in one place. Open an account, apply for a loan, get a quote or start investing."
  preloadImage="/images/cbz-payments.webp"
>
  <Hero
    variant="home"
    eyebrow="CBZ Holdings"
    title="Bank, insure, invest and grow, in one place"
    lede="Nine businesses, one group. Open an account, get a quote or start investing today."
    image={{ src: '/images/cbz-payments.webp', alt: 'A shop owner taking a card payment from a customer at the counter' }}
    secondary={{ label: 'Talk to us', href: '/contact' }}
  >
    <OpenAccountMenu client:idle items={OPEN_ACCOUNT_ITEMS} slot="primary" />
  </Hero>

  <TaskCard heading="What can we help you with?" items={tasks} />

  <div class="container digital-row">
    <ul role="list" class="digital" id="digital-channels" aria-label="Bank from your phone">
      <li class="digital__item">
        <Logo brand="ziki-cash" on="light" height={28} decorative />
        <a href={LINKS.zikiCash.site ?? '/contact'} class="digital__link">
          ZikiCash {LINKS.zikiCash.site ? '' : '(ask us)'} <Icon name="chevronRight" size={16} />
        </a>
      </li>
      <li class="digital__item">
        <Logo brand="cbz-touch" on="light" height={28} decorative />
        <StoreBadges app="cbz-touch" appStore={LINKS.touch.appStore} playStore={LINKS.touch.playStore} />
      </li>
      <li class="digital__item">
        <a href="/login" class="digital__link">Internet banking log in <Icon name="chevronRight" size={16} /></a>
      </li>
      <li class="digital__item">
        <Logo brand="ziki-mall" on="light" height={24} decorative />
        <a href={LINKS.zikiMall} class="digital__link" target="_blank" rel="noopener noreferrer">
          Ziki Mall <Icon name="external" size={14} class="ext" /><span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>
    </ul>
  </div>

  <Section id="businesses" tone="tint" heading="Nine businesses" lede="One group behind every stage of life and business.">
    <ul role="list" class="units">
      {
        units.map((u) => (
          <li>
            <a href={`/${u.slug}`} class="unit">
              <Logo brand={u.logo as DarkSafeLogoKey} on="light" height={32} decorative />
              <span class="unit__name">{u.name}</span>
              <span class="unit__line">{u.hero.lede}</span>
              <span class="unit__more">
                Visit {u.shortName} <Icon name="chevronRight" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    latest.length > 0 && (
      <Section id="latest" heading="Latest from CBZ" lede="Shareholder circulars, customer notices and announcements.">
        <ul role="list" class="latest rule-list">
          {latest.map((n) => (
            <li>
              <a href={`/notices/${n.id}`} class="latest__item">
                <time datetime={n.data.date} class="small muted">
                  {formatDate(n.data.date)}
                </time>
                <span class="latest__title">{n.data.title}</span>
                <span class="latest__summary small muted">{n.data.summary}</span>
                <Icon name="chevronRight" size={18} class="latest__chev" />
              </a>
            </li>
          ))}
        </ul>
        <p class="latest__all">
          <a href="/notices">All notices</a>
        </p>
      </Section>
    )
  }

  <Section id="branches" tone="tint" heading="Branches and ATMs" lede="Search the map, or open it in your own maps app for directions.">
    <BranchFinder id="home-branches" />
  </Section>

  <Section id="trust" tone="dark" compact>
    <dl class="trust">
      <div>
        <dd class="trust__v">{GROUP.founded}</dd>
        <dt>Founded</dt>
      </div>
      <div>
        <dd class="trust__v">{GROUP.listing}</dd>
        <dt>{GROUP.listingLine}</dt>
      </div>
      <div>
        <dd class="trust__v">{GROUP.companies}</dd>
        <dt>In {GROUP.clusters.toLowerCase()}</dt>
      </div>
    </dl>
  </Section>
</BaseLayout>

<style>
  .digital-row {
    padding-block: var(--s-6) var(--s-8);
  }
  .digital {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 640px) {
    .digital {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .digital {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .digital__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    min-height: 64px;
  }
  .digital__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-weight: 700;
    text-decoration: none;
    min-height: var(--tap);
  }
  .digital__link:hover {
    text-decoration: underline;
  }
  .units {
    display: grid;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .units {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .units {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .unit {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--dur) var(--ease);
  }
  .unit:hover {
    border-color: var(--blue-700);
    color: var(--ink);
  }
  .unit__name {
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--blue);
  }
  .unit__line {
    font-size: var(--t-sm);
    color: var(--grey);
  }
  .unit__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-weight: 700;
    color: var(--blue-700);
    margin-top: auto;
  }
  .latest {
    max-width: 800px;
  }
  .latest__item {
    position: relative;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-10, 40px) var(--s-4) 0;
    text-decoration: none;
    color: var(--ink);
  }
  .latest__item:hover .latest__title {
    color: var(--blue-700);
  }
  .latest__title {
    font-weight: 700;
    color: var(--blue);
  }
  .latest__summary {
    max-width: var(--measure);
  }
  .latest__chev {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--blue-700);
  }
  .latest__all {
    margin-top: var(--s-6);
    font-weight: 700;
  }
  .trust {
    margin: 0;
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 640px) {
    .trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .trust div {
    display: grid;
    gap: var(--s-1);
  }
  .trust__v {
    margin: 0;
    font-size: var(--t-xl);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
  }
  .trust dt {
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.72);
  }
</style>
