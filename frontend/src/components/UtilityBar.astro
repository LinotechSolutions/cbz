---
/**
 * The thin bar above the header. Only Find a branch lives here: phone,
 * WhatsApp and email are one tap away in the Chat with us launcher.
 */
import Icon from './Icon.astro';
---

<div class="util on-dark">
  <div class="container util__inner">
    <a href="/contact#branches" class="util__item">
      <Icon name="pin" size={16} />
      <span class="util__text">Find a branch</span>
    </a>
  </div>
</div>

<style>
  .util {
    background: var(--blue-900);
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--t-xs);
    height: var(--utility-h);
  }
  .util__inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
  }
  .util__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .util__item:hover {
    color: var(--white);
  }
</style>
