---
/**
 * A page band. Every band is white; a hairline and space separate one from
 * the next, and the heading carries a short red rule. `tone` is kept for
 * callers but no longer changes the background.
 */
interface Props {
  id?: string;
  tone?: 'white' | 'tint' | 'surface' | 'dark';
  heading?: string;
  lede?: string;
  /** Visually hide the heading but keep it for assistive tech. */
  hideHeading?: boolean;
  width?: 'default' | 'narrow';
  class?: string;
  /** Tighter vertical padding for secondary bands. */
  compact?: boolean;
  /** Centre the heading and lede, for marketing bands. */
  align?: 'left' | 'center';
}

const {
  id,
  tone = 'white',
  heading,
  lede,
  hideHeading = false,
  width = 'default',
  class: className = '',
  compact = false,
  align = 'left',
} = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
---

<section
  id={id}
  class:list={['band', `band--${tone}`, compact && 'band--compact', className]}
  aria-labelledby={heading ? headingId : undefined}
>
  <div class:list={['container', width === 'narrow' && 'container--narrow']}>
    {
      heading && (
        <header class:list={['head', align === 'center' && 'head--center', hideHeading && 'sr-only']}>
          <h2 id={headingId} class="h-rule">{heading}</h2>
          {lede && <p class="lede">{lede}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .band--compact {
    padding-block: var(--s-12);
  }
  .container--narrow {
    max-width: 800px;
  }
  .head {
    margin-bottom: var(--s-8);
    display: grid;
    gap: var(--s-3);
  }
  .head h2 {
    font-size: var(--t-2xl);
    color: var(--blue);
  }
  .head--center {
    justify-items: center;
    text-align: center;
  }
  .head--center .h-rule::before {
    left: 50%;
    transform: translateX(-50%);
  }
  .head--center .lede {
    max-width: 48ch;
  }
</style>
