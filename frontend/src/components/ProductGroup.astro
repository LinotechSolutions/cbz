---
/**
 * Products as cards: filter tabs with a blue underline, then a card per
 * product with its photograph (or the unit's icon), a centred name and
 * summary, the pricing line as a check, up to four facts and two buttons. "Tell me more" opens a panel with pill tabs: What you
 * get, Who it's for, What it costs, How to get it. Without JavaScript every
 * card shows and every panel is open.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { visible } from '../lib/visible';

export interface ProductRow {
  productId: string;
  category: string;
  name: string;
  summary: string;
  benefits: string[];
  eligibility: string[] | null;
  audience: string | null;
  pricing: string | null;
  details?: { tenor: string | null; interestRate: string | null; adminFee: string | null; limit: string | null };
  apply: { label: string; href: string };
  /** When set, these replace `apply` on the card: first primary, the rest secondary. */
  actions?: { label: string; href: string }[] | null;
  /** A photograph for the top of the card; cards without one show `icon`. */
  image?: { src: string; alt: string } | null;
}

interface Props {
  unitSlug: string;
  categories: readonly { id: string; label: string }[];
  products: ProductRow[];
  primaryCta: { label: string; href: string };
  note?: string | null;
  idPrefix?: string;
  hideCta?: boolean;
  /** Shown on cards that have no photograph. */
  icon?: IconName;
}
const { unitSlug, categories, products, note, idPrefix = unitSlug, icon = 'wallet' } = Astro.props;

const cats = categories.filter((c) => products.some((p) => p.category === c.id));
const showFilters = cats.length > 1;

const factLabels: Record<string, string> = {
  interestRate: 'Interest',
  tenor: 'Term',
  adminFee: 'Admin fee',
  limit: 'Maximum',
};
function factsFor(p: ProductRow) {
  const facts: { value: string; label: string }[] = [];
  for (const [k, label] of Object.entries(factLabels)) {
    const v = p.details?.[k as keyof NonNullable<ProductRow['details']>];
    // Only short values read as big figures; longer ones stay in What it costs.
    if (visible(v) && v!.length <= 16) facts.push({ value: v!, label });
  }
  return facts.slice(0, 4);
}
/** Long lists open on the first category so the page stays short; "All" is a tap away. */
const startFilter = products.length > 6 && cats.length > 1 ? cats[0].id : 'all';
const costLine = (p: ProductRow) =>
  visible(p.pricing) ? p.pricing! : 'Pricing is confirmed on application. Ask us for current terms before you rely on anything here.';
---

<div class="pc" data-product-cards data-unit={unitSlug} data-start={startFilter}>
  {
    showFilters && (
      <div class="pc__filters" role="tablist" aria-label="Filter products">
        <button type="button" role="tab" class="pc__filter" aria-selected={startFilter === 'all' ? 'true' : 'false'} data-filter="all">
          All
        </button>
        {cats.map((c) => (
          <button type="button" role="tab" class="pc__filter" aria-selected={startFilter === c.id ? 'true' : 'false'} data-filter={c.id} id={`panel-${idPrefix}-${c.id}`}>
            {c.label}
          </button>
        ))}
      </div>
    )
  }

  <ul role="list" class="pc__grid">
    {
      products.map((p) => {
        const facts = factsFor(p);
        const did = `detail-${idPrefix}-${p.productId}`;
        const actions = p.actions && p.actions.length > 0 ? p.actions : [p.apply];
        return (
          <li class="pcard" id={`product-${unitSlug}-${p.productId}`} data-category={p.category}>
            {p.image && visible(p.image.src) ? (
              <img src={p.image.src} alt={p.image.alt} width={600} height={400} loading="lazy" decoding="async" class="pcard__img" />
            ) : (
              <span class="pcard__glyph" aria-hidden="true">
                <Icon name={icon} size={44} />
              </span>
            )}
            <div class="pcard__body">
              <h3 class="pcard__title">{p.name}</h3>
              <p class="pcard__summary">{p.summary}</p>
              {visible(p.pricing) && (
                <p class="pcard__pricing">
                  <Icon name="check" size={16} /> {p.pricing}
                </p>
              )}
              {facts.length > 0 && (
                <dl class="pcard__facts">
                  {facts.map((f) => (
                    <div class="fact">
                      <dd class="fact__value">{f.value}</dd>
                      <dt class="fact__label">{f.label}</dt>
                    </div>
                  ))}
                </dl>
              )}
              <div class="pcard__actions">
                {actions.map((a, ai) => (
                  <Button href={a.href} variant={ai === 0 ? 'primary' : 'secondary'} track="apply_click" trackProps={{ unit: unitSlug, product: p.productId, action: a.label }}>
                    {a.label}
                  </Button>
                ))}
                <button type="button" class="btn btn--secondary pcard__more" aria-haspopup="dialog" aria-controls={did} data-more>
                  Tell me more
                </button>
              </div>
            </div>

            <dialog class="pdetail" id={did} data-detail aria-labelledby={`${did}-title`}>
              <div class="pdetail__head">
                <p class="pdetail__title" id={`${did}-title`}>{p.name}</p>
                <button type="button" class="pdetail__close" data-close aria-label="Close">
                  <Icon name="close" size={20} />
                </button>
              </div>
              <div class="pdetail__tabs" role="tablist" aria-label={`${p.name} details`}>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="true" data-tab="get">What you get</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="who">Who it's for</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="cost">What it costs</button>
                <button type="button" role="tab" class="pdetail__tab" aria-selected="false" data-tab="how">How to get it</button>
              </div>
              <div class="pdetail__panels">
                <section class="pdetail__panel" data-panel="get" role="tabpanel">
                  <h4 class="pdetail__h">What you get</h4>
                  {visible(p.benefits) ? (
                    <ul class="tri">
                      {p.benefits.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="muted">{p.summary}</p>
                  )}
                </section>
                <section class="pdetail__panel" data-panel="who" role="tabpanel">
                  <h4 class="pdetail__h">Who it's for</h4>
                  {visible(p.audience) ? <p>{p.audience}</p> : <p class="muted">Ask us whether this product fits you.</p>}
                </section>
                <section class="pdetail__panel" data-panel="cost" role="tabpanel">
                  <h4 class="pdetail__h">What it costs</h4>
                  <p>{costLine(p)}</p>
                  {facts.length > 0 && (
                    <ul class="tri">
                      {facts.map((f) => (
                        <li>
                          {f.label}: {f.value}
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
                <section class="pdetail__panel" data-panel="how" role="tabpanel">
                  <h4 class="pdetail__h">How to get it</h4>
                  {visible(p.eligibility) && (
                    <>
                      <p class="small muted">You will need</p>
                      <ul class="tri">
                        {p.eligibility!.map((e) => (
                          <li>{e}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  <p class="pdetail__actions">
                    {actions.map((a, ai) => (
                      <Button href={a.href} variant={ai === 0 ? 'primary' : 'secondary'} track="apply_click" trackProps={{ unit: unitSlug, product: p.productId, action: a.label, from: 'detail' }}>
                        {a.label}
                      </Button>
                    ))}
                  </p>
                </section>
                {visible(note) && <p class="pdetail__note small muted">{note}</p>}
              </div>
            </dialog>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-cards]').forEach((root) => {
    root.classList.add('pc--js');

    // Filter tabs
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.pcard'));
    function filter(id: string) {
      filters.forEach((f) => {
        const on = f.dataset.filter === id;
        f.setAttribute('aria-selected', on ? 'true' : 'false');
        f.tabIndex = on ? 0 : -1;
      });
      cards.forEach((c) => {
        c.hidden = id !== 'all' && c.dataset.category !== id;
      });
    }
    if (filters.length) filter(root.dataset.start || 'all');
    filters.forEach((f, i) => {
      f.addEventListener('click', () => filter(f.dataset.filter!));
      f.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight') n = (i + 1) % filters.length;
        if (e.key === 'ArrowLeft') n = (i - 1 + filters.length) % filters.length;
        if (n >= 0) {
          e.preventDefault();
          filters[n].focus();
          filter(filters[n].dataset.filter!);
        }
      });
    });

    // Tell me more opens the details in a modal dialog; Escape, the close
    // button and a click on the backdrop close it, and focus returns to the opener.
    cards.forEach((card) => {
      const more = card.querySelector<HTMLButtonElement>('[data-more]');
      const detail = card.querySelector<HTMLDialogElement>('[data-detail]');
      if (!more || !detail) return;
      more.addEventListener('click', () => {
        detail.showModal();
        detail.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.focus();
      });
      detail.querySelector('[data-close]')?.addEventListener('click', () => detail.close());
      detail.addEventListener('click', (e) => {
        if (e.target === detail) detail.close();
      });
      const tabs = Array.from(detail.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const panels = Array.from(detail.querySelectorAll<HTMLElement>('[data-panel]'));
      function select(id: string, focus = false) {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
        });
      }
      select('get');
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.tab!));
        t.addEventListener('keydown', (e) => {
          let n = -1;
          if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          if (n >= 0) {
            e.preventDefault();
            select(tabs[n].dataset.tab!, true);
          }
        });
      });
    });

    // Deep links: #product-<unit>-<id> opens that card's detail.
    function openHash() {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const card = root.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
      if (!card) return;
      filter('all');
      card.scrollIntoView({ block: 'start' });
      const detail = card.querySelector<HTMLDialogElement>('[data-detail]');
      if (detail && !detail.open) detail.showModal();
    }
    window.addEventListener('hashchange', openHash);
    openHash();
  });
</script>

<style>
  .pc {
    display: grid;
    gap: var(--s-6);
  }
  .pc__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    border-bottom: 1px solid var(--line);
  }
  .pc__filter {
    position: relative;
    min-height: var(--tap);
    padding: 0 var(--s-1);
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--grey);
    letter-spacing: 0.01em;
    transition: color var(--dur) var(--ease);
  }
  .pc__filter:hover,
  .pc__filter[aria-selected='true'] {
    color: var(--blue);
  }
  .pc__filter[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--blue);
  }
  .pc__grid {
    display: grid;
    gap: var(--gap);
  }
  /* Three across on laptops, four on wide screens; two on tablets. */
  @media (min-width: 640px) {
    .pc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .pc__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .pc__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Card: a photograph or icon on top, then centred name, summary, one
     check line, facts and stacked buttons. */
  .pcard {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease);
  }
  .pcard:hover {
    box-shadow: var(--shadow-card);
  }
  .pcard[hidden] {
    display: none;
  }
  .pcard__img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .pcard__glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 112px;
    color: var(--red);
    border-bottom: 1px solid var(--line);
  }
  /* min-width: 0 stops a long button label from widening the body past the card. */
  .pcard__body {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr;
    gap: var(--s-3);
    justify-items: center;
    text-align: center;
    min-width: 0;
    padding: var(--s-6) var(--s-5, 20px);
    overflow-wrap: anywhere;
  }
  .pcard__title {
    font-size: var(--t-lg);
    font-weight: 700;
    color: var(--blue);
    line-height: 1.2;
  }
  .pcard__summary {
    color: var(--grey);
    font-size: var(--t-sm);
    max-width: 34ch;
  }
  .pcard__pricing {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--blue);
  }
  .pcard__pricing :global(svg) {
    color: var(--blue-700);
    flex-shrink: 0;
  }
  .pcard__facts {
    margin: var(--s-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3) var(--s-6);
  }
  .fact {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .fact__value {
    margin: 0;
    font-size: var(--t-lg);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.15;
    overflow-wrap: normal;
    hyphens: none;
  }
  .fact__label {
    font-size: var(--t-xs);
    color: var(--grey);
  }
  .pcard__actions {
    display: grid;
    gap: var(--s-3);
    width: 100%;
    align-self: end;
    margin-top: var(--s-3);
  }
  .pcard__actions :global(.btn) {
    width: 100%;
    min-width: 0;
    height: auto;
    padding: var(--s-3) var(--s-4);
    white-space: normal;
    text-align: center;
    font-size: var(--t-sm);
  }
  .pcard__actions :global(.btn--secondary) {
    border-color: var(--blue);
    color: var(--blue);
  }

  /* Detail popup: a modal dialog with pill tabs over a grey body */
  .pdetail {
    width: min(92vw, 640px);
    max-height: min(85vh, 720px);
    margin: auto;
    padding: var(--s-4);
    border: 0;
    border-radius: var(--r-lg);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-float);
    overflow: auto;
  }
  .pdetail::backdrop {
    background: rgba(0, 23, 54, 0.6);
    backdrop-filter: blur(2px);
  }
  /* Without JavaScript the details simply sit under the card. */
  .pc:not(.pc--js) .pdetail {
    display: block;
    position: static;
    width: auto;
    max-height: none;
    margin: 0;
    box-shadow: none;
    border-top: 1px solid var(--line);
    border-radius: 0;
  }
  .pc:not(.pc--js) .pdetail__close {
    display: none;
  }
  .pdetail__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-2) var(--s-2) var(--s-4);
  }
  .pdetail__title {
    font-size: var(--t-lg);
    font-weight: 700;
    color: var(--blue);
  }
  .pdetail__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    color: var(--blue);
    flex-shrink: 0;
  }
  .pdetail__close:hover {
    background: var(--blue-50);
  }
  .pdetail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .pdetail__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }
  .pc:not(.pc--js) .pdetail__tabs {
    display: none;
  }
  .pdetail__tab {
    min-height: var(--tap);
    padding: 0 var(--s-5, 20px);
    border-radius: var(--r-md) var(--r-md) 0 0;
    background: var(--line);
    color: var(--blue);
    font-weight: 700;
    font-size: var(--t-sm);
    transition: background-color var(--dur) var(--ease);
  }
  .pdetail__tab[aria-selected='true'] {
    background: var(--surface);
  }
  .pdetail__panels {
    background: var(--surface);
    border-radius: 0 var(--r-md) var(--r-md) var(--r-md);
    padding: var(--s-6);
    display: grid;
    gap: var(--s-6);
  }
  .pdetail__panel {
    display: grid;
    gap: var(--s-3);
  }
  .pdetail__panel[hidden] {
    display: none;
  }
  .pdetail__h {
    font-size: var(--t-sm);
    color: var(--grey);
    font-weight: 400;
  }
  .pc--js .pdetail__h {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .tri {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .tri li {
    position: relative;
    padding-left: var(--s-8);
  }
  .tri li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 10px solid var(--red);
  }
  .pdetail__note {
    max-width: var(--measure);
    padding-top: var(--s-2);
    border-top: 1px solid var(--line);
  }
</style>
