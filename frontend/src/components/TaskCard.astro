---
/**
 * The white card that overlaps the bottom edge of a hero. On the home page it
 * asks "What can we help you with?"; on unit pages it is a compact jump list.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Item {
  label: string;
  href: string;
  line?: string;
  icon?: IconName;
}
interface Props {
  heading: string;
  items: Item[];
  kind?: 'tasks' | 'jump';
  hideHeading?: boolean;
}
const { heading, items, kind = 'tasks', hideHeading = false } = Astro.props;
---

<div class="wrap">
  <div class="container">
    <nav class:list={['card', `card--${kind}`]} aria-label={heading}>
      <h2 class:list={['card__heading', hideHeading && 'sr-only']}>{heading}</h2>
      <ul role="list" class="card__list" style={`--n:${items.length}`}>
        {
          items.map((it) => (
            <li>
              <a href={it.href} class="card__item">
                {it.icon && (
                  <span class="card__icon">
                    <Icon name={it.icon} size={kind === 'tasks' ? 24 : 18} />
                  </span>
                )}
                <span class="card__text">
                  <span class="card__label">{it.label}</span>
                  {it.line && <span class="card__line">{it.line}</span>}
                </span>
                <span class="icon-pill card__chev">
                  <Icon name="arrowRight" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<style>
  .wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--overlap, 56px));
  }
  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--s-6);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 900px) {
    .card {
      padding: var(--s-8);
    }
  }
  .card__heading {
    font-size: var(--t-xl);
    margin-bottom: var(--s-6);
  }
  .card--jump .card__heading {
    font-size: var(--t-sm);
    margin-bottom: var(--s-3);
    color: var(--grey);
    font-weight: 400;
  }
  .card__list {
    display: grid;
    gap: var(--s-2);
  }
  .card__item {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: var(--tap);
    padding: var(--s-3);
    border-radius: var(--r-md);
    color: var(--blue);
    text-decoration: none;
    font-weight: 700;
    transition: background-color var(--dur) var(--ease);
  }
  .card__item:hover {
    background: var(--blue-50);
    color: var(--blue);
  }
  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background: var(--blue-50);
    color: var(--blue);
    flex-shrink: 0;
  }
  .card--jump .card__icon {
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
  }
  .card__text {
    display: grid;
    gap: 2px;
    flex: 1;
  }
  .card__label {
    font-size: var(--t-md);
  }
  .card--tasks .card__label {
    font-size: var(--t-lg);
  }
  .card__line {
    font-weight: 400;
    color: var(--grey);
    font-size: var(--t-sm);
    max-width: 40ch;
  }
  @media (min-width: 900px) {
    .card--tasks .card__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--s-4);
    }
    .card--tasks .card__item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
      padding: var(--s-6);
      height: 100%;
      border: 1px solid var(--line);
      transition:
        background-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
    .card--tasks .card__item:hover {
      background: var(--white);
      box-shadow: var(--shadow-card);
    }
    .card--tasks .card__chev {
      margin-top: auto;
    }
    .card--jump .card__list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-4);
    }
    .card--jump .card__item {
      padding: var(--s-2) var(--s-3);
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
    }
    .card--jump .card__chev,
    .card--jump .card__line {
      display: none;
    }
  }
</style>
